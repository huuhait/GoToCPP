// Number literals: gofmt makes prefixes and exponents lowercase and drops
// the leading zeros of an imaginary integer literal. Hex digits stay.
package p

const (
	a = 0xFF
	b = 0xff
	c = 1e5
	d = 1e+5
	e = 0x1p-2
	f = 0x1p+3
	g = 0b101
	h = 0o17
	i = 017
	j = 1_000_000
	k = 0x_FF_ff
	l = 1.5e3
	m = .5e-3
	n = 0.
	o = 1_0.0_1e1_0
	p = 0xaBcDeF
	q = 0
	r = 7
	s = 'x'
	t = "0XFF"
)

const (
	i1  = 0i
	i2  = 0i
	i3  = 123i
	i4  = 1e2i
	i5  = 0x1p3i
	i6  = 0b1i
	i7  = 0o7i
	i8  = 1i
	i9  = 1.5e3i
	i10 = 0x1p-2i
	i11 = 0x10i
	i12 = 00.5i
	i13 = 0e5i
)

var all = []any{0xFF, 1e5, 0b1, 0o1, 123i, -0x1p-2}
