// Package zgamma has interfaces.
package zgamma

import "io"

// Reader is a reader.
type Reader interface {
	// Read reads.
	Read(p []byte) (n int, err error)
	// Close closes.
	Close() error
}

// ReadWriter embeds.
type ReadWriter interface {
	Reader
	io.Writer
	error
	hidden()
	Flush()
}

// Number is a constraint.
type Number interface {
	~int | ~int64 | float64
}

// Op is a function type.
type Op func(a, b int) (int, error)

// Alias is an alias.
type Alias = Reader

// Ch is a channel.
type Ch chan<- struct{ A, B int }

// Do does it.
func Do(r Reader, ops ...Op) (result int, err error) { return }

// LongSignature has a very long parameter list that goes beyond the punched card width of eighty columns.
func LongSignature(alpha, beta, gamma, delta, epsilon, zeta, eta, theta, iota, kappa, lambda int, mu string) {
}

// Sum is generic.
func Sum[T Number](xs ...T) T { var z T; return z }

// Stack is a generic type.
type Stack[T any] struct {
	items []T
	Top   T
}

// Push pushes.
func (s *Stack[T]) Push(x T) {}

// Pop pops.
func (s *Stack[T]) Pop() (T, bool) { var z T; return z, false }

// NewStack makes a stack.
func NewStack[T any]() *Stack[T] { return nil }

// Pair has two params.
type Pair[K comparable, V any] struct {
	Key K
	Val V
}

// Anon uses anonymous structs.
var Anon = struct {
	A int
	B string
}{1, "x"}
