-- unreachable/main.gp --
package main

import "fmt"

func f() int {
	return 1
	fmt.Println("never") // want `unreachable code`
	return 2
}

func g(n int) int {
	for {
		if n > 3 {
			return n
		}
		n++
	}
}

func main() {
	fmt.Println(f(), g(0))
}
-- unsafeptr/main.gp --
package main

import "unsafe"

func main() {
	var u uintptr = 5
	p := unsafe.Pointer(u) // want `possible misuse of unsafe.Pointer`
	x := 1
	q := unsafe.Pointer(&x)
	r := uintptr(q)
	_, _ = p, r
}
-- errorsas/main.gp --
package main

import (
	"errors"
	"fmt"
)

type MyErr struct{}

func (*MyErr) Error() string { return "my" }

func main() {
	err := fmt.Errorf("x: %w", &MyErr{})
	var m MyErr
	fmt.Println(errors.As(err, m)) // want `second argument to errors.As must be a non-nil pointer to either a type that implements error, or to any interface type`
	var pm *MyErr
	fmt.Println(errors.As(err, &pm))
}
