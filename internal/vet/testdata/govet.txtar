-- composites/main.gp --
package main

import "example.com/m/composites/lib"

type Local struct{ a, b int }

func main() {
	p := lib.Point{1, 2} // want `lib.Point struct literal uses unkeyed fields`
	q := lib.Point{X: 1, Y: 2}
	l := Local{1, 2}
	_, _, _ = p, q, l
}
-- lostcancel/main.gp --
package main

import (
	"context"
	"fmt"
)

func bad() {
	ctx, cancel := context.WithCancel(context.Background()) // want `the cancel function is not used on all paths`
	fmt.Println(ctx)
	if ctx == nil {
		return // want `this return statement may be reached without using the cancel var defined on line 9`
	}
	cancel()
}

func good() {
	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()
	fmt.Println(ctx)
}

func main() {
	bad()
	good()
}
-- shift/main.gp --
package main

import "fmt"

func main() {
	var a int32 = 1
	fmt.Println(a << 40) // want `a \(32 bits\) too small for shift of 40`
	var b int64 = 1
	fmt.Println(b << 40)
	var u uint8 = 1
	fmt.Println(u >> 8) // want `u \(8 bits\) too small for shift of 8`
}
