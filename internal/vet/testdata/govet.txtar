The checks of go vet that gocpp vet runs: each with a mistake and with
code that is fine.
-- copylock_mutex/main.gp --
package main

import "sync"

type Counter struct {
	mu sync.Mutex
	n  int
}

func (c Counter) Get() int { // want `Get passes lock by value: .*Counter contains sync.Mutex`
	return c.n
}

func (c *Counter) Inc() {
	c.mu.Lock()
	c.n++
	c.mu.Unlock()
}

func main() {
	var c Counter
	d := c // want `assignment copies lock value to d: .*Counter contains sync.Mutex`
	c.Inc()
	println(d.n)
	p := &c
	_ = p
}
-- copylock_waitgroup/main.gp --
package main

import "sync"

func work(wg sync.WaitGroup) { // want `work passes lock by value: sync.WaitGroup contains sync.noCopy`
	wg.Done()
}

func ok(wg *sync.WaitGroup) {
	wg.Done()
}

func main() {
	var wg sync.WaitGroup
	wg.Add(1)
	ok(&wg)
	work(wg) // want `call of work copies lock value: sync.WaitGroup contains sync.noCopy`
}
-- copylock_literal/main.gp --
package main

import "sync"

func main() {
	var wg sync.WaitGroup
	func(x sync.WaitGroup) {}(wg) // want `func passes lock by value: sync.WaitGroup contains sync.noCopy` `call of func\(x sync.WaitGroup\) {} copies lock value: sync.WaitGroup contains sync.noCopy`
}
