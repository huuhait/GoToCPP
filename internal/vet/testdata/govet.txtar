func main() {}
-- unusedresult/main.gp --
package main

import (
	"errors"
	"fmt"
)

func main() {
	fmt.Sprintf("%d", 1) // want `result of fmt.Sprintf call not used`
	errors.New("lost")   // want `result of errors.New call not used`
	_ = fmt.Sprint("fine")
	fmt.Println("fine")
}
-- assign/main.gp --
package main

type T struct{ x int }

func main() {
	x := 1
	x = x // want `self-assignment of x`
	var t T
	t.x = t.x // want `self-assignment of t.x`
	y := 2
	x = y
	_, _ = x, t
}
-- bools/main.gp --
package main

func main() {
	x, y := 1, 2
	if x == 1 || x == 1 { // want `redundant or: x == 1 \|\| x == 1`
		println("a")
	}
	if x != 1 || x != 2 { // want `suspect or: x != 1 \|\| x != 2`
		println("b")
	}
	if x == 1 || y == 1 {
		println("c")
	}
}
