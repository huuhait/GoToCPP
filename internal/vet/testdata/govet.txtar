-- nilness/main.gp --
package main

type T struct{ x int }

func f(p *T) int {
	if p == nil {
		return p.x // want `nil dereference in field selection`
	}
	return p.x
}

func g(p *T) int {
	if p != nil {
		return p.x
	}
	return 0
}

func main() {
	_, _ = f(&T{}), g(nil)
}
-- appends_atomic_defers_waitgroup/main.gp --
package main

import (
	"fmt"
	"sync"
	"sync/atomic"
	"time"
)

func main() {
	var s []int
	s = append(s) // want `append with no values`
	var n int64
	n = atomic.AddInt64(&n, 1) // want `direct assignment to atomic value`
	start := time.Now()
	defer fmt.Println(time.Since(start)) // want `call to time.Since is not deferred`
	var wg sync.WaitGroup
	go func() {
		wg.Add(1) // want `WaitGroup.Add called from inside new goroutine`
		wg.Done()
	}()
	wg.Wait()
	fmt.Println(s, n)
}
