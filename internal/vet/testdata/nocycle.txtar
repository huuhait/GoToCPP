	cb func()
	n  int
}

func main() {
	t := &T{}
	t.cb = func() { t.n++ }
	t.cb()
	t.cb = nil
}
-- package_variable/main.gp --
package main

var counter int

var hook func()

func main() {
	hook = func() { counter++ }
	hook()
}
-- argument_closure/main.gp --
package main

import "fmt"

func apply(xs []int, f func(int) int) []int {
	out := make([]int, 0, len(xs))
	for _, x := range xs {
		out = append(out, f(x))
	}
	return out
}

func main() {
	xs := []int{1, 2, 3}
	fmt.Println(apply(xs, func(x int) int { return x * len(xs) }))
}
