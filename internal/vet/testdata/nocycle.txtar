-- unsafe_address/main.gp --
package main

import "unsafe"

type Builder struct {
	addr uintptr
	buf  []byte
}

func (b *Builder) check() {
	if b.addr == 0 {
		b.addr = uintptr(unsafe.Pointer(b))
	}
}

func main() {
	var b Builder
	b.check()
}
