-- rev_n06_weak_parent/main.gp --
package main

import (
	"fmt"
	"weak"
)

type N struct {
	parent weak.Pointer[N]
	kids   []*N
}

func build() {
	p := &N{}
	c := &N{}
	c.parent = weak.Make(p)
	p.kids = append(p.kids, c)
	fmt.Println(c.parent.Value() == p)
}

func main() { build(); fmt.Println("ok") }
