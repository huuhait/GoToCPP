Code that looks like a reference cycle and is not. Every analyzer runs on
these, so a false positive of any of them shows.
-- other_variable/main.gp --
package main

import "fmt"

func main() {
	x := 1
	var f func()
	f = func() { fmt.Println(x) }
	f()
}
-- field_other_object/main.gp --
package main

type Server struct {
	onDone func()
	n      int
}

type Logger struct{ lines int }

func main() {
	l := &Logger{}
	s := &Server{}
	s.onDone = func() { l.lines++ }
	s.onDone()
	_ = s.n
}
-- one_way_pointer/main.gp --
package main

type Node struct{ next *Node }

func main() {
	a, b := &Node{}, &Node{}
	a.next = b
	_ = a
}
-- pointer_move/main.gp --
package main

type Node struct{ next *Node }

func main() {
	var p *Node
	q := &Node{}
	p = q
	p = p.next
	_ = p
}
-- pointer_swap/main.gp --
