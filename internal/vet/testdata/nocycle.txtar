-- sort_closure/main.gp --
package main

import "fmt"

func less(xs []int) func(i, j int) bool {
	return func(i, j int) bool { return xs[i] < xs[j] }
}

func main() {
	xs := []int{3, 1, 2}
	l := less(xs)
	fmt.Println(l(0, 1))
}
-- goroutine_channel/main.gp --
package main

import "fmt"

func main() {
	ch := make(chan int)
	done := make(chan struct{})
	go func() {
		for v := range ch {
			fmt.Println(v)
		}
		close(done)
	}()
	ch <- 1
	close(ch)
	<-done
}
