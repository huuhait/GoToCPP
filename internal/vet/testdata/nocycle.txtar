-- fresh_head_rebinding/main.gp --
package main

type node struct {
	n    int
	next *node
}

func main() {
	var head *node
	for i := 3; i > 0; i-- {
		head = &node{i, head}
	}
	var s []int
	s = append(s, 1, 2)
	s = append(s, s...)
	f := func() int { return 0 }
	for i := 0; i < 3; i++ {
		prev := f
		f = func() int { return prev() + 1 }
	}
	_, _, _ = head, s, f
}
