package main

type Node struct{ next *Node }

func main() {
	n := &Node{}
	n.next = n // want `reference cycle: n.next holds n`
}
-- goroutine_cycle/main.gp --
package main

func main() {
	var loop func()
	loop = func() { // want `reference cycle: loop holds a closure that captures loop`
		go func() { loop() }()
	}
	loop()
}
-- address_of/main.gp --
package main

type Node struct{ next *Node }

func main() {
	var a Node
	var b Node
	a.next = &b
	b.next = &a // want `reference cycle: b.next holds &a, and a.next holds &b`
}
-- closure_in_literal/main.gp --
package main

type Job struct {
	run func()
	id  int
}

func main() {
	var j *Job
	j = &Job{run: func() { _ = j.id }} // want `reference cycle: j holds a closure that captures j`
	j.run()
}
-- param_cycle/main.gp --
package main

type Node struct{ peer *Node }

func link(a, b *Node) {
	a.peer = b
	b.peer = a // want `reference cycle: b.peer holds a, and a.peer holds b`
}

func main() {
	link(&Node{}, &Node{})
}
-- three_cycle/main.gp --
package main

type Node struct{ next *Node }

func main() {
	a, b, c := &Node{}, &Node{}, &Node{}
	a.next = b
	b.next = c
	c.next = a // want `reference cycle: c.next holds a, and a.next holds b, and b.next holds c`
}
-- cycle_in_method/main.gp --
package main

type T struct {
	cb func()
	n  int
}

func (t *T) install() {
	t.cb = func() { t.n++ } // want `reference cycle: t.cb holds a closure that captures t`
}

func main() {
	t := &T{}
	t.install()
}
-- rev_p01_self_closure/main.gp --
package main

import "fmt"

func build() {
	var f func(int)
	f = func(n int) { // want `reference cycle`
		if n > 0 {
			f(n - 1)
		}
	}
	f(3)
}

func main() { build(); fmt.Println("ok") }
