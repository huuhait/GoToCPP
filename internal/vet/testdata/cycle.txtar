-- rev_p42_nil_in_branch_FN/main.gp --
package main

import "fmt"

type S struct {
	n  int
	cb func()
}

func build() {
	s := &S{}
	k := 1
	s.cb = func() { s.n++ } // want `reference cycle`
	s.cb()
	if k > 100 {
		s.cb = nil
	}
}

func main() { build(); fmt.Println("ok") }
