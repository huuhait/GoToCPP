Reference cycles that gocpp's reference counting never frees: the shapes
the cycle analyzer finds.
analyzers: cycle
-- self_closure/main.gp --
package main

func main() {
	var f func()
	f = func() { f() } // want `reference cycle: f holds a closure that captures f, which keeps f alive`
	f()
}
-- fib_closure/main.gp --
package main

import "fmt"

func main() {
	var fib func(int) int
	fib = func(n int) int { // want `reference cycle: fib holds a closure that captures fib`
		if n < 2 {
			return n
		}
		return fib(n-1) + fib(n-2)
	}
	fmt.Println(fib(10))
}
-- two_closures/main.gp --
package main

func main() {
	var even, odd func(int) bool
	even = func(n int) bool { return n == 0 || odd(n-1) }
	odd = func(n int) bool { return n != 0 && even(n-1) } // want `reference cycle: odd holds a closure that captures even, and even holds a closure that captures odd`
	_ = even(4)
}
-- field_closure/main.gp --
package main

type Server struct {
	onDone func()
	n      int
}

func (s *Server) run() { s.n++ }

func main() {
	s := &Server{}
	s.onDone = func() { s.run() } // want `reference cycle: s.onDone holds a closure that captures s, which keeps s alive`
	s.onDone()
}
-- method_value/main.gp --
package main

type Server struct {
	onDone func()
	n      int
}

func (s *Server) run() { s.n++ }

func main() {
	s := &Server{}
	s.onDone = s.run // want `reference cycle: s.onDone holds the method value s.run`
	s.onDone()
}
-- map_of_closures/main.gp --
package main

func main() {
	handlers := map[string]func(){}
	handlers["a"] = func() { // want `reference cycle: handlers\["a"\] holds a closure that captures handlers`
		handlers["b"]()
	}
	handlers["b"] = func() {}
	handlers["a"]()
}
-- slice_of_closures/main.gp --
package main

type Bus struct {
	subs []func()
	n    int
}

func main() {
	b := &Bus{}
	b.subs = append(b.subs, func() { b.n++ }) // want `reference cycle: b.subs holds a closure that captures b`
	for _, f := range b.subs {
		f()
	}
}
-- literal_with_closure/main.gp --
package main

type Table struct {
	ops map[string]func() int
	n   int
}

func main() {
	t := &Table{}
	t.ops = map[string]func() int{"inc": func() int { t.n++; return t.n }} // want `reference cycle: t.ops holds a closure that captures t`
	_ = t.ops["inc"]()
}
-- parent_child/main.gp --
package main

type Node struct {
	parent *Node
	child  *Node
}

func main() {
	p := &Node{}
	c := &Node{}
	p.child = c
	c.parent = p // want `reference cycle: c.parent holds p, and p.child holds c`
}
