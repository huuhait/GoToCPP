-- rev_p12_goroutine_closure/main.gp --
package main

import "fmt"

func build() {
	done := make(chan bool)
	var f func(int)
	f = func(n int) { // want `reference cycle`
		if n == 0 {
			done <- true
			return
		}
		go f(n - 1)
	}
	go f(2)
	<-done
}

func main() { build(); fmt.Println("ok") }
-- rev_p13_chan_of_closures/main.gp --
package main

import "fmt"

func build() {
	ch := make(chan func(), 1)
	ch <- func() { _ = len(ch) } // want `reference cycle`
}

func main() { build(); fmt.Println("ok") }
-- rev_p14_interface_cycle/main.gp --
package main

import "fmt"

type I interface{ Peer() I }

type A struct{ peer I }
type B struct{ peer I }

func (a *A) Peer() I { return a.peer }
func (b *B) Peer() I { return b.peer }

func build() {
	a, b := &A{}, &B{}
	a.peer = b
	b.peer = a // want `reference cycle`
	fmt.Println(a.Peer() != nil)
}

func main() { build(); fmt.Println("ok") }
