-- rev_p33_closure_via_decorator_FN/main.gp --
package main

import "fmt"

func twice(f func(int) int) func(int) int { return func(n int) int { return f(f(n)) } }

func build() {
	var g func(int) int
	g = twice(func(n int) int { // want `reference cycle`
		if n > 100 {
			return g(n - 1)
		}
		return n + 1
	})
	fmt.Println(g(1))
}

func main() { build(); fmt.Println("ok") }
