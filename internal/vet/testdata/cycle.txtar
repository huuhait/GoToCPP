-- rev_p29_loop_built_dll/main.gp --
package main

import "fmt"

type N struct{ prev, next *N }

func build() {
	head := &N{}
	tail := head
	for i := 0; i < 3; i++ {
		n := &N{}
		n.prev = tail
		tail.next = n // want `reference cycle`
		tail = n
	}
	fmt.Println(head.next != nil)
}

func main() { build(); fmt.Println("ok") }
