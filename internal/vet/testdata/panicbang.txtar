-- across/dep/dep.gp --
package dep

import "strconv"

func parse(s string) int {
	return strconv.Atoi!(s) // want `Atoi!\(s\) panics here: parse has no error result`
}

// Twice panics through Parse, which panics through parse: the chain is followed inside a package.
func Twice(s string) int {
	return Parse(s)
}

// Parse panics through parse.
func Parse(s string) int {
	return parse(s)
}

type Box[T any] struct{ v T }

// A method of a generic type: the callee of an instance is found through its origin.
func (b *Box[T]) Parse(s string) int { return parse(s) }

func Generic[T any](s string) int { return parse(s) }

// Safe stops the panic.
func Safe(s string) (n int, err error) {
	defer func() {
		if r := recover(); r != nil {
			err = r.(error)
		}
	}()
	return parse(s), nil
}

func Fine(s string) (int, error) {
	return strconv.Atoi(s)
}
-- across/lib/lib.gp --
package lib

import "example.com/m/across/dep"

func Port(s string) int {
	return dep.Parse(s) // want `dep.Parse can panic: dep.parse uses ! at dep.gp:\d+:\d+ in a function with no error result`
}

func Safe(s string) (int, error) {
	return dep.Safe(s)
}

func ViaMethod(s string) int {
	var b dep.Box[int]
	return b.Parse(s) // want `b.Parse can panic: dep.parse uses !`
}

func ViaGeneric(s string) int {
	return dep.Generic[int](s) // want `dep.Generic\[int\] can panic: dep.parse uses !`
}

func Chain(s string) int {
	return dep.Twice(s) // want `dep.Twice can panic: dep.parse uses ! at dep.gp:\d+:\d+`
}

func Fine(s string) (int, error) {
	return dep.Fine(s)
}

func MustPort(s string) int {
	return dep.Parse(s)
}

func Guarded(s string) (n int) {
	defer func() { recover() }()
	return dep.Parse(s)
}
