}
-- deferred_across/lib/lib.gp --
package lib

import "example.com/m/deferred_across/dep"

func A() {
	dep.Clean() // want `dep.Clean can panic: dep.Clean uses ! at dep.gp:6:8`
}

func B() {
	dep.Clean2() // want `dep.Clean2 can panic`
}
-- recovers/lib.gp --
package recovers

import "strconv"

// A function that recovers may stop the panic: not reported.
func Safe(s string) (n int) {
	defer func() { recover() }()
	return strconv.Atoi!(s)
}

func Unsafe(s string) int {
	return strconv.Atoi!(s) // want `panics here: Unsafe has no error result`
}
-- main_pkg/main.gp --
package main

import "os"

// A program may panic: only libraries are asked to return their errors.
func load(path string) string {
	b := os.ReadFile!(path)
	return string(b)
}

func main() {
	println(load("x"))
}
