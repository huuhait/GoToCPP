A `!` that panics inside a library: the function has no error result, so the error of F becomes a
panic. Calls into packages that do that, found through the call graph.
analyzers: panicbang
-- direct/lib.gp --
package direct

import (
	"os"
	"strconv"
)

// Load has no error result: a failure of ReadFile panics.
func Load(path string) string {
	b := os.ReadFile!(path) // want `os.ReadFile!\(path\) panics here: Load has no error result`
	return string(b)
}

// A method: named as the user reads it.
type Server struct{ port int }

func (s *Server) Start() {
	s.port = strconv.Atoi!("80") // want `Atoi!\("80"\) panics here: \(\*Server\).Start has no error result`
}

// A func literal is its own function: its result decides.
func Parse(xs []string) []int {
	var out []int
	f := func(s string) int {
		return strconv.Atoi!(s) // want `panics here: the func literal in Parse has no error result`
	}
	for _, x := range xs {
		out = append(out, f(x))
	}
	return out
}

// A package variable's initializer panics too.
var port = strconv.Atoi!("8080") // want `panics here: the initializer of this package variable has no error result`

func init() {
	os.Remove!("/tmp/x") // want `panics here: init has no error result`
}
-- fine/lib.gp --
package fine

import (
	"os"
	"strconv"
	"testing"
)

// An error result: the error is returned.
func Load(path string) (string, error) {
	b := os.ReadFile!(path)
	return string(b), nil
}

// A must function returns its error.
func Count!(s string) int {
	return strconv.Atoi!(s)
}

// The Must convention: it panics, and says so with its name.
func MustLoad(path string) string {
	b := os.ReadFile!(path)
	return string(b)
}

func mustPort(s string) int {
	return strconv.Atoi!(s)
}

// A closure of a function with an error result has its own results.
func Each(xs []string) error {
	for _, x := range xs {
		n := strconv.Atoi!(x)
		_ = n
	}
	return nil
}

// A test function: t.Fatal, not a panic.
func check(t *testing.T, s string) int {
	return strconv.Atoi!(s)
}
-- deferred/lib.gp --
package deferred

import "os"

// defer F!(...) is a ! like another: the lowering writes a recover() into the deferred func, which
// is the compiler's and does not stop anything.
func Clean() {
	defer os.Remove!("z") // want `os.Remove!\("z"\) panics here: Clean has no error result`
}

func Clean2() {
	os.Remove!("z") // want `panics here: Clean2 has no error result`
}

// The user's own recover() does stop the panic: the function is left alone, deferred ! included.
func Guarded() {
	defer func() { recover() }()
	defer os.Remove!("z")
}

func WithError() error {
	defer os.Remove!("z")
	return nil
}
