-- skipped_stmt/main.gp --
package main

import (
	"fmt"

	"<vector>"
)

func main() {
	v := std.vector[int]{}
	if v.empty() {
		fmt.Printf("%d\n", "no") // want `Printf format %d has arg "no" of wrong type string`
	}
	switch v.size() {
	case 0:
		fmt.Printf("%d\n", "zero") // want `Printf format %d has arg "zero" of wrong type string`
	default:
		fmt.Printf("%d\n", 3)
	}
	select {
	default:
		fmt.Printf("%s\n", 4) // want `Printf format %s has arg 4 of wrong type int`
	}
}
-- opaque_arg_beside_bad/main.gp --
package main

import (
	"fmt"

	"<vector>"
)

func main() {
	v := std.vector[int]{1}
	fmt.Printf("%d %s\n", "x", v.size()) // want `Printf format %d has arg "x" of wrong type string`
	fmt.Printf("%d %d\n", int(v.size()))  // want `Printf format %d reads arg #2, but call has 1 arg`
	fmt.Printf("%s\n", int(v.size()))     // want `Printf format %s has arg .* of wrong type int`
	fmt.Printf("%d %v\n", v.size(), v)
	fmt.Printf("%d\n", int(v.size()))
	fmt.Printf("%d %d\n", len(v), "x") // want `Printf format %d has arg "x" of wrong type string`
}
-- opaque_arg_in_header/main.gp --
package main

import (
	"fmt"

	"<vector>"
)

func main() {
	v := std.vector[int]{1}
	if err := fmt.Errorf("%d", "y", v.size()); err != nil { // want `Errorf format %d has arg "y" of wrong type string`
		fmt.Println(err)
	}
	for i := 0; i < int(v.size()); i++ {
		fmt.Printf("%s\n", i) // want `Printf format %s has arg i of wrong type int`
	}
}
-- opaque_spread/main.gp --
package main

import (
	"fmt"

	"<vector>"
)

func f(format string, args ...any) {
	fmt.Printf(format, args...)
}

func main() {
	v := std.vector[int]{1}
	rest := []any{v.size()}
	f("%d\n", rest...)
	f("%d\n", "x", v.size()) // want `f format %d has arg "x" of wrong type string`
}
-- opaque_generic_call/main.gp --
package main

// A call of a generic function whose type argument C++ deduces from a C/C++ value has no type in
// go/types (it could not instantiate Grow): printf (refactor/satisfy) crashed on it ("no type for
// *ast.CallExpr"). Such a call is replaced by an unknown value, as a C/C++ argument is.
import (
	"fmt"
	"slices"

	"<string>"
)

func Count[S ~[]T, T any](xs S) int { return len(xs) }

func Grow[T any, S ~[]T](xs S, x T) S { return append(xs[:len(xs):len(xs)], x) }

func main() {
	words := []std.string{"a", "bcd"}
	fmt.Println(Count(Grow(words, std.string("x"))))
	fmt.Printf("%d\n", Count(Grow(words, std.string("y"))), "extra") // want `fmt.Printf call needs 1 arg but has 2 args`
	words = slices.Insert(words, 1, std.string("q"))
	fmt.Println(len(slices.Insert(words, 0, std.string("r"))))
	fmt.Printf("%d\n", "z") // want `Printf format %d has arg "z" of wrong type string`
}
