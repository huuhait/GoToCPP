package a

import "fmt"

func Wrap(format string, args ...any) string {
	return fmt.Sprintf(format, args...)
}
-- wrapper_cross2/b/b.gp --
package b

import "example.com/m/wrapper_cross2/a"

// Wrap2 wraps a wrapper: the fact travels through two packages.
func Wrap2(format string, args ...any) string {
	return a.Wrap(format, args...)
}
