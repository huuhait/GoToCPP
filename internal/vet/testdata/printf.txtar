Printf checks: the verbs against the argument types, the number of
arguments, wrappers (also in another package), and C/C++ values, which are
accepted wherever their type is not known.
analyzers: printf
-- verb_type/main.gp --
package main

import "fmt"

func main() {
	fmt.Printf("%d\n", "text") // want `Printf format %d has arg "text" of wrong type string`
	fmt.Printf("%s\n", 42)     // want `Printf format %s has arg 42 of wrong type int`
	fmt.Printf("%d %s\n", 1, "ok")
	fmt.Printf("%v %T\n", 1.5, []int{1})
}
-- arg_count/main.gp --
package main

import "fmt"

func main() {
	fmt.Printf("%s %s\n", "a") // want `Printf format %s reads arg #2, but call has 1 arg`
	fmt.Printf("%s\n", "a", "b") // want `Printf call needs 1 arg but has 2 args`
	fmt.Printf("%[2]s %[1]s\n", "a", "b")
}
-- println_directive/main.gp --
package main

import "fmt"

func main() {
	fmt.Println("done %d") // want `Println call has possible Printf formatting directive %d`
	fmt.Println("100%")
	fmt.Println("a", "b\n") // want `Println arg list ends with redundant newline`
}
-- sprintf_errorf/main.gp --
package main

import (
	"errors"
	"fmt"
)

func f() error {
	return fmt.Errorf("failed: %d", "x") // want `Errorf format %d has arg "x" of wrong type string`
}

func g() error {
	return fmt.Errorf("wrap: %w", errors.New("inner"))
}

func main() {
	_ = fmt.Sprintf("%q", 1.5) // want `Sprintf format %q has arg 1.5 of wrong type float64`
	_, _ = f(), g()
}
-- wrapper_local/main.gp --
package main

import "fmt"

func logf(format string, args ...any) {
	fmt.Printf(format, args...)
}

func main() {
	logf("%d\n", "text") // want `logf format %d has arg "text" of wrong type string`
	logf("%d\n", 7)
}
-- wrapper_cross/lib/lib.gp --
package lib

import "fmt"

// Logf is a Printf wrapper: the analyzer learns that in this package.
func Logf(format string, args ...any) {
	fmt.Println(fmt.Sprintf(format, args...))
}

// Plain is not.
func Plain(format string, args ...any) {
	fmt.Println(format, len(args))
}
-- wrapper_cross/main.gp --
package main

import "example.com/m/wrapper_cross/lib"

func main() {
	lib.Logf("%d\n", "text") // want `Logf format %d has arg "text" of wrong type string`
	lib.Logf("%d\n", 1)
	lib.Plain("%d\n", "text")
}
