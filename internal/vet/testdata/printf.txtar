)

func main() {
	v := std.vector[int]{1, 2}
	fmt.Printf("%v %T\n", v, v)
	fmt.Printf("%d %s\n", v.size(), v.front())
	fmt.Printf("%d\n", "text") // want `Printf format %d has arg "text" of wrong type string`
}
-- opaque_wrapper/main.gp --
package main

import (
	"fmt"

	"<string>"
)

func note(format string, args ...any) {
	fmt.Printf(format, args...)
}

func main() {
	s := std.string("x")
	note("%s %v\n", s, s)
	note("%d\n", "text") // want `note format %d has arg "text" of wrong type string`
	for i := 0; i < 2; i++ {
		fmt.Printf("%d %d\n", i) // want `Printf format %d reads arg #2, but call has 1 arg`
	}
}
