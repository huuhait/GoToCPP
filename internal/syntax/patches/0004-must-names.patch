+++ b/internal/syntax/parser/gocpp_phase10.go
@@ -0,0 +1,76 @@
+// gocpp: the names of Phase 10 syntax (../FORK.md, patch 4): a name with a
+// ! (a must call or a must function: F!, os.ReadFile!, func f!). This file
+// is new in the patch.
+
+package parser
+
+import (
+	"fmt"
+	"go/ast"
+	"go/token"
+
+	"github.com/huuhait/gocpp/internal/syntax/gpast"
+)
+
+// checkName reports an error if name is a name with a ! that the grammar
+// doesn't allow at pos: must says that it is allowed (a called function or
+// method, a func declaration). Where it is allowed, checkMarkedNames checks
+// later that it is called.
+func (p *parser) checkName(pos token.Pos, name string, must bool) {
+	if gpast.IsMust(name) {
+		if !must {
+			p.error(pos, fmt.Sprintf("cannot use %s here: a name with ! can only be a called function or method, or a func declaration", name))
+		}
+		p.sawMarked = true
+	}
+}
+
+// checkMarkedNames reports an error for each name with a ! in the tree
+// root that is not called. A name with a ! is a call: its name (or a
+// selector or an index expression that ends with it, as in os.ReadFile!,
+// parse![int]) must be the function of a call. A func declaration with a
+// name with a ! is fine too.
+func (p *parser) checkMarkedNames(root ast.Node) {
+	var stack []ast.Node
+	ast.Inspect(root, func(n ast.Node) bool {
+		if n == nil {
+			stack = stack[:len(stack)-1]
+			return true
+		}
+		stack = append(stack, n)
+		if id, ok := n.(*ast.Ident); ok && gpast.IsMust(id.Name) && !calledName(stack) {
+			p.error(id.Pos(), fmt.Sprintf("%s must be called: write %s(...)", id.Name, id.Name))
+		}
+		return true
+	})
+}
+
+// calledName reports whether the identifier at the top of the stack (the
+// path from the root to the identifier) is a called name: the function of a
+// call, perhaps as the end of a selector or with type arguments, or the
+// name of a func declaration.
+func calledName(stack []ast.Node) bool {
+	child := stack[len(stack)-1]
+	for i := len(stack) - 2; i >= 0; i-- {
+		switch par := stack[i].(type) {
+		case *ast.SelectorExpr:
+			// os.ReadFile!: the name is X or Sel.
+		case *ast.IndexExpr:
+			if par.X != child {
+				return false
+			}
+		case *ast.IndexListExpr:
+			if par.X != child {
+				return false
+			}
+		case *ast.CallExpr:
+			return par.Fun == child
+		case *ast.FuncDecl:
+			return par.Name == child
+		default:
+			return false
+		}
+		child = stack[i]
+	}
+	return false
+}
