// bench: crc32
// category: cpu
// size: 96000000
// smoke: 100000
// twin: yes
// about: table-driven CRC-32 over a generated byte buffer (table lookups, shifts)
package main

import "fmt"

func main() {
	var table [256]uint32
	for i := 0; i < 256; i++ {
		c := uint32(i)
		for k := 0; k < 8; k++ {
			if c&1 != 0 {
				c = 0xEDB88320 ^ (c >> 1)
			} else {
				c >>= 1
			}
		}
		table[i] = c
	}
	buf := make([]byte, 1<<16)
	seed := uint32(1)
	for i := range buf {
		seed = seed*1664525 + 1013904223
		buf[i] = byte(seed >> 24)
	}
	crc := ^uint32(0)
	for done := 0; done < benchN; done += len(buf) {
		for _, b := range buf {
			crc = table[byte(crc)^b] ^ (crc >> 8)
		}
	}
	fmt.Printf("%08x\n", ^crc)
}
