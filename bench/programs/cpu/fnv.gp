// twin: yes
// about: FNV-1a 64-bit hash over a generated byte buffer, repeated (multiply-xor loop)
package main

import "fmt"

func main() {
	buf := make([]byte, 1<<16)
	seed := uint32(7)
	for i := range buf {
		seed = seed*1664525 + 1013904223
		buf[i] = byte(seed >> 24)
	}
	h := uint64(14695981039346656037)
	for done := 0; done < benchN; done += len(buf) {
		for _, b := range buf {
			h ^= uint64(b)
			h *= 1099511628211
		}
	}
	fmt.Println(h)
}
