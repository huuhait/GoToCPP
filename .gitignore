# Build output: "make build", "go build ./cmd/gocpp" in the root, or a plain "go build" in cmd/gocpp
/bin/
/gocpp
/cmd/gocpp/gocpp

# Test binaries (go test -c) and coverage files
*.test
*.coverprofile
coverage.out
cover.out
coverage.html

# direnv
.direnv/

# clangd's index (it writes .cache/clangd/ next to compile_flags.txt, e.g. runtime/.cache/)
.cache/

# compile_commands.json: gocpp build writes it next to a module (ADR-044), clangd reads it
compile_commands.json

# Nix build results (nix build in the root)
/result
/result-*

# Python bytecode
__pycache__/

# npm packages: the VS Code grammar tests in editors/vscode (make vscode-test)
node_modules/

# Editor swap and backup files (Vim .swp/.swo, Emacs)
*.sw[a-p]
*~
# a fixture directory named like a backup file (tests/pkgs/ns_escape/tilde~) is deliberate
!tests/pkgs/**/*~
!tests/pkgs/**/*~/**
\#*\#
.#*
docs/benchmarks/lsp.json

# Results of make conformance (step 15.10)
/conformance-results.json
/tools/difftest/findings/
/fuzz-findings/
/fuzz-findings.md

# Benchmark runs (make bench): bench/baseline.json and bench/history/ are committed
/bench/results/
/tools/gobench/gobench

# GoReleaser output
/dist/
