# math (step 9.5): the contract is Go's results on amd64, bit for bit. tools/portstd takes the pure-Go file of every
# function (GOARCH generic), but Go on amd64 runs assembly for some of them, with results that are not always those of
# the pure-Go code (Log of a subnormal, Exp with and without FMA). These rules turn the "no assembly" stubs of
# *_noasm.go into native declarations (runtime/include/gocpp/math.hpp, runtime/src/math.cpp), and make a few leaf
# functions native for speed. Everything else stays Go's own code. docs/adr/071-math-bit-exact.md has the whole decision.

@note The results are Go's on amd64 (GOAMD64=v1): Floor, Ceil, Trunc, Sqrt, Abs, FMA and the Float bit functions are exact (native); Exp and Log run the algorithms of Go's amd64 assembly (runtime/src/math.cpp), including its two quirks: Exp uses the FMA instructions when the CPU has AVX and FMA (as Go does; `GODEBUG=cpu.fma=off` and `cpu.avx=off` select the other path, as in Go), and Log of a subnormal number is wrong in Go on amd64 (Log(5e-324) is -709.08956571282, not -744.44): gocpp has the same value. On arm64 Go runs other code for Exp and Log; gocpp gives the amd64 results there too.
@note FMA and the other operations are never fused by the C++ compiler (`-ffp-contract=off`, ADR-006), as in gc on amd64 with GOAMD64=v1 or v2; Go's own use of `math.FMA` is the only fusion.

@file unsafe.go
@why The bit casts are native: `*(*uint64)(unsafe.Pointer(&f))` would make gocpp allocate f on the heap (unsafe.Pointer keeps memory alive, divergence D16), and every other function of the package calls these.
@replace
func Float32bits(f float32) uint32 { return *(*uint32)(unsafe.Pointer(&f)) }
@with
func Float32bits(f float32) uint32
@end
@replace
func Float32frombits(b uint32) float32 { return *(*float32)(unsafe.Pointer(&b)) }
@with
func Float32frombits(b uint32) float32
@end
@replace
func Float64bits(f float64) uint64 { return *(*uint64)(unsafe.Pointer(&f)) }
@with
func Float64bits(f float64) uint64
@end
@replace
func Float64frombits(b uint64) float64 { return *(*float64)(unsafe.Pointer(&b)) }
@with
func Float64frombits(b uint64) float64
@end
@replace
package math

import "unsafe"

@with
package math

@end

@file abs.go
@why Abs is native: clearing the sign bit of x is one instruction (std::fabs), and it keeps NaN payloads like Go's.
@replace
func Abs(x float64) float64 {
	return Float64frombits(Float64bits(x) &^ (1 << 63))
}
@with
func Abs(x float64) float64
@end

@file sqrt.go
@why Sqrt is native: gc turns math.Sqrt into the SQRTSD instruction (an intrinsic), whose result is the correctly rounded square root, as std::sqrt's is; the pure-Go sqrt below stays (Go's tests use it).
@replace
func Sqrt(x float64) float64 {
	return sqrt(x)
}
@with
func Sqrt(x float64) float64
@end

@file floor.go
@why Floor, Ceil and Trunc are native, directly (not through archFloor and the other stubs, so that no call stays between the program and the instruction): amd64 has them as assembly (SSE4.1 ROUNDSD), and the results are exact, so gp::math::floor, ceil and trunc (ROUNDSD itself when the CPU has it) give the same bits, also for a signaling NaN. The Go code (floor, ceil, trunc) stays for Go's tests.
@replace
func Floor(x float64) float64 {
	if haveArchFloor {
		return archFloor(x)
	}
	return floor(x)
}
@with
func Floor(x float64) float64
@end
@replace
func Ceil(x float64) float64 {
	if haveArchCeil {
		return archCeil(x)
	}
	return ceil(x)
}
@with
func Ceil(x float64) float64
@end
@replace
func Trunc(x float64) float64 {
	if haveArchTrunc {
		return archTrunc(x)
	}
	return trunc(x)
}
@with
func Trunc(x float64) float64
@end

@file exp_noasm.go
@why Exp is Go's amd64 assembly (Shibata's algorithm, with FMA instructions when the CPU has them), not the pure-Go exp: the two differ in the last bit for many inputs.
@replace
const haveArchExp = false

func archExp(x float64) float64 {
	panic("not implemented")
}
@with
const haveArchExp = true

func archExp(x float64) float64
@end

@file log_stub.go
@why Log is Go's amd64 assembly, not the pure-Go log: the same algorithm, but the assembly takes the exponent from the bits of x without normalizing a subnormal x, so Log of a subnormal number is wrong in Go on amd64, and gocpp reproduces it (@note above).
@replace
const haveArchLog = false

func archLog(x float64) float64 {
	panic("not implemented")
}
@with
const haveArchLog = true

func archLog(x float64) float64
@end

@file fma.go
@why FMA is native: gc turns math.FMA into the VFMADD231SD instruction when the CPU has it (a runtime check), and std::fma is the same exactly rounded operation, so the bits are the same; the software version below stays for Go's tests.
@replace
func FMA(x, y, z float64) float64 {
	bx, by, bz := Float64bits(x), Float64bits(y), Float64bits(z)
@with
func FMA(x, y, z float64) float64

func fmaSoftware(x, y, z float64) float64 {
	bx, by, bz := Float64bits(x), Float64bits(y), Float64bits(z)
@end

@file floor.go
@why RoundToEven is native: gc turns it into ROUNDSD (an intrinsic with a runtime check for SSE4.1) on amd64, which turns a signaling NaN into a quiet one, as std::nearbyint does; the Go code below returns the signaling NaN as it is, so the bits would differ for that input. The Go version stays for Go's tests.
@replace
func RoundToEven(x float64) float64 {
	// RoundToEven is a faster implementation of:
@with
func RoundToEven(x float64) float64

func roundToEvenSoftware(x float64) float64 {
	// RoundToEven is a faster implementation of:
@end
