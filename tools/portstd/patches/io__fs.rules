# io/fs (step 9.4b): Go's package, with ReadDir's sort made local until package slices is real (step 7.10).

@note ReadDir sorts with a local stable merge sort by name (sortDirEntries) instead of slices.SortFunc and bytealg.CompareString: package slices is a declaration stub until step 7.10. The order is the same (the names of a directory are distinct, and the byte order of strings is the order of CompareString); the rule goes with slices.

@file readdir.go
@why package slices is not real yet (7.10): slices.SortFunc is a call of the local sortDirEntries below.
@replace
import (
	"errors"
	"internal/bytealg"
	"slices"
)
@with
import (
	"errors"
)
@end
@replace
	slices.SortFunc(list, func(a, b DirEntry) int {
		return bytealg.CompareString(a.Name(), b.Name())
	})
	return list, err
@with
	sortDirEntries(list)
	return list, err
@end
@why The local sort (a merge sort, so it is stable and O(n log n) for a big directory; a string comparison with < is the byte order, the order of bytealg.CompareString).
@replace
// dirInfo is a DirEntry based on a FileInfo.
@with
// sortDirEntries sorts list by name (the byte order of the names). Go calls slices.SortFunc with
// bytealg.CompareString; package slices is not real yet (stdlib/io/fs/PORT.md).
func sortDirEntries(list []DirEntry) {
	if len(list) < 2 {
		return
	}
	tmp := make([]DirEntry, len(list))
	mergeSortEntries(list, tmp)
}

func mergeSortEntries(a, tmp []DirEntry) {
	if len(a) <= 12 {
		for i := 1; i < len(a); i++ {
			for j := i; j > 0 && a[j].Name() < a[j-1].Name(); j-- {
				a[j], a[j-1] = a[j-1], a[j]
			}
		}
		return
	}
	mid := len(a) / 2
	mergeSortEntries(a[:mid], tmp[:mid])
	mergeSortEntries(a[mid:], tmp[mid:])
	copy(tmp, a)
	i, j, k := 0, mid, 0
	for i < mid && j < len(a) {
		if tmp[j].Name() < tmp[i].Name() {
			a[k] = tmp[j]
			j++
		} else {
			a[k] = tmp[i]
			i++
		}
		k++
	}
	for i < mid {
		a[k] = tmp[i]
		i++
		k++
	}
	for j < len(a) {
		a[k] = tmp[j]
		j++
		k++
	}
}

// dirInfo is a DirEntry based on a FileInfo.
@end
