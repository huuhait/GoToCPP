@why Same: the interface encoder recurses into the value it holds; tooDeep is defined here.
@replace
func interfaceEncoder(e *encodeState, v reflect.Value, opts encOpts) {
@with
// tooDeep gives an error (like a cycle does) when the stack has no room for one more level of nesting. (The callers test stackRoom themselves, and the error has no Value: passing v on made Marshal about 4% slower.)
func (e *encodeState) tooDeep() {
	e.error(&UnsupportedValueError{reflect.Value{}, errTooDeep})
}

func interfaceEncoder(e *encodeState, v reflect.Value, opts encOpts) {
	if stackRoom() < 0 {
		e.tooDeep()
	}
@end

