@why A type with #Derive(JSON) is encoded as the struct it stands for, without calling its MarshalJSON (which would write each level to a buffer and scan it again): the encoder of the type is chosen here, once.
@replace
func newTypeEncoder(t reflect.Type, allowAddr bool) encoderFunc {
@with
// derivedCache holds, for each struct type, the struct type that it stands for when it has #Derive(JSON), or nil: the answer is found once (derivedPlainType).
var derivedCache sync.Map // map[reflect.Type]reflect.Type

// derivedPlainType returns the struct type that the type t stands for when t is a struct with #Derive(JSON), and nil otherwise. That is a property of the type,
// found without a value of it that matters: the method of a zero value is called once, inside a recover (a method that t gets by promotion through a nil embedded
// pointer panics, and a type whose method is not the one that #Derive writes is not derived: the type that the method returns must be a struct called gp_plain...
// that t converts to and from).
func derivedPlainType(t reflect.Type) reflect.Type {
	if t.Kind() != reflect.Struct {
		return nil
	}
	if c, ok := derivedCache.Load(t); ok {
		pt, _ := c.(reflect.Type)
		return pt
	}
	pt := computeDerivedPlain(t)
	derivedCache.Store(t, pt)
	return pt
}

func computeDerivedPlain(t reflect.Type) (plain reflect.Type) {
	defer func() {
		if recover() != nil {
			plain = nil
		}
	}()
	dp, ok := reflect.New(t).Interface().(derivedPlainPtr)
	if !ok {
		return nil
	}
	r := reflect.ValueOf(dp.GoCPPJSONPlainPtr())
	if !r.IsValid() || r.Kind() != reflect.Pointer {
		return nil
	}
	et := r.Type().Elem()
	if et == t || et.Kind() != reflect.Struct || !strings.HasPrefix(et.Name(), "gp_plain") || !et.ConvertibleTo(t) || !t.ConvertibleTo(et) {
		return nil
	}
	return et
}

// derivedEncoder returns the encoder of the struct type t, or of the pointer type t, that has #Derive(JSON), and nil for any other type. It encodes the
// struct that the type stands for: through the address of the value when there is one (a pointer, or an addressable value: no copy, and the struct can be
// addressed, as the struct a pointer leads to can), as a converted copy otherwise. The encoder of a pointer is ptrEncoder's: nil, and the cycle detection.
func derivedEncoder(t reflect.Type) encoderFunc {
	if t.Kind() == reflect.Pointer {
		if plain := derivedPlainType(t.Elem()); plain != nil {
			enc := typeEncoder(plain)
			return func(e *encodeState, v reflect.Value, opts encOpts) {
				if stackRoom() < 0 {
					e.tooDeep()
				}
				if v.IsNil() {
					e.WriteString("null")
					return
				}
				pv := reflect.ValueOf(v.Interface().(derivedPlainPtr).GoCPPJSONPlainPtr()).Elem()
				opts = encOpts{escapeHTML: opts.escapeHTML}
				if e.ptrLevel++; e.ptrLevel > startDetectingCyclesAfter {
					e.derivedDeep(enc, v, pv, opts)
				} else {
					enc(e, pv, opts)
				}
				e.ptrLevel--
			}
		}
		return nil
	}
	if plain := derivedPlainType(t); plain != nil {
		enc := typeEncoder(plain)
		return func(e *encodeState, v reflect.Value, opts encOpts) {
			if stackRoom() < 0 {
				e.tooDeep()
			}
			opts = encOpts{escapeHTML: opts.escapeHTML}
			if v.CanAddr() {
				enc(e, reflect.ValueOf(v.Addr().Interface().(derivedPlainPtr).GoCPPJSONPlainPtr()).Elem(), opts)
			} else {
				enc(e, v.Convert(plain), opts)
			}
		}
	}
	return nil
}

// derivedDeep is the encoder of a derived pointer that is more than startDetectingCyclesAfter levels down: the pointer must not be on the way to itself.
func (e *encodeState) derivedDeep(enc encoderFunc, v, pv reflect.Value, opts encOpts) {
	ptr := v.UnsafePointer()
	if _, ok := e.ptrSeen[ptr]; ok {
		e.error(&UnsupportedValueError{v, fmt.Sprintf("encountered a cycle via %s", v.Type())})
	}
	e.ptrSeen[ptr] = struct{}{}
	defer delete(e.ptrSeen, ptr)
	enc(e, pv, opts)
}

func newTypeEncoder(t reflect.Type, allowAddr bool) encoderFunc {
	if enc := derivedEncoder(t); enc != nil {
		return enc
	}
@end
