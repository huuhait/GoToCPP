// phase: 08

// time.Parse over a table of layouts and values (valid inputs): the instant, the zone, and the round trip.
package main

import (
	"fmt"
	"time"
)

func main() {
	cases := [][2]string{
		{time.RFC3339, "2006-01-02T15:04:05Z"},
		{time.RFC3339, "2006-01-02T15:04:05+07:00"},
		{time.RFC3339, "2006-01-02T15:04:05-07:00"},
		{time.RFC3339, "2024-02-29T23:59:59.123456789+05:30"},
		{time.RFC3339Nano, "2024-02-29T23:59:59.1Z"},
		{time.RFC3339Nano, "1999-12-31T23:59:59.999999999-12:00"},
		{time.RFC1123, "Mon, 02 Jan 2006 15:04:05 XYZ"},
		{time.RFC1123, "Tue, 29 Feb 2024 23:59:59 UTC"},
		{time.RFC1123Z, "Mon, 02 Jan 2006 15:04:05 -0700"},
		{time.RFC1123Z, "Sat, 01 Jan 2000 00:00:00 +0000"},
		{time.RFC850, "Monday, 02-Jan-06 15:04:05 XYZ"},
		{time.RFC822, "02 Jan 06 15:04 XYZ"},
		{time.RFC822Z, "02 Jan 06 15:04 -0700"},
		{time.ANSIC, "Mon Jan  2 15:04:05 2006"},
		{time.ANSIC, "Sun Dec 31 23:59:59 1999"},
		{time.UnixDate, "Mon Jan  2 15:04:05 XYZ 2006"},
		{time.RubyDate, "Mon Jan 02 15:04:05 -0700 2006"},
		{time.Kitchen, "3:04PM"},
		{time.Kitchen, "11:59AM"},
		{time.Stamp, "Jan  2 15:04:05"},
		{time.StampMilli, "Jan  2 15:04:05.000"},
		{time.StampMicro, "Jan  2 15:04:05.000000"},
		{time.StampNano, "Jan  2 15:04:05.000000000"},
		{time.DateTime, "2006-01-02 15:04:05"},
		{time.DateOnly, "2006-01-02"},
		{time.DateOnly, "2024-02-29"},
		{time.TimeOnly, "15:04:05"},
		{time.TimeOnly, "23:59:59"},
		{"2006-01-02 15:04:05 -0700", "2024-03-10 01:30:00 -0800"},
		{"2006-01-02 15:04:05 -07:00", "2024-03-10 01:30:00 +05:45"},
		{"2006-01-02 15:04:05 Z07:00", "2024-03-10 01:30:00 Z"},
		{"2006-01-02 15:04:05 Z0700", "2024-03-10 01:30:00 -0930"},
		{"2006-01-02 15:04:05 -07", "2024-03-10 01:30:00 +09"},
		{"2006-01-02 15:04:05 -070000", "2024-03-10 01:30:00 +093045"},
		{"2006-01-02 15:04:05 MST", "2024-03-10 01:30:00 GMT"},
		{"2006-01-02 15:04:05 MST", "2024-03-10 01:30:00 GMT+3"},
		{"2006-01-02 15:04:05 MST", "2024-03-10 01:30:00 GMT-5"},
		{"2006-01-02 15:04:05 MST", "2024-03-10 01:30:00 QRS"},
		{"2006-01-02 15:04:05 MST", "2024-03-10 01:30:00 ABCD"},
		{"2006-01-02 15:04:05 MST", "2024-03-10 01:30:00 -03"},
		{"2006-01-02 15:04:05 MST", "2024-03-10 01:30:00 +0530"},
		{"Jan 2, 2006 at 3:04pm (MST)", "Feb 3, 2013 at 7:54pm (QRS)"},
		{"Mon Jan _2 2006", "Fri Mar  1 2024"},
		{"Monday January 2 2006", "Friday March 1 2024"},
		{"2006-002", "2024-060"},
		{"06-1-2", "24-3-4"},
		{"1/2/2006", "3/4/2024"},
		{"01/02/06 03:04PM", "03/04/24 11:30PM"},
		{"02 Jan 2006", "29 Feb 2024"},
		{"15:04:05.000", "12:34:56.789"},
		{"15:04:05.999999999", "12:34:56.7"},
		{"15:04:05,000", "12:34:56,789"},
		{"2006-01-02T15:04:05.999999999Z07:00", "2024-03-10T01:30:00.5-08:00"},
		{"20060102150405", "20240310013000"},
		{"20060102", "20240310"},
		{"2006.01.02", "2024.03.10"},
		{"Jan", "Mar"},
		{"January", "March"},
		{"Mon", "Fri"},
		{"2006", "2024"},
		{"3:4:5", "1:2:3"},
	}
	for _, c := range cases {
		t, err := time.Parse(c[0], c[1])
		if err != nil {
			fmt.Printf("%q %q: error %v\n", c[0], c[1], err)
			continue
		}
		_, off := t.Zone()
		// (the zone name is not printed: a numeric offset gets the name of the Local zone when it has that offset)
		fmt.Printf("%q %q: %s %d unix=%d back=%v\n", c[0], c[1], t.UTC().Format("2006-01-02 15:04:05.999999999"), off, t.Unix(), t.Format(c[0]) == c[1])
	}
}

