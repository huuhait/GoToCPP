// phase: 09
// Special values through Sinh, Cosh, Tanh, Asinh, Acosh, Atanh.

package main

import (
	"fmt"
	"math"
)

func main() {
	vals := []float64{0, math.Copysign(0, -1), 1, -1, 0.5, -0.5, 2, -2, 10, -10, math.Pi, math.Pi / 2, -math.Pi / 2, 1e-300, 5e-324, 1e300, math.MaxFloat64, math.Inf(1), math.Inf(-1), math.NaN(), 709.7, 710, -745.2, -746, 171.5, 172, 0.9999999999999999, 1.0000000000000002}
	fmt.Println("Sinh")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Sinh(x), math.Float64bits(math.Sinh(x)))
	}
	fmt.Println("Cosh")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Cosh(x), math.Float64bits(math.Cosh(x)))
	}
	fmt.Println("Tanh")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Tanh(x), math.Float64bits(math.Tanh(x)))
	}
	fmt.Println("Asinh")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Asinh(x), math.Float64bits(math.Asinh(x)))
	}
	fmt.Println("Acosh")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Acosh(x), math.Float64bits(math.Acosh(x)))
	}
	fmt.Println("Atanh")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Atanh(x), math.Float64bits(math.Atanh(x)))
	}
}

