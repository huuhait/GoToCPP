package main

import (
	"cmp"
	"fmt"
	"math"
	"slices"
)

type hasher struct {
	h     uint64
	debug bool
	name  string
	n     int
}

func newHasher(name string) *hasher { return &hasher{h: 14695981039346656037, name: name} }

func (x *hasher) u64(v uint64) {
	if x.debug {
		x.n++
		fmt.Println(x.name, x.n, v)
	}
	for i := 0; i < 8; i++ {
		x.h ^= (v >> (8 * i)) & 0xff
		x.h *= 1099511628211
	}
}
func (x *hasher) bool(b bool) {
	if b {
		x.u64(1)
	} else {
		x.u64(0)
	}
}
func (x *hasher) f64(f float64) {
	if f != f {
		x.u64(0x7ff8000000000001) // every NaN is one value
		return
	}
	x.u64(math.Float64bits(f))
}
func (x *hasher) f32(f float32) {
	if f != f {
		x.u64(0x7fc00001)
		return
	}
	x.u64(uint64(math.Float32bits(f)))
}
func (x *hasher) str(s string) {
	x.u64(uint64(len(s)))
	for i := 0; i < len(s); i++ {
		x.h ^= uint64(s[i])
		x.h *= 1099511628211
	}
}
func (x *hasher) done() {
	if x.debug {
		return
	}
	fmt.Printf("%-10s %016x\n", x.name, x.h)
}

func recoverText(f func()) (msg string) {
	defer func() {
		if r := recover(); r != nil {
			msg = fmt.Sprint(r)
		}
	}()
	f()
	return ""
}

var _ = math.Pi
var _ = cmp.Compare[int]
var _ = slices.Max[[]int]

type Int interface {
	~int8 | ~int16 | ~int32 | ~int64 | ~int | ~uint8 | ~uint16 | ~uint32 | ~uint64 | ~uint | ~uintptr
}

type Float interface{ ~float32 | ~float64 }

type Number interface{ Int | Float }

type MyI8 int8
type MyU16 uint16
type MyI64 int64
type MyU32 uint32

var raw = []int64{0, 1, 2, 3, 7, 8, 63, 64, 100, 126, 127, 128, 129, 200, 254, 255, 256, 257, 32766, 32767, 32768, 32769, 65534, 65535, 65536, 65537, 2147483647, 2147483648, 2147483649, 4294967295, 4294967296, 4294967297, 9223372036854775807, -9223372036854775808, -1, -2, -3, -127, -128, -129, -255, -256, -32768, -32769, -65536, -2147483648, -2147483649, -4294967296, 1195925616, 479783975, 53028, -3587832875413257605, 223, -8995702482976077373, -58665, 114, -3350567924, -2999674769852864489, -7987081326578613743, 8978640999070655399, 255, -52466, -8965594337163249441, 5540506332924162929, 1445448823, 76, 84, -992325061961837380}

func conv[T Int, U Int](a T) U { return U(a) }

func convF[T Int, F Float](a T) F { return F(a) }

func values[T Int]() []T {
	out := make([]T, len(raw))
	for i, r := range raw {
		out[i] = T(r)
	}
	return out
}

func toInt[F Float, T Int](f F) T { return T(f) }

// fromFloats converts floats that fit every integer type (so no implementation-defined result).
var fromFloats = []float64{0, 0.5, -0.5, 1, -1, 1.5, -1.5, 2.9999, -2.9999, 100.9, -100.9, 126.99, 127, -127.5, 0.99999, 64.5}

func sweep[T Int](name string) {
	h := newHasher(name)
	for _, a := range values[T]() {
		h.u64(uint64(conv[T, int8](a)))
		h.u64(uint64(conv[T, int16](a)))
		h.u64(uint64(conv[T, int32](a)))
		h.u64(uint64(conv[T, int64](a)))
		h.u64(uint64(conv[T, int](a)))
		h.u64(uint64(conv[T, uint8](a)))
		h.u64(uint64(conv[T, uint16](a)))
		h.u64(uint64(conv[T, uint32](a)))
		h.u64(uint64(conv[T, uint64](a)))
		h.u64(uint64(conv[T, uint](a)))
		h.u64(uint64(conv[T, uintptr](a)))
		h.u64(uint64(conv[T, MyI8](a)))
		h.u64(uint64(conv[T, MyU16](a)))
		h.u64(uint64(conv[T, MyI64](a)))
		h.u64(uint64(conv[T, MyU32](a)))
		h.f32(convF[T, float32](a))
		h.f64(convF[T, float64](a))
		h.str(fmt.Sprint(a))
		h.str(fmt.Sprintf("%d|%x|%o|%b", a, a, a, a))
	}
	h.done()
}

func sweepF[F Float](name string) {
	h := newHasher(name)
	for _, f0 := range fromFloats {
		f := F(f0)
		h.f64(float64(f))
		h.u64(uint64(toInt[F, int8](f)))
		h.u64(uint64(toInt[F, int16](f)))
		h.u64(uint64(toInt[F, int32](f)))
		h.u64(uint64(toInt[F, int64](f)))
		h.u64(uint64(toInt[F, int](f)))
		h.u64(uint64(toInt[F, MyI8](f)))
		h.u64(uint64(toInt[F, MyI64](f)))
		if f >= 0 {
			h.u64(uint64(toInt[F, uint8](f)))
			h.u64(uint64(toInt[F, uint16](f)))
			h.u64(uint64(toInt[F, uint32](f)))
			h.u64(uint64(toInt[F, uint64](f)))
			h.u64(uint64(toInt[F, uint](f)))
			h.u64(uint64(toInt[F, uintptr](f)))
			h.u64(uint64(toInt[F, MyU16](f)))
			h.u64(uint64(toInt[F, MyU32](f)))
		}
	}
	h.done()
}

func main() {
	sweep[int8]("int8")
	sweep[int16]("int16")
	sweep[int32]("int32")
	sweep[int64]("int64")
	sweep[int]("int")
	sweep[uint8]("uint8")
	sweep[uint16]("uint16")
	sweep[uint32]("uint32")
	sweep[uint64]("uint64")
	sweep[uint]("uint")
	sweep[uintptr]("uintptr")
	sweep[MyI8]("MyI8")
	sweep[MyU16]("MyU16")
	sweep[MyI64]("MyI64")
	sweep[MyU32]("MyU32")
	sweepF[float32]("float32")
	sweepF[float64]("float64")
}

