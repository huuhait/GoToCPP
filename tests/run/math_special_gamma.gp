// phase: 09
// Special values through Gamma, Erf, Erfc, Erfinv, Erfcinv, J0, J1, Y0, Y1.

package main

import (
	"fmt"
	"math"
)

func main() {
	vals := []float64{0, math.Copysign(0, -1), 1, -1, 0.5, -0.5, 2, -2, 10, -10, math.Pi, math.Pi / 2, -math.Pi / 2, 1e-300, 5e-324, 1e300, math.MaxFloat64, math.Inf(1), math.Inf(-1), math.NaN(), 709.7, 710, -745.2, -746, 171.5, 172, 0.9999999999999999, 1.0000000000000002}
	fmt.Println("Gamma")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Gamma(x), math.Float64bits(math.Gamma(x)))
	}
	fmt.Println("Erf")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Erf(x), math.Float64bits(math.Erf(x)))
	}
	fmt.Println("Erfc")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Erfc(x), math.Float64bits(math.Erfc(x)))
	}
	fmt.Println("Erfinv")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Erfinv(x), math.Float64bits(math.Erfinv(x)))
	}
	fmt.Println("Erfcinv")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Erfcinv(x), math.Float64bits(math.Erfcinv(x)))
	}
	fmt.Println("J0")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.J0(x), math.Float64bits(math.J0(x)))
	}
	fmt.Println("J1")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.J1(x), math.Float64bits(math.J1(x)))
	}
	fmt.Println("Y0")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Y0(x), math.Float64bits(math.Y0(x)))
	}
	fmt.Println("Y1")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Y1(x), math.Float64bits(math.Y1(x)))
	}
}

