// Generated by tools/genericsgen (family order): a hash sweep of generic code, compared with real Go.
package main

import (
	"cmp"
	"fmt"
	"math"
	"slices"
)

type hasher struct {
	h     uint64
	debug bool
	name  string
	n     int
}

func newHasher(name string) *hasher { return &hasher{h: 14695981039346656037, name: name} }

func (x *hasher) u64(v uint64) {
	if x.debug {
		x.n++
		fmt.Println(x.name, x.n, v)
	}
	for i := 0; i < 8; i++ {
		x.h ^= (v >> (8 * i)) & 0xff
		x.h *= 1099511628211
	}
}
func (x *hasher) bool(b bool) {
	if b {
		x.u64(1)
	} else {
		x.u64(0)
	}
}
func (x *hasher) f64(f float64) {
	if f != f {
		x.u64(0x7ff8000000000001) // every NaN is one value
		return
	}
	x.u64(math.Float64bits(f))
}
func (x *hasher) f32(f float32) {
	if f != f {
		x.u64(0x7fc00001)
		return
	}
	x.u64(uint64(math.Float32bits(f)))
}
func (x *hasher) str(s string) {
	x.u64(uint64(len(s)))
	for i := 0; i < len(s); i++ {
		x.h ^= uint64(s[i])
		x.h *= 1099511628211
	}
}
func (x *hasher) done() {
	if x.debug {
		return
	}
	fmt.Printf("%-10s %016x\n", x.name, x.h)
}

func recoverText(f func()) (msg string) {
	defer func() {
		if r := recover(); r != nil {
			msg = fmt.Sprint(r)
		}
	}()
	f()
	return ""
}

var _ = math.Pi
var _ = cmp.Compare[int]
var _ = slices.Max[[]int]

type Int interface {
	~int8 | ~int16 | ~int32 | ~int64 | ~int | ~uint8 | ~uint16 | ~uint32 | ~uint64 | ~uint | ~uintptr
}

type Float interface{ ~float32 | ~float64 }

type Number interface{ Int | Float }

type MyI8 int8
type MyU16 uint16
type MyI64 int64
type MyF float64
type MyS string
type MyU32 uint32

var seed uint64 = 1306629941461256912

func next() uint64 {
	seed += 0x9E3779B97F4A7C15
	z := seed
	z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
	z = (z ^ (z >> 27)) * 0x94D049BB133111EB
	return z ^ (z >> 31)
}

type Ordered interface {
	~int8 | ~int16 | ~int32 | ~int64 | ~int | ~uint8 | ~uint16 | ~uint32 | ~uint64 | ~uint | ~uintptr | ~float32 | ~float64 | ~string
}

type Num interface {
	~int8 | ~int16 | ~int32 | ~int64 | ~int | ~uint8 | ~uint16 | ~uint32 | ~uint64 | ~uint | ~uintptr | ~float32 | ~float64
}

func genNum[T Num]() T {
	v := next()
	switch v % 7 {
	case 0:
		return 0
	case 1:
		return T(v % 5)
	case 2:
		return T(v%100) + 100
	default:
		k := uint64(1 << 20)
		return T(v>>40) - T(k)
	}
}

func genStr[T ~string]() T { return T(fmt.Sprint(next() % 40)) }

func less[T Ordered](a, b T) bool { return a < b }

func isort[T Ordered](s []T) {
	for i := 1; i < len(s); i++ {
		for j := i; j > 0 && less(s[j], s[j-1]); j-- {
			s[j], s[j-1] = s[j-1], s[j]
		}
	}
}

func hashOf[T Ordered](h *hasher, v T) {
	switch x := any(v).(type) {
	case float32:
		h.f32(x)
	case float64:
		h.f64(x)
	case MyF:
		h.f64(float64(x))
	case string:
		h.str(x)
	case MyS:
		h.str(string(x))
	default:
		h.str(fmt.Sprint(v))
	}
}

func sweep[T Ordered](name string, gen func() T) {
	h := newHasher(name)
	for round := 0; round < 12; round++ {
		xs := make([]T, 1+round*5)
		for i := range xs {
			xs[i] = gen()
		}
		for _, a := range xs {
			for _, b := range xs {
				hashOf(h, max(a, b))
				hashOf(h, min(a, b))
				h.bool(a < b)
				h.bool(a >= b)
				h.u64(uint64(cmp.Compare(a, b) + 1))
				h.bool(cmp.Less(a, b))
			}
		}
		ys := slices.Clone(xs)
		isort(ys)
		zs := slices.Clone(xs)
		slices.Sort(zs)
		h.bool(slices.Equal(ys, zs))
		ws := slices.Clone(xs)
		slices.SortFunc(ws, func(a, b T) int { return cmp.Compare(b, a) })
		slices.Reverse(ws)
		h.bool(slices.Equal(ws, zs))
		for _, y := range ys {
			hashOf(h, y)
		}
		hashOf(h, slices.Max(xs))
		hashOf(h, slices.Min(xs))
		h.bool(slices.IsSorted(zs))
		h.bool(slices.IsSorted(xs))
		for _, x := range xs {
			i, found := slices.BinarySearch(zs, x)
			h.u64(uint64(i))
			h.bool(found)
			h.u64(uint64(slices.Index(xs, x)))
			h.bool(slices.Contains(zs, x))
		}
		zs = slices.Compact(zs)
		h.u64(uint64(len(zs)))
		h.u64(uint64(slices.Compare(xs, ys) + 1))
	}
	h.done()
}

func main() {
	sweep("int8", genNum[int8])
	sweep("uint8", genNum[uint8])
	sweep("int16", genNum[int16])
	sweep("uint16", genNum[uint16])
	sweep("int32", genNum[int32])
	sweep("uint32", genNum[uint32])
	sweep("int64", genNum[int64])
	sweep("uint64", genNum[uint64])
	sweep("int", genNum[int])
	sweep("uint", genNum[uint])
	sweep("uintptr", genNum[uintptr])
	sweep("float32", genNum[float32])
	sweep("float64", genNum[float64])
	sweep("MyI8", genNum[MyI8])
	sweep("MyU16", genNum[MyU16])
	sweep("MyF", genNum[MyF])
	sweep("string", genStr[string])
	sweep("MyS", genStr[MyS])
}

