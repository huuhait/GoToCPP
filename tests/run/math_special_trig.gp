// phase: 09
// Special values through Sin, Cos, Tan, Asin, Acos, Atan: results and bits, as Go prints them.

package main

import (
	"fmt"
	"math"
)

func main() {
	vals := []float64{0, math.Copysign(0, -1), 1, -1, 0.5, -0.5, 2, -2, 10, -10, math.Pi, math.Pi / 2, -math.Pi / 2, 1e-300, 5e-324, 1e300, math.MaxFloat64, math.Inf(1), math.Inf(-1), math.NaN(), 709.7, 710, -745.2, -746, 171.5, 172, 0.9999999999999999, 1.0000000000000002}
	fmt.Println("Sin")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Sin(x), math.Float64bits(math.Sin(x)))
	}
	fmt.Println("Cos")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Cos(x), math.Float64bits(math.Cos(x)))
	}
	fmt.Println("Tan")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Tan(x), math.Float64bits(math.Tan(x)))
	}
	fmt.Println("Asin")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Asin(x), math.Float64bits(math.Asin(x)))
	}
	fmt.Println("Acos")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Acos(x), math.Float64bits(math.Acos(x)))
	}
	fmt.Println("Atan")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Atan(x), math.Float64bits(math.Atan(x)))
	}
}

