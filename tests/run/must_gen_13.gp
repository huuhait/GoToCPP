package main

import (
	"errors"
	"fmt"
)

var ErrBad = errors.New("bad")

func f1(n int) (int, error) {
	fmt.Println("f1", n)
	if n%5 == 3 {
		return 0, fmt.Errorf("f1(%d): %w", n, ErrBad)
	}
	return n*2 + 1, nil
}

func f2(n int) (int, int, error) {
	fmt.Println("f2", n)
	if n%6 == 2 {
		return 0, 0, fmt.Errorf("f2(%d): %w", n, ErrBad)
	}
	return n + 1, n - 1, nil
}

func f3(n int) error {
	fmt.Println("f3", n)
	if n%7 == 4 {
		return fmt.Errorf("f3(%d): %w", n, ErrBad)
	}
	return nil
}

func b1(n int) (bool, error) {
	fmt.Println("b1", n)
	if n%8 == 5 {
		return false, fmt.Errorf("b1(%d): %w", n, ErrBad)
	}
	return n%2 == 0, nil
}

func run!(seed int) int {
	v0, v1, v2, v3 := seed, seed*3+1, seed%4, 7-seed
	f3(v3)
	if (b1(f1(v1)) || (b1(2) || b1(f1(4)))) {
		v3 = v1
		if b1((6 + 9)) {
			v2 = f1(v0)
			v0 = (v3 - 5)
		} else if (((v3 - 9) < f1(1) && b1(8)) || ((4 - v2) < (2 + 3) && b1(f1(v0)))) {
			v2 = v2
		} else if (b1((v1 - v3)) && (b1(6) && f1(v2) < v3)) {
			v1 = f1((2 - 5))
			v1 = f1(9)
		} else {
			v3 = f1(v0)
			v2 = (f1(1) - (0 - 6))
			v0 = f1(f1(v3))
		}
		f3(9)
	} else {
		v2 = f1(f1(v0))
	}
	v1 = f1(v0)
	return (v0*1000 + v1*100 + v2*10 + v3) % 100000
}

func main() {
	for seed := 0; seed < 10; seed++ {
		v, err := run(seed)
		fmt.Println("run", seed, v, err, errors.Is(err, ErrBad))
	}
}

