// phase: 05

// Go's %b of float64 values (basic) with flags, width and precision, as strconv.AppendFloat and
// fmt.fmtFloat do.
package main

import "fmt"

func main() {
	fmt.Printf("[%b]\n", 0.0)
	fmt.Printf("[%+b]\n", 0.0)
	fmt.Printf("[%-b]\n", 0.0)
	fmt.Printf("[% b]\n", 0.0)
	fmt.Printf("[%0b]\n", 0.0)
	fmt.Printf("[%#b]\n", 0.0)
	fmt.Printf("[%30b]\n", 0.0)
