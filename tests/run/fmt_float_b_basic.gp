	fmt.Printf("[%.0b]\n", 0.5)
	fmt.Printf("[%.1b]\n", 0.5)
	fmt.Printf("[%.3b]\n", 0.5)
	fmt.Printf("[%.10b]\n", 0.5)
	fmt.Printf("[%#.3b]\n", 0.5)
	fmt.Printf("[%#30b]\n", 0.5)
	fmt.Printf("[%b]\n", 123456.789)
	fmt.Printf("[%+b]\n", 123456.789)
	fmt.Printf("[%-b]\n", 123456.789)
	fmt.Printf("[% b]\n", 123456.789)
	fmt.Printf("[%0b]\n", 123456.789)
	fmt.Printf("[%#b]\n", 123456.789)
	fmt.Printf("[%30b]\n", 123456.789)
	fmt.Printf("[%-30b]\n", 123456.789)
	fmt.Printf("[%030b]\n", 123456.789)
	fmt.Printf("[%+030b]\n", 123456.789)
	fmt.Printf("[%.0b]\n", 123456.789)
	fmt.Printf("[%.1b]\n", 123456.789)
	fmt.Printf("[%.3b]\n", 123456.789)
	fmt.Printf("[%.10b]\n", 123456.789)
	fmt.Printf("[%#.3b]\n", 123456.789)
	fmt.Printf("[%#30b]\n", 123456.789)
}

