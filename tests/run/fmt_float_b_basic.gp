	fmt.Printf("[%.1b]\n", 1.0)
	fmt.Printf("[%.3b]\n", 1.0)
	fmt.Printf("[%.10b]\n", 1.0)
	fmt.Printf("[%#.3b]\n", 1.0)
	fmt.Printf("[%#30b]\n", 1.0)
	fmt.Printf("[%b]\n", -1.0)
	fmt.Printf("[%+b]\n", -1.0)
	fmt.Printf("[%-b]\n", -1.0)
	fmt.Printf("[% b]\n", -1.0)
	fmt.Printf("[%0b]\n", -1.0)
	fmt.Printf("[%#b]\n", -1.0)
