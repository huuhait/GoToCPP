// phase: 08

// Time.Format over a table of layouts: every element of the layout language.
package main

import (
	"fmt"
	"time"
)

func main() {
	t := time.Date(2024, 3, 7, 5, 9, 4, 12345678, time.FixedZone("CET", 3600))
	u := time.Date(2009, 11, 30, 23, 59, 59, 987000000, time.UTC)
	n := time.Date(1987, 12, 1, 0, 0, 0, 0, time.FixedZone("MST", -7*3600))
	p := time.Date(2020, 10, 31, 12, 30, 0, 500000000, time.FixedZone("", -(3*3600 + 30*60)))
	layouts := []string{
		"2006", "06", "01", "1", "Jan", "January", "02", "2", "_2", "__2", "002", "Mon", "Monday",
		"15", "03", "3", "04", "4", "05", "5", "PM", "pm", "MST", "-0700", "-07:00", "-07", "-070000", "-07:00:00",
		"Z0700", "Z07:00", "Z07", "Z070000", "Z07:00:00",
		"2006-01-02", "02/01/06", "1/2/06", "Jan _2", "Jan  2 2006", "Mon Jan _2", "Monday, January 2, 2006",
		"15:04:05", "3:04PM", "03:04:05 PM", "3:4:5 pm", "15h04m05s", "15:04:05.000", "15:04:05.00", "15:04:05.0",
		"15:04:05.999", "15:04:05.99", "15:04:05.9", "15:04:05,000", "15:04:05,999999999", ".000000000", ".999999999",
		"05.000", "05.999", "5.000000", "2006-01-02T15:04:05.000Z07:00", "2006-01-02 15:04:05.999999 -0700 MST",
		"002 2006", "__2 Jan", "_2 __2 002", "01-02 15:04", "20060102150405", "2006/1/2 3:4:5",
		"Jan 2, 2006 at 3:04pm (MST)", "'06", "2006 is the year", "no layout elements: xyz", "", "Jan2", "Janu", "January2006",
		"Mon2", "Monday2", "MST-07", "1-1", "1111", "0102", "0000", "20060", "200600", "-0700 -07:00 Z07:00", ".00 .000", "05,000",
		"05.0000000000", "pm PM", "Pm", "p", "PM3", "Z", "07", "0700", "Mond", "Mon,", "_", "_2006", "__20", "00",
	}
	for _, l := range layouts {
		fmt.Printf("%-34q %q %q %q %q\n", l, t.Format(l), u.Format(l), n.Format(l), p.Format(l))
	}
	// the same layouts through AppendFormat
	b := []byte("prefix:")
	b = t.AppendFormat(b, time.RFC3339Nano)
	fmt.Println(string(b), len(b))
	b = u.AppendFormat(b[:0], "Jan _2 15:04")
	fmt.Println(string(b))
}

