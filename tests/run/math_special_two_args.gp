// phase: 09
// Special values through Atan2, Hypot, Mod, Remainder, Dim, Max, Min, Copysign, Nextafter (all pairs of 14 values).

package main

import (
	"fmt"
	"math"
)

func main() {
	vals := []float64{0, math.Copysign(0, -1), 1, -1, 2.5, -2.5, 1e300, 5e-324, math.Inf(1), math.Inf(-1), math.NaN(), 3, 0.5, 1 << 60}
	fmt.Println("Atan2")
	for _, x := range vals {
		for _, y := range vals {
			fmt.Printf("  %v %v -> %v (%016x)\n", x, y, math.Atan2(x, y), math.Float64bits(math.Atan2(x, y)))
		}
	}
	fmt.Println("Hypot")
	for _, x := range vals {
		for _, y := range vals {
			fmt.Printf("  %v %v -> %v (%016x)\n", x, y, math.Hypot(x, y), math.Float64bits(math.Hypot(x, y)))
		}
	}
	fmt.Println("Mod")
	for _, x := range vals {
		for _, y := range vals {
			fmt.Printf("  %v %v -> %v (%016x)\n", x, y, math.Mod(x, y), math.Float64bits(math.Mod(x, y)))
		}
	}
	fmt.Println("Remainder")
	for _, x := range vals {
		for _, y := range vals {
			fmt.Printf("  %v %v -> %v (%016x)\n", x, y, math.Remainder(x, y), math.Float64bits(math.Remainder(x, y)))
		}
	}
	fmt.Println("Dim")
	for _, x := range vals {
		for _, y := range vals {
			fmt.Printf("  %v %v -> %v (%016x)\n", x, y, math.Dim(x, y), math.Float64bits(math.Dim(x, y)))
		}
	}
	fmt.Println("Max")
	for _, x := range vals {
		for _, y := range vals {
			fmt.Printf("  %v %v -> %v (%016x)\n", x, y, math.Max(x, y), math.Float64bits(math.Max(x, y)))
		}
	}
	fmt.Println("Min")
	for _, x := range vals {
		for _, y := range vals {
			fmt.Printf("  %v %v -> %v (%016x)\n", x, y, math.Min(x, y), math.Float64bits(math.Min(x, y)))
		}
	}
	fmt.Println("Copysign")
	for _, x := range vals {
		for _, y := range vals {
			fmt.Printf("  %v %v -> %v (%016x)\n", x, y, math.Copysign(x, y), math.Float64bits(math.Copysign(x, y)))
		}
	}
	fmt.Println("Nextafter")
	for _, x := range vals {
		for _, y := range vals {
			fmt.Printf("  %v %v -> %v (%016x)\n", x, y, math.Nextafter(x, y), math.Float64bits(math.Nextafter(x, y)))
		}
	}
}

