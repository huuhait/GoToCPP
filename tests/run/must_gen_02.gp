// phase: 05

// Generated by tests/mustgen (seed 1, program 2): ! calls in random places;
// its twin in testdata/must_twin/ is the same program in plain Go.
package main

import (
	"errors"
	"fmt"
)

var ErrBad = errors.New("bad")

func f1(n int) (int, error) {
	fmt.Println("f1", n)
	if n%5 == 3 {
		return 0, fmt.Errorf("f1(%d): %w", n, ErrBad)
	}
	return n*2 + 1, nil
}

func f2(n int) (int, int, error) {
	fmt.Println("f2", n)
	if n%6 == 2 {
		return 0, 0, fmt.Errorf("f2(%d): %w", n, ErrBad)
	}
	return n + 1, n - 1, nil
}

func f3(n int) error {
	fmt.Println("f3", n)
	if n%7 == 4 {
		return fmt.Errorf("f3(%d): %w", n, ErrBad)
	}
	return nil
}

func b1(n int) (bool, error) {
	fmt.Println("b1", n)
	if n%8 == 5 {
		return false, fmt.Errorf("b1(%d): %w", n, ErrBad)
	}
	return n%2 == 0, nil
}

func run(seed int) (int, error) {
	v0, v1, v2, v3 := seed, seed*3+1, seed%4, 7-seed
	v0 = v3
	if b1!(f1!(v3)) {
		switch f1!(f1!(v3)) % 3 {
		case 0:
			f3!(v2)
		case 1:
			switch (v0 - f1!(0)) % 3 {
			case 0:
				v3 = (v3 - f1!(v2))
				v2 = 5
			case 1:
				v3, v1 = f2!((v3 - v1))
				v1 = (v2 - 3)
			default:
				v1 = f1!(f1!(v3))
				f3!(f1!(v2))
			}
			v3 = v0
		default:
			v3, v2 = f2!(f1!(v3))
			if b1!(f1!(v1)) {
				f3!(f1!(v0))
				v1 = v3
			} else {
				v1 += v0
				v2 += f1!(f1!(v1))
			}
		}
	} else if !((b1!(f1!(v3)) && f1!(v0) < v1)) {
		if b1!(1) {
			v0 = f1!((v2 - v0))
		} else if (v1 + 7) < f1!(v3) {
			v3 = f1!(0)
			v2, v0 = f2!(f1!(1))
			v1 += f1!(f1!(v0))
		}
	} else if b1!(v1) {
		if !((0 - 4) < f1!(v2)) {
			switch (v1 - f1!(2)) % 3 {
			case 0:
				v1 = f1!(f1!(v1))
				v1 = f1!(2)
			case 1:
				v3 += f1!((3 + v3))
				f3!(f1!(v2))
				v1, v0 = f2!((v3 - v1))
			default:
				v0 = (v3 + 0)
				v1 = f1!(v2)
				v2 = f1!(v1)
			}
			v1 = v3
		}
		v1 += f1!((v3 - v1))
		v1 += v1
	}
	v1 = f1!(4)
	return (v0*1000 + v1*100 + v2*10 + v3) % 100000, nil
}

func main() {
	for seed := 0; seed < 10; seed++ {
		v, err := run(seed)
		fmt.Println("run", seed, v, err, errors.Is(err, ErrBad))
	}
}

