// phase: 08

// Year, Month, Day, Clock, Date, Hour, Minute, Second, Nanosecond for instants from far in the past to far in the future.
package main

import (
	"fmt"
	"time"
)

func main() {
	secs := []int64{0, 1, -1, 59, 3600, 86399, 86400, -86400, 951782400, 1709164800, 1709251200, -2208988800, -62135596800, -62135596801,
		253402300799, 253402300800, 32503680000, -30610224000, 1 << 33, -(1 << 33), 1 << 50, -(1 << 50), 1 << 60, -(1 << 60), 9223372036854775807, -9223372036854775808}
	for _, s := range secs {
		t := time.Unix(s, 123456789).UTC()
		y, m, d := t.Date()
		h, mi, se := t.Clock()
		fmt.Printf("%d: %d-%02d-%02d %02d:%02d:%02d.%09d %s yday=%d | %d %d %d %d %d %d %d\n", s, y, m, d, h, mi, se, t.Nanosecond(), t.Weekday(), t.YearDay(),
			t.Year(), int(t.Month()), t.Day(), t.Hour(), t.Minute(), t.Second(), t.Nanosecond())
	}
	// every second of a day's boundary
	for _, s := range []int64{86399, 86400, 86401, -1, 0} {
		t := time.Unix(s, 0).UTC()
		fmt.Println(t.Format("2006-01-02 15:04:05"))
	}
	// negative years
	t := time.Date(-100, 2, 29, 12, 0, 0, 0, time.UTC)
	fmt.Println(t.Year(), t.Month(), t.Day(), t.Weekday(), t.Format("2006-01-02"), t.Format("06"))
	// year 0
	t = time.Date(0, 1, 1, 0, 0, 0, 0, time.UTC)
	fmt.Println(t.Year(), t.Unix(), t.Format(time.RFC3339), t)
	// the largest and smallest representable dates through Date
	fmt.Println(time.Date(292277026596, 12, 4, 15, 30, 7, 0, time.UTC).Unix())
	fmt.Println(time.Date(-292277022399, 1, 2, 0, 0, 0, 0, time.UTC).Unix())
}

