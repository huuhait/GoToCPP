// phase: 10

// Generated by tests/mustgen (seed 1, program 8): ! calls in random places;
// its twin in testdata/must_twin/ is the same program in plain Go.
package main

import (
	"errors"
	"fmt"
)

var ErrBad = errors.New("bad")

func f1(n int) (int, error) {
	fmt.Println("f1", n)
	if n%5 == 3 {
		return 0, fmt.Errorf("f1(%d): %w", n, ErrBad)
	}
	return n*2 + 1, nil
}

func f2(n int) (int, int, error) {
	fmt.Println("f2", n)
	if n%6 == 2 {
		return 0, 0, fmt.Errorf("f2(%d): %w", n, ErrBad)
	}
	return n + 1, n - 1, nil
}

func f3(n int) error {
	fmt.Println("f3", n)
	if n%7 == 4 {
		return fmt.Errorf("f3(%d): %w", n, ErrBad)
	}
	return nil
}

func b1(n int) (bool, error) {
	fmt.Println("b1", n)
	if n%8 == 5 {
		return false, fmt.Errorf("b1(%d): %w", n, ErrBad)
	}
	return n%2 == 0, nil
}

func run(seed int) (int, error) {
	v0, v1, v2, v3 := seed, seed*3+1, seed%4, 7-seed
	switch {
	case b1!(f1!(v0)):
		v0 = v2
		if b1!((v1 - v0)) {
			v1 = v1
			if b1!(v3) {
				v1 += f1!(9)
			} else if b1!(f1!(v2)) {
				v1 = (v2 + 9)
				v3 = (v1 - 9)
			} else {
				v1 = v0
				v1 += f1!((v1 + v0))
			}
		}
		v0 = (v1 - f1!(v0))
	case b1!(v0):
		for i1 := 0; i1 < 3 && b1!(f1!(v3)); i1++ {
			for i2 := 0; i2 < 1 && !(b1!(v0)); i2++ {
				v2 += v0
				v3 += 2
				if (v1 + v3) < 6 {
					continue
				}
			}
			v1 = f1!(f1!(2))
		}
		f3!((v0 + v0))
	default:
		v1, v2 = f2!(6)
	}
	v2 = 7
	f3!(f1!(v2))
	return (v0*1000 + v1*100 + v2*10 + v3) % 100000, nil
}

func main() {
	for seed := 0; seed < 10; seed++ {
		v, err := run(seed)
		fmt.Println("run", seed, v, err, errors.Is(err, ErrBad))
	}
}

