// phase: 08

// Generated by tests/mustgen -mode ord (seed 2, program 6): the order of evaluation around ! calls.
// Its twin in testdata/must_twin/ is the same text without the !.
package main

import (
	"errors"
	"fmt"
)

var failAt = -1

type Pt struct {
	id int
	X  int
}

type Cell struct{ A, B int }

type Num int

func sum(id int, args []int) int {
	s := id * 3
	for _, a := range args {
		s += a
	}
	return s % 1000
}

func m8(x int) int { return (x%8 + 8) % 8 }

func b1(x int) int { return x & 1 }

func L(id int, args ...int) int {
	fmt.Println("L", id)
	return sum(id, args)
}

func S(id int) []int {
	fmt.Println("S", id)
	return []int{10, 11, 12, 13, 14, 15, 16, 17}
}

func FN(id int) []func(int) int {
	fmt.Println("FN", id)
	var fs []func(int) int
	for i := 0; i < 8; i++ {
		fs = append(fs, func(x int) int { return x + i })
	}
	return fs
}

func MP(id int) map[int]int {
	fmt.Println("MP", id)
	m := map[int]int{}
	for i := 0; i < 8; i++ {
		m[i] = i * i
	}
	return m
}

func PT(id int) *Pt {
	fmt.Println("PT", id)
	return &Pt{id: id, X: id + 1}
}

func (p *Pt) M(a int) int {
	fmt.Println("M", p.id)
	return p.id + a
}

func PI(id int) *int {
	fmt.Println("PI", id)
	v := id * 2
	return &v
}

func A(id int) any {
	fmt.Println("A", id)
	return id
}

func CH(id int) chan int {
	fmt.Println("CH", id)
	c := make(chan int, 1)
	c <- id + 100
	return c
}

func GEN[T int | int64](a T) T {
	fmt.Println("GEN", a)
	return a + 1
}

func Add2(a, b int) int { return a*10 + b }

func fail(id int) error {
	return fmt.Errorf("fail %d: %w", id, ErrBad)
}

var ErrBad = errors.New("bad")

func run() (int, error) {
	v0, v1, v2, v3 := 1, 2, 3, 4
	var arr [8]int
	ch := make(chan int, 64)
	_ = ch
	for i1 := b1(G!(101, ([]int{v3, v1, v2}[1]), Add2(Two!(102, v3)))); i1 < 3 && PT(2).M(G!(100, 1, 3)) < ([]int{min(v1, v3), v2, FN(3)[m8(L(4))](v2)}[1]); i1 += 1 + b1((PT(5).M)(int(Num(v0)))) {
		v0 += ([]int{S(6)[m8(GEN[int](v3))], FN(7)[m8(MP(8)[m8(i1)])](G!(103, v1, v0)), G!(104, min(v1, v0), v0)}[1])
		v3 = 4
	}
	v0 = (A(9).(int) - G!(105, G!(106, v1, v1), min(v3, v0)))
	if (GEN[int](v3) == 4) {
		if v2 < FN(10)[m8(PT(11).M(v2))]((<-CH(12) + v3)) {
			return v1, nil
		}
		arr[m8(FN(13)[m8(([]int{1, 6, v2}[1]))](append(S(14), v3)[2]))]++
	}
	switch (len(S(15)) + Add2(Two!(107, v0))) {
	case m8(PT(16).GM!(108, v1)):
		v0 += int(int64(int(Num(int(int64(v3))))))
		arr[m8(S(17)[m8(GEN[int]((func(a, b int) int { return a*2 + b }(9, 8))))])] += (func(a, b int) int { return a*2 + b }(G!(109, G!(110, 7, v1)), G!(111, v0, FN(18)[m8(L(19))](v0))))
		if (PT(20).GM!(112, v1) < int(int64(v1)) || ([]int{8, v1, 9}[1]) < (func(a, b int) int { return a*2 + b }(v0, v2))) {
			v0 = min((PT(21).M)(PT(22).M(v0)), FN(23)[m8(L(24))](Add2(Two!(113, 3))))
		} else if !((v0 < v0 && 2 < 9)) {
			arr[m8(MP(25)[m8(L(26))])] = ([]int{(Cell{A: (Cell{A: v0, B: v0}.B), B: G!(114, v2, v2)}.B), MP(27)[m8(L(28))], G!(115, GEN[int](v2), (<-CH(29) + v1))}[1])
		}
	case m8(PT(30).M(G!(116))):
		PT(31).X = 0
		arr[m8((len(S(32)) + G!(117)))]++
	default:
		v3 = int(Num(int(Num(PT(33).GM!(118, 6)))))
		ch <- int(Num((map[int]int{m8(v3): v0, m8(v0) + 8: 9}[3])))
	}
	v0 = (func(a, b int) int { return a*2 + b }(G!(119, 2, v1), (v2*3 - v3)))
	if GB!(120, ([]int{v2, v3, 5}[1])) {
		arr[m8(FN(34)[m8(int(int64(7)))](FN(35)[m8(L(36))](v1)))] += PT(37).GM!(121, append(S(38), v2)[2])
	} else {
		ch <- int(Num((*PI(39) + (map[int]int{m8(8): 6, m8(v2) + 8: v1}[3]))))
		ch <- v1
		for i40 := b1(PT(43).GM!(124, GG![int](125, 6))); i40 < 3 && (L(41) > GEN[int](i40)); i40 += 1 + b1(([]int{G!(122, v3, i40), min(3, 2), PT(42).GM!(123, i40)}[1])) {
			ch <- G!(126)
			arr[m8(GG![int](127))] = append(S(44), (A(45).(int) - i40))[2]
		}
	}
	return (v0*7+v1*5+v2*3+v3+arr[0]+arr[3]+len(ch)) % 100003, nil
}

func G(id int, args ...int) (int, error) {
	fmt.Println("G", id)
	if id == failAt {
		return 0, fail(id)
	}
	return sum(id, args), nil
}

func GB(id int, x int) (bool, error) {
	fmt.Println("GB", id)
	if id == failAt {
		return false, fail(id)
	}
	return (sum(id, nil)+x)%3 == 0, nil
}

func (p *Pt) GM(id int, a int) (int, error) {
	fmt.Println("GM", id, p.id)
	if id == failAt {
		return 0, fail(id)
	}
	return p.id + a + id, nil
}

func GG[T int | int64](id int, args ...T) (T, error) {
	fmt.Println("GG", id)
	if id == failAt {
		return 0, fail(id)
	}
	var s T
	for _, a := range args {
		s += a
	}
	return s + T(id), nil
}

func Two(id int, a int) (int, int, error) {
	fmt.Println("Two", id)
	if id == failAt {
		return 0, 0, fail(id)
	}
	return a, id, nil
}

func main() {
	for _, fa := range []int{-1, 100, 101, 102, 103, 104, 105, 106, 107, 108, 109, 110, 111, 112, 113, 114, 115, 116, 117, 118, 119, 120, 121, 122, 123, 124, 125, 126, 127} {
		failAt = fa
		res, err := run()
		fmt.Println("run", fa, res, err, errors.Is(err, ErrBad))
	}
}

