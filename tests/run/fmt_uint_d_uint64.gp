// phase: 05

// Go's %d of uint64 values with flags, width and precision.
package main

import "fmt"

func main() {
	fmt.Printf("[%d]\n", uint64(18446744073709551615))
	fmt.Printf("[%+d]\n", uint64(18446744073709551615))
	fmt.Printf("[%-d]\n", uint64(18446744073709551615))
	fmt.Printf("[% d]\n", uint64(18446744073709551615))
	fmt.Printf("[%0d]\n", uint64(18446744073709551615))
	fmt.Printf("[%#d]\n", uint64(18446744073709551615))
	fmt.Printf("[%8d]\n", uint64(18446744073709551615))
	fmt.Printf("[%-8d]\n", uint64(18446744073709551615))
	fmt.Printf("[%08d]\n", uint64(18446744073709551615))
	fmt.Printf("[%+8d]\n", uint64(18446744073709551615))
	fmt.Printf("[%+08d]\n", uint64(18446744073709551615))
	fmt.Printf("[% 8d]\n", uint64(18446744073709551615))
	fmt.Printf("[%8.3d]\n", uint64(18446744073709551615))
	fmt.Printf("[%.3d]\n", uint64(18446744073709551615))
	fmt.Printf("[%.0d]\n", uint64(18446744073709551615))
	fmt.Printf("[%#8d]\n", uint64(18446744073709551615))
	fmt.Printf("[%#08d]\n", uint64(18446744073709551615))
	fmt.Printf("[%-#8d]\n", uint64(18446744073709551615))
	fmt.Printf("[%+.5d]\n", uint64(18446744073709551615))
	fmt.Printf("[%0-8d]\n", uint64(18446744073709551615))
	fmt.Printf("[%12.8d]\n", uint64(18446744073709551615))
	fmt.Printf("[%-12.8d]\n", uint64(18446744073709551615))
	fmt.Printf("[%#.4d]\n", uint64(18446744073709551615))
	fmt.Printf("[%+#d]\n", uint64(18446744073709551615))
	fmt.Printf("[%d]\n", uint64(1)<<40)
	fmt.Printf("[%+d]\n", uint64(1)<<40)
	fmt.Printf("[%-d]\n", uint64(1)<<40)
	fmt.Printf("[% d]\n", uint64(1)<<40)
	fmt.Printf("[%0d]\n", uint64(1)<<40)
	fmt.Printf("[%#d]\n", uint64(1)<<40)
	fmt.Printf("[%8d]\n", uint64(1)<<40)
	fmt.Printf("[%-8d]\n", uint64(1)<<40)
	fmt.Printf("[%08d]\n", uint64(1)<<40)
	fmt.Printf("[%+8d]\n", uint64(1)<<40)
	fmt.Printf("[%+08d]\n", uint64(1)<<40)
	fmt.Printf("[% 8d]\n", uint64(1)<<40)
	fmt.Printf("[%8.3d]\n", uint64(1)<<40)
	fmt.Printf("[%.3d]\n", uint64(1)<<40)
	fmt.Printf("[%.0d]\n", uint64(1)<<40)
	fmt.Printf("[%#8d]\n", uint64(1)<<40)
	fmt.Printf("[%#08d]\n", uint64(1)<<40)
	fmt.Printf("[%-#8d]\n", uint64(1)<<40)
	fmt.Printf("[%+.5d]\n", uint64(1)<<40)
	fmt.Printf("[%0-8d]\n", uint64(1)<<40)
	fmt.Printf("[%12.8d]\n", uint64(1)<<40)
	fmt.Printf("[%-12.8d]\n", uint64(1)<<40)
	fmt.Printf("[%#.4d]\n", uint64(1)<<40)
	fmt.Printf("[%+#d]\n", uint64(1)<<40)
}

