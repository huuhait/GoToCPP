// phase: 08

// Unix, UnixMilli, UnixMicro, UnixNano and the constructors: round trips, negative times, extremes.
package main

import (
	"fmt"
	"time"
)

func main() {
	secs := []int64{0, 1, -1, 86399, 86400, -86400, 1136239445, 1700000000, -1700000000, 253402300799, 253402300800,
		-62135596800, -62135596801, 4102444800, 951782400, 1 << 40, -(1 << 40)}
	for _, s := range secs {
		t := time.Unix(s, 0).UTC()
		fmt.Println(s, t.Format(time.RFC3339), t.Unix(), t.UnixMilli(), t.UnixMicro(), t.Unix() == s)
	}
	for _, ns := range []int64{0, 1, -1, 999999999, 1000000000, 1000000001, -999999999, -1000000000, -1000000001, 1700000000123456789,
		-1700000000123456789, 9223372036854775807, -9223372036854775808} {
		t := time.Unix(0, ns).UTC()
		fmt.Println(ns, t.Format("2006-01-02T15:04:05.999999999Z07:00"), t.UnixNano(), t.UnixNano() == ns)
	}
	for _, ms := range []int64{0, 1, -1, 999, 1000, -1000, 1700000000123, -1700000000123} {
		t := time.UnixMilli(ms).UTC()
		fmt.Println(ms, t.Format("2006-01-02T15:04:05.000Z"), t.UnixMilli() == ms)
	}
	for _, us := range []int64{0, 1, -1, 999999, 1000000, 1700000000123456, -1700000000123456} {
		t := time.UnixMicro(us).UTC()
		fmt.Println(us, t.Format("2006-01-02T15:04:05.000000Z"), t.UnixMicro() == us)
	}
	// nsec out of range is normalized
	fmt.Println(time.Unix(10, 2500000000).UTC().Format("05.000000000"), time.Unix(10, -1).UTC().Format("05.000000000"))
	fmt.Println(time.Unix(0, 0).UTC(), time.Unix(0, 0).UTC().IsZero())
	var z time.Time
	fmt.Println(z.Unix(), z.UnixNano() != 0, z.UnixMilli(), z.IsZero())
	// the Unix epoch in Date form
	fmt.Println(time.Date(1970, 1, 1, 0, 0, 0, 0, time.UTC).Unix(), time.Date(2001, 9, 9, 1, 46, 40, 0, time.UTC).Unix())
}

