// phase: 09
// math.Pow10 for n in [-500, 500], bit-identical to Go.

package main

import (
	"fmt"
	"math"
)

func main() {
	h := uint64(14695981039346656037)
	for n := -500; n <= 500; n++ {
		b := math.Float64bits(math.Pow10(n))
		h = (h ^ b) * 1099511628211
		if n%25 == 0 {
			fmt.Printf("%d %016x\n", n, b)
		}
	}
	fmt.Printf("hash=%016x\n", h)
}

