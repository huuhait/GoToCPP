// its twin in testdata/must_twin/ is the same program in plain Go.
package main

import (
	"errors"
	"fmt"
)

var ErrBad = errors.New("bad")

func f1(n int) (int, error) {
	fmt.Println("f1", n)
	if n%5 == 3 {
		return 0, fmt.Errorf("f1(%d): %w", n, ErrBad)
	}
	return n*2 + 1, nil
}

func f2(n int) (int, int, error) {
	fmt.Println("f2", n)
	if n%6 == 2 {
		return 0, 0, fmt.Errorf("f2(%d): %w", n, ErrBad)
	}
	return n + 1, n - 1, nil
}

func f3(n int) error {
	fmt.Println("f3", n)
	if n%7 == 4 {
		return fmt.Errorf("f3(%d): %w", n, ErrBad)
	}
	return nil
}

func b1(n int) (bool, error) {
	fmt.Println("b1", n)
	if n%8 == 5 {
		return false, fmt.Errorf("b1(%d): %w", n, ErrBad)
	}
	return n%2 == 0, nil
}

func run!(seed int) int {
	v0, v1, v2, v3 := seed, seed*3+1, seed%4, 7-seed
	for i1 := 0; i1 < 2 && (b1(6) || ((6 + v1) < f1(v2) && b1(v0))); i1++ {
		if (b1(5) && (1 < f1(v0) || f1(v2) < f1(v2))) {
			f3(v0)
			for i2 := 0; i2 < 3 && (b1(v2) || (b1((8 + v3)) || f1(0) < (v1 + 0))); i2++ {
				f3((v1 - v1))
				v3 = ((3 - v3) - f1(5))
			}
			v1, v0 = f2(f1(v2))
		} else if b1(f1(1)) {
			if v3 < 4 {
				break
			}
		} else if ((b1(f1(v1)) || b1(f1(v2))) && b1(9)) {
			v3 = 3
		}
		v1 = f1(f1(v2))
		for i3 := 0; i3 < 1 && ((b1(v1) || b1(f1(7))) && b1(v1)); i3++ {
			for i4 := 0; i4 < 3; i4++ {
				v1 += v2
			}
			v3 = f1(v2)
			if (7 + 3) < 7 {
				continue
			}
		}
	}
	v0 = ((4 - v3) - (v0 + v3))
	v2, v3 = f2(f1(4))
	return (v0*1000 + v1*100 + v2*10 + v3) % 100000
}

func main() {
	for seed := 0; seed < 10; seed++ {
		v, err := run(seed)
		fmt.Println("run", seed, v, err, errors.Is(err, ErrBad))
	}
}

