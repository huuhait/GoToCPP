// phase: 05

// Go's %O of int64 values with every flag, width and precision: the integer formatting of
// fmt/format.go.
package main

import "fmt"

func main() {
	fmt.Printf("[%O]\n", int64(9223372036854775807))
	fmt.Printf("[%+O]\n", int64(9223372036854775807))
	fmt.Printf("[%-O]\n", int64(9223372036854775807))
	fmt.Printf("[% O]\n", int64(9223372036854775807))
	fmt.Printf("[%0O]\n", int64(9223372036854775807))
	fmt.Printf("[%#O]\n", int64(9223372036854775807))
	fmt.Printf("[%8O]\n", int64(9223372036854775807))
	fmt.Printf("[%-8O]\n", int64(9223372036854775807))
	fmt.Printf("[%08O]\n", int64(9223372036854775807))
	fmt.Printf("[%+8O]\n", int64(9223372036854775807))
	fmt.Printf("[%+08O]\n", int64(9223372036854775807))
	fmt.Printf("[% 8O]\n", int64(9223372036854775807))
	fmt.Printf("[%8.3O]\n", int64(9223372036854775807))
	fmt.Printf("[%.3O]\n", int64(9223372036854775807))
	fmt.Printf("[%.0O]\n", int64(9223372036854775807))
	fmt.Printf("[%#8O]\n", int64(9223372036854775807))
	fmt.Printf("[%#08O]\n", int64(9223372036854775807))
	fmt.Printf("[%-#8O]\n", int64(9223372036854775807))
	fmt.Printf("[%+.5O]\n", int64(9223372036854775807))
	fmt.Printf("[%0-8O]\n", int64(9223372036854775807))
	fmt.Printf("[%12.8O]\n", int64(9223372036854775807))
	fmt.Printf("[%-12.8O]\n", int64(9223372036854775807))
	fmt.Printf("[%#.4O]\n", int64(9223372036854775807))
	fmt.Printf("[%+#O]\n", int64(9223372036854775807))
	fmt.Printf("[%O]\n", int64(-9223372036854775808))
	fmt.Printf("[%+O]\n", int64(-9223372036854775808))
	fmt.Printf("[%-O]\n", int64(-9223372036854775808))
	fmt.Printf("[% O]\n", int64(-9223372036854775808))
	fmt.Printf("[%0O]\n", int64(-9223372036854775808))
	fmt.Printf("[%#O]\n", int64(-9223372036854775808))
	fmt.Printf("[%8O]\n", int64(-9223372036854775808))
	fmt.Printf("[%-8O]\n", int64(-9223372036854775808))
	fmt.Printf("[%08O]\n", int64(-9223372036854775808))
	fmt.Printf("[%+8O]\n", int64(-9223372036854775808))
	fmt.Printf("[%+08O]\n", int64(-9223372036854775808))
	fmt.Printf("[% 8O]\n", int64(-9223372036854775808))
	fmt.Printf("[%8.3O]\n", int64(-9223372036854775808))
	fmt.Printf("[%.3O]\n", int64(-9223372036854775808))
	fmt.Printf("[%.0O]\n", int64(-9223372036854775808))
	fmt.Printf("[%#8O]\n", int64(-9223372036854775808))
	fmt.Printf("[%#08O]\n", int64(-9223372036854775808))
	fmt.Printf("[%-#8O]\n", int64(-9223372036854775808))
	fmt.Printf("[%+.5O]\n", int64(-9223372036854775808))
	fmt.Printf("[%0-8O]\n", int64(-9223372036854775808))
	fmt.Printf("[%12.8O]\n", int64(-9223372036854775808))
	fmt.Printf("[%-12.8O]\n", int64(-9223372036854775808))
	fmt.Printf("[%#.4O]\n", int64(-9223372036854775808))
	fmt.Printf("[%+#O]\n", int64(-9223372036854775808))
	fmt.Printf("[%O]\n", int64(1) << 40)
	fmt.Printf("[%+O]\n", int64(1) << 40)
	fmt.Printf("[%-O]\n", int64(1) << 40)
	fmt.Printf("[% O]\n", int64(1) << 40)
	fmt.Printf("[%0O]\n", int64(1) << 40)
	fmt.Printf("[%#O]\n", int64(1) << 40)
	fmt.Printf("[%8O]\n", int64(1) << 40)
	fmt.Printf("[%-8O]\n", int64(1) << 40)
	fmt.Printf("[%08O]\n", int64(1) << 40)
	fmt.Printf("[%+8O]\n", int64(1) << 40)
	fmt.Printf("[%+08O]\n", int64(1) << 40)
	fmt.Printf("[% 8O]\n", int64(1) << 40)
	fmt.Printf("[%8.3O]\n", int64(1) << 40)
	fmt.Printf("[%.3O]\n", int64(1) << 40)
	fmt.Printf("[%.0O]\n", int64(1) << 40)
	fmt.Printf("[%#8O]\n", int64(1) << 40)
	fmt.Printf("[%#08O]\n", int64(1) << 40)
	fmt.Printf("[%-#8O]\n", int64(1) << 40)
	fmt.Printf("[%+.5O]\n", int64(1) << 40)
	fmt.Printf("[%0-8O]\n", int64(1) << 40)
	fmt.Printf("[%12.8O]\n", int64(1) << 40)
	fmt.Printf("[%-12.8O]\n", int64(1) << 40)
	fmt.Printf("[%#.4O]\n", int64(1) << 40)
	fmt.Printf("[%+#O]\n", int64(1) << 40)
}

