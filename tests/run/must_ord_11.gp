	}
	for i58 := b1(int(int64(v3))); i58 < 3 && (v3 == (*PI(59) + v1)); i58 += 1 + b1((*PI(60) + G!(125, 9, v0, v1))) {
		arr[m8((<-CH(61) + (map[int]int{m8(FN(62)[m8(L(63))](v2)): (A(64).(int) - i58), m8(L(65, v0, v0)) + 8: GEN[int](v1)}[3])))] += L(66)
		switch GEN[int]((map[int]int{m8(v3): i58, m8(v1) + 8: v0}[3])) {
