func sweep[C Complex](name string) {
	h := newHasher(name)
	vs := make([]C, len(raw))
	for i, r := range raw {
		vs[i] = C(r)
	}
	for _, a := range vs {
		c128(h, -a)
		c128(h, +a)
		c128(h, a*a)
		c128(h, a+1)
		c128(h, a-1i)
		c128(h, a*2)
		c128(h, 1/a)
