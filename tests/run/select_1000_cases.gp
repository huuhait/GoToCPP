// phase: 08

// A select with 1000 cases (generated: for i in 0..999, `case v := <-cs[i]: got, val = i, v`; the file
// is the same text twice, in main and in a goroutine). The first is ready on one channel, the second
// blocks with 1000 entries on 1000 channels and is woken by one send; the others are untouched.
package main

import "fmt"

func main() {
	cs := make([]chan int, 1000)
	for i := range cs {
		cs[i] = make(chan int, 1)
	}
	for _, target := range []int{0, 411, 999} {
		cs[target] <- target * 2
		got, val := -1, -1
