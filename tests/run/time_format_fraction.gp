// phase: 08

// Fractional seconds in layouts: .000 (fixed digits), .999 (trailing zeros dropped), the comma, and truncation (not rounding).
package main

import (
	"fmt"
	"time"
)

func main() {
	nanos := []int{0, 1, 10, 100, 1000, 1500, 100000, 120000, 123000, 123456, 123456789, 999999999, 500000000, 5, 50, 999000000, 990000000, 900000000}
	layouts := []string{
		"05.0", "05.00", "05.000", "05.0000", "05.000000", "05.000000000", "05.9", "05.99", "05.999", "05.999999", "05.999999999",
		"05,0", "05,000", "05,999", "05,999999999", "15:04:05.000Z07:00", "15:04:05.999Z07:00", "05.0 and 05.9", ".000", ".999",
		"05.000000000000", "05.9999999999999",
	}
	for _, ns := range nanos {
		t := time.Date(2024, 1, 2, 3, 4, 7, ns, time.UTC)
		fmt.Printf("%9d", ns)
		for _, l := range layouts {
			fmt.Printf(" %s", t.Format(l))
		}
		fmt.Println()
	}
	t := time.Date(2024, 1, 2, 3, 4, 7, 999999999, time.UTC)
	fmt.Println(t.Format("05.0"), t.Format("05.00"), t.Format("05.999999"))
	// Parse accepts a fraction the layout does not mention
	for _, in := range []string{"2024-01-02T03:04:05Z", "2024-01-02T03:04:05.1Z", "2024-01-02T03:04:05.123456789Z", "2024-01-02T03:04:05,5Z",
		"2024-01-02T03:04:05.9999999999Z", "2024-01-02T03:04:05.Z"} {
		p, err := time.Parse(time.RFC3339, in)
		fmt.Println(p.Nanosecond(), err)
	}
	// and a layout with a fraction needs one with that many digits
	for _, in := range []string{"05.123", "05.12", "05.1234", "05,123", "05"} {
		p, err := time.Parse("05.000", in)
		fmt.Println(p.Nanosecond(), err)
	}
	for _, in := range []string{"05.123", "05.12", "05.1234", "05,123", "05", "05.1234567890"} {
		p, err := time.Parse("05.999", in)
		fmt.Println(p.Nanosecond(), err)
	}
}

