// phase: 05

// Go's %d of int64 values with every flag, width and precision: the integer formatting of
// fmt/format.go.
package main

import "fmt"

func main() {
	fmt.Printf("[%d]\n", int64(9223372036854775807))
	fmt.Printf("[%+d]\n", int64(9223372036854775807))
	fmt.Printf("[%-d]\n", int64(9223372036854775807))
	fmt.Printf("[% d]\n", int64(9223372036854775807))
	fmt.Printf("[%0d]\n", int64(9223372036854775807))
	fmt.Printf("[%#d]\n", int64(9223372036854775807))
	fmt.Printf("[%8d]\n", int64(9223372036854775807))
	fmt.Printf("[%-8d]\n", int64(9223372036854775807))
	fmt.Printf("[%08d]\n", int64(9223372036854775807))
	fmt.Printf("[%+8d]\n", int64(9223372036854775807))
	fmt.Printf("[%+08d]\n", int64(9223372036854775807))
	fmt.Printf("[% 8d]\n", int64(9223372036854775807))
	fmt.Printf("[%8.3d]\n", int64(9223372036854775807))
	fmt.Printf("[%.3d]\n", int64(9223372036854775807))
	fmt.Printf("[%.0d]\n", int64(9223372036854775807))
	fmt.Printf("[%#8d]\n", int64(9223372036854775807))
	fmt.Printf("[%#08d]\n", int64(9223372036854775807))
	fmt.Printf("[%-#8d]\n", int64(9223372036854775807))
	fmt.Printf("[%+.5d]\n", int64(9223372036854775807))
	fmt.Printf("[%0-8d]\n", int64(9223372036854775807))
	fmt.Printf("[%12.8d]\n", int64(9223372036854775807))
	fmt.Printf("[%-12.8d]\n", int64(9223372036854775807))
	fmt.Printf("[%#.4d]\n", int64(9223372036854775807))
	fmt.Printf("[%+#d]\n", int64(9223372036854775807))
	fmt.Printf("[%d]\n", int64(-9223372036854775808))
	fmt.Printf("[%+d]\n", int64(-9223372036854775808))
	fmt.Printf("[%-d]\n", int64(-9223372036854775808))
	fmt.Printf("[% d]\n", int64(-9223372036854775808))
	fmt.Printf("[%0d]\n", int64(-9223372036854775808))
	fmt.Printf("[%#d]\n", int64(-9223372036854775808))
	fmt.Printf("[%8d]\n", int64(-9223372036854775808))
	fmt.Printf("[%-8d]\n", int64(-9223372036854775808))
	fmt.Printf("[%08d]\n", int64(-9223372036854775808))
	fmt.Printf("[%+8d]\n", int64(-9223372036854775808))
	fmt.Printf("[%+08d]\n", int64(-9223372036854775808))
	fmt.Printf("[% 8d]\n", int64(-9223372036854775808))
	fmt.Printf("[%8.3d]\n", int64(-9223372036854775808))
	fmt.Printf("[%.3d]\n", int64(-9223372036854775808))
	fmt.Printf("[%.0d]\n", int64(-9223372036854775808))
	fmt.Printf("[%#8d]\n", int64(-9223372036854775808))
	fmt.Printf("[%#08d]\n", int64(-9223372036854775808))
	fmt.Printf("[%-#8d]\n", int64(-9223372036854775808))
	fmt.Printf("[%+.5d]\n", int64(-9223372036854775808))
	fmt.Printf("[%0-8d]\n", int64(-9223372036854775808))
	fmt.Printf("[%12.8d]\n", int64(-9223372036854775808))
	fmt.Printf("[%-12.8d]\n", int64(-9223372036854775808))
	fmt.Printf("[%#.4d]\n", int64(-9223372036854775808))
	fmt.Printf("[%+#d]\n", int64(-9223372036854775808))
	fmt.Printf("[%d]\n", int64(1) << 40)
	fmt.Printf("[%+d]\n", int64(1) << 40)
	fmt.Printf("[%-d]\n", int64(1) << 40)
	fmt.Printf("[% d]\n", int64(1) << 40)
	fmt.Printf("[%0d]\n", int64(1) << 40)
	fmt.Printf("[%#d]\n", int64(1) << 40)
	fmt.Printf("[%8d]\n", int64(1) << 40)
	fmt.Printf("[%-8d]\n", int64(1) << 40)
	fmt.Printf("[%08d]\n", int64(1) << 40)
	fmt.Printf("[%+8d]\n", int64(1) << 40)
	fmt.Printf("[%+08d]\n", int64(1) << 40)
	fmt.Printf("[% 8d]\n", int64(1) << 40)
	fmt.Printf("[%8.3d]\n", int64(1) << 40)
	fmt.Printf("[%.3d]\n", int64(1) << 40)
	fmt.Printf("[%.0d]\n", int64(1) << 40)
	fmt.Printf("[%#8d]\n", int64(1) << 40)
	fmt.Printf("[%#08d]\n", int64(1) << 40)
	fmt.Printf("[%-#8d]\n", int64(1) << 40)
	fmt.Printf("[%+.5d]\n", int64(1) << 40)
	fmt.Printf("[%0-8d]\n", int64(1) << 40)
	fmt.Printf("[%12.8d]\n", int64(1) << 40)
	fmt.Printf("[%-12.8d]\n", int64(1) << 40)
	fmt.Printf("[%#.4d]\n", int64(1) << 40)
	fmt.Printf("[%+#d]\n", int64(1) << 40)
}

