// phase: 09
// Special values through Exp, Exp2, Expm1, Log, Log2, Log10, Log1p, Logb.

package main

import (
	"fmt"
	"math"
)

func main() {
	vals := []float64{0, math.Copysign(0, -1), 1, -1, 0.5, -0.5, 2, -2, 10, -10, math.Pi, math.Pi / 2, -math.Pi / 2, 1e-300, 5e-324, 1e300, math.MaxFloat64, math.Inf(1), math.Inf(-1), math.NaN(), 709.7, 710, -745.2, -746, 171.5, 172, 0.9999999999999999, 1.0000000000000002}
	fmt.Println("Exp")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Exp(x), math.Float64bits(math.Exp(x)))
	}
	fmt.Println("Exp2")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Exp2(x), math.Float64bits(math.Exp2(x)))
	}
	fmt.Println("Expm1")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Expm1(x), math.Float64bits(math.Expm1(x)))
	}
	fmt.Println("Log")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Log(x), math.Float64bits(math.Log(x)))
	}
	fmt.Println("Log2")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Log2(x), math.Float64bits(math.Log2(x)))
	}
	fmt.Println("Log10")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Log10(x), math.Float64bits(math.Log10(x)))
	}
	fmt.Println("Log1p")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Log1p(x), math.Float64bits(math.Log1p(x)))
	}
	fmt.Println("Logb")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Logb(x), math.Float64bits(math.Logb(x)))
	}
}

