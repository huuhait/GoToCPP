// phase: 08

// Duration.Round and Duration.Truncate: half away from zero, saturation, d <= 0.
package main

import (
	"fmt"
	"time"
)

const (
	maxInt64 = 1<<63 - 1
	minInt64 = -1 << 63
)

func main() {
	ds := []time.Duration{0, 1, 499, 500, 501, 1499, 1500, 1501, -499, -500, -501, -1500, 1234567890,
		-1234567890, 5*time.Hour + 29*time.Minute, 5*time.Hour + 30*time.Minute, -5*time.Hour - 30*time.Minute,
		maxInt64, minInt64}
	ms := []time.Duration{time.Nanosecond, 10, 1000, time.Millisecond, time.Second, time.Minute, time.Hour, 0, -1, -time.Hour, 7}
	for _, d := range ds {
		for _, m := range ms {
			fmt.Printf("%d %d: %d %d\n", int64(d), int64(m), int64(d.Round(m)), int64(d.Truncate(m)))
		}
	}
	d := 1*time.Hour + 23*time.Minute + 45*time.Second + 678*time.Millisecond
	fmt.Println(d.Round(time.Second), d.Round(time.Minute), d.Round(time.Hour), d.Truncate(time.Second), d.Truncate(time.Minute), d.Truncate(time.Hour))
}

