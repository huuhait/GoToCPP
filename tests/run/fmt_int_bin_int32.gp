// phase: 05

// Go's %b of int32 values with every flag, width and precision: the integer formatting of
// fmt/format.go.
package main

import "fmt"

func main() {
	fmt.Printf("[%b]\n", int32(2147483647))
	fmt.Printf("[%+b]\n", int32(2147483647))
	fmt.Printf("[%-b]\n", int32(2147483647))
	fmt.Printf("[% b]\n", int32(2147483647))
	fmt.Printf("[%0b]\n", int32(2147483647))
	fmt.Printf("[%#b]\n", int32(2147483647))
	fmt.Printf("[%8b]\n", int32(2147483647))
	fmt.Printf("[%-8b]\n", int32(2147483647))
	fmt.Printf("[%08b]\n", int32(2147483647))
	fmt.Printf("[%+8b]\n", int32(2147483647))
	fmt.Printf("[%+08b]\n", int32(2147483647))
	fmt.Printf("[% 8b]\n", int32(2147483647))
	fmt.Printf("[%8.3b]\n", int32(2147483647))
	fmt.Printf("[%.3b]\n", int32(2147483647))
	fmt.Printf("[%.0b]\n", int32(2147483647))
	fmt.Printf("[%#8b]\n", int32(2147483647))
	fmt.Printf("[%#08b]\n", int32(2147483647))
	fmt.Printf("[%-#8b]\n", int32(2147483647))
	fmt.Printf("[%+.5b]\n", int32(2147483647))
	fmt.Printf("[%0-8b]\n", int32(2147483647))
	fmt.Printf("[%12.8b]\n", int32(2147483647))
	fmt.Printf("[%-12.8b]\n", int32(2147483647))
	fmt.Printf("[%#.4b]\n", int32(2147483647))
	fmt.Printf("[%+#b]\n", int32(2147483647))
	fmt.Printf("[%b]\n", int32(-2147483648))
	fmt.Printf("[%+b]\n", int32(-2147483648))
	fmt.Printf("[%-b]\n", int32(-2147483648))
	fmt.Printf("[% b]\n", int32(-2147483648))
	fmt.Printf("[%0b]\n", int32(-2147483648))
	fmt.Printf("[%#b]\n", int32(-2147483648))
	fmt.Printf("[%8b]\n", int32(-2147483648))
	fmt.Printf("[%-8b]\n", int32(-2147483648))
	fmt.Printf("[%08b]\n", int32(-2147483648))
	fmt.Printf("[%+8b]\n", int32(-2147483648))
	fmt.Printf("[%+08b]\n", int32(-2147483648))
	fmt.Printf("[% 8b]\n", int32(-2147483648))
	fmt.Printf("[%8.3b]\n", int32(-2147483648))
	fmt.Printf("[%.3b]\n", int32(-2147483648))
	fmt.Printf("[%.0b]\n", int32(-2147483648))
	fmt.Printf("[%#8b]\n", int32(-2147483648))
	fmt.Printf("[%#08b]\n", int32(-2147483648))
	fmt.Printf("[%-#8b]\n", int32(-2147483648))
	fmt.Printf("[%+.5b]\n", int32(-2147483648))
	fmt.Printf("[%0-8b]\n", int32(-2147483648))
	fmt.Printf("[%12.8b]\n", int32(-2147483648))
	fmt.Printf("[%-12.8b]\n", int32(-2147483648))
	fmt.Printf("[%#.4b]\n", int32(-2147483648))
	fmt.Printf("[%+#b]\n", int32(-2147483648))
	fmt.Printf("[%b]\n", int32(65))
	fmt.Printf("[%+b]\n", int32(65))
	fmt.Printf("[%-b]\n", int32(65))
	fmt.Printf("[% b]\n", int32(65))
	fmt.Printf("[%0b]\n", int32(65))
	fmt.Printf("[%#b]\n", int32(65))
	fmt.Printf("[%8b]\n", int32(65))
	fmt.Printf("[%-8b]\n", int32(65))
	fmt.Printf("[%08b]\n", int32(65))
	fmt.Printf("[%+8b]\n", int32(65))
	fmt.Printf("[%+08b]\n", int32(65))
	fmt.Printf("[% 8b]\n", int32(65))
	fmt.Printf("[%8.3b]\n", int32(65))
	fmt.Printf("[%.3b]\n", int32(65))
	fmt.Printf("[%.0b]\n", int32(65))
	fmt.Printf("[%#8b]\n", int32(65))
	fmt.Printf("[%#08b]\n", int32(65))
	fmt.Printf("[%-#8b]\n", int32(65))
	fmt.Printf("[%+.5b]\n", int32(65))
	fmt.Printf("[%0-8b]\n", int32(65))
	fmt.Printf("[%12.8b]\n", int32(65))
	fmt.Printf("[%-12.8b]\n", int32(65))
	fmt.Printf("[%#.4b]\n", int32(65))
	fmt.Printf("[%+#b]\n", int32(65))
}

