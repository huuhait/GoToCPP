//  1 "EST" -18000 EST: [EST] [-0500] [-05:00] [-05] [-050000] [-05:00:00] [-0500] [-05:00] [-05] [-050000] [-05:00:00] [2024-07-04T07:30:45-05:00] [Thu, 04 Jul 2024 07:30:45 EST] [07:30 -0500 EST]
