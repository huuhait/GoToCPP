// phase: 08

// Zone elements in layouts (MST, -0700, Z07:00 and the others) for UTC, positive, negative, fractional-hour and unnamed zones.
package main

import (
	"fmt"
	"time"
)

func main() {
	zones := []*time.Location{
		time.UTC,
		time.FixedZone("EST", -5*3600),
		time.FixedZone("EDT", -4*3600),
		time.FixedZone("IST", 5*3600+30*60),
		time.FixedZone("NPT", 5*3600+45*60),
		time.FixedZone("", 0),
		time.FixedZone("", 3600),
		time.FixedZone("", -3600),
		time.FixedZone("", -(3*3600 + 30*60)),
		time.FixedZone("JST", 9*3600),
		time.FixedZone("LONGNAME", 14*3600),
		time.FixedZone("X", -12*3600),
		time.FixedZone("S", 3600+60+1),
		time.FixedZone("N", -(3600 + 60 + 1)),
		time.FixedZone("GMT+3", 3*3600),
		time.FixedZone("-03", -3*3600),
	}
	layouts := []string{"MST", "-0700", "-07:00", "-07", "-070000", "-07:00:00", "Z0700", "Z07:00", "Z07", "Z070000", "Z07:00:00",
		"2006-01-02T15:04:05Z07:00", "Mon, 02 Jan 2006 15:04:05 MST", "15:04 -0700 MST"}
	t := time.Date(2024, 7, 4, 12, 30, 45, 0, time.UTC)
	for i, z := range zones {
		zt := t.In(z)
		name, off := zt.Zone()
		fmt.Printf("%2d %q %d %s:", i, name, off, zt.Location())
		for _, l := range layouts {
			fmt.Printf(" [%s]", zt.Format(l))
		}
		fmt.Println()
	}
	// the zone is part of the String and of the %v output
	for _, z := range zones[:6] {
		fmt.Println(t.In(z))
	}
	// a time that crosses a date line
	d := time.Date(2024, 1, 1, 0, 0, 0, 0, time.FixedZone("A", -12*3600))
	fmt.Println(d.UTC().Format(time.RFC3339), d.In(time.FixedZone("B", 14*3600)).Format(time.RFC3339))
	// FixedZone with the same hour offset and no name is shared
	fmt.Println(time.FixedZone("", 3600) == time.FixedZone("", 3600), time.FixedZone("a", 3600) == time.FixedZone("a", 3600))
	// the time zone name has been "" and Format prints the offset in its place
	fmt.Println(t.In(time.FixedZone("", 5400)).Format("MST|Z07:00"))
}

