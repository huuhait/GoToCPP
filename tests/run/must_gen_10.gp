package main

import (
	"errors"
	"fmt"
)

var ErrBad = errors.New("bad")

func f1(n int) (int, error) {
	fmt.Println("f1", n)
	if n%5 == 3 {
		return 0, fmt.Errorf("f1(%d): %w", n, ErrBad)
	}
	return n*2 + 1, nil
}

func f2(n int) (int, int, error) {
	fmt.Println("f2", n)
	if n%6 == 2 {
		return 0, 0, fmt.Errorf("f2(%d): %w", n, ErrBad)
	}
	return n + 1, n - 1, nil
}

func f3(n int) error {
	fmt.Println("f3", n)
	if n%7 == 4 {
		return fmt.Errorf("f3(%d): %w", n, ErrBad)
	}
	return nil
}

func b1(n int) (bool, error) {
	fmt.Println("b1", n)
	if n%8 == 5 {
		return false, fmt.Errorf("b1(%d): %w", n, ErrBad)
	}
	return n%2 == 0, nil
}

func run!(seed int) int {
	v0, v1, v2, v3 := seed, seed*3+1, seed%4, 7-seed
	if (v3 + v0) < (v1 - v2) {
		v2, v3 = f2((v3 + v2))
	} else {
		for i1 := 0; i1 < 2; i1++ {
			if 1 < (v1 + 7) {
				if f1(9) < 5 {
					continue
				}
				if (v1 - v0) < 7 {
					break
				}
				v0 = ((v0 + 8) + f1(v0))
			} else if b1(f1(9)) {
				if (3 + v2) < 5 {
					continue
				}
			} else {
				if f1(v2) < 3 {
					continue
				}
			}
		}
		switch {
		case b1(f1(v2)):
			v1 = 0
		case (b1(2) && b1(8)):
			switch {
			case b1((v0 + v3)):
				v1 = f1(v2)
			case b1((v1 - 7)):
				v2 += f1((v2 + v3))
				f3((v2 - v3))
				f3(f1(v0))
			}
			v1 = v3
			switch {
			case (v0 < f1(v3) && b1(5)):
				v3 = f1(f1(v3))
			case ((b1((9 - v3)) && b1(f1(v2))) && (b1(f1(v1)) || 9 < (v0 - v0))):
				v2 = f1(2)
				v2 = ((v0 + v0) + f1(1))
				v0 = f1(5)
			}
		}
		if b1((v0 - 1)) {
			v0 += (f1(v2) - (v1 + v2))
			if b1(f1(v1)) {
				v1 = f1(v0)
				v1 = ((v2 + 4) + f1(v3))
			} else if b1(v3) {
				v0 = f1(v3)
				v1 = v3
			} else if b1(f1(v2)) {
				f3(v3)
			} else {
				v0, v3 = f2((v3 + v1))
			}
			v2 += v3
		}
	}
	v1 = 4
	for i2 := 0; i2 < 2; i2++ {
		if f1(v2) < 6 {
			continue
		}
		if f1(v1) < 5 {
			break
		}
	}
	return (v0*1000 + v1*100 + v2*10 + v3) % 100000
}

func main() {
	for seed := 0; seed < 10; seed++ {
		v, err := run(seed)
		fmt.Println("run", seed, v, err, errors.Is(err, ErrBad))
	}
}

