type MyI8 int8
type MyU16 uint16
type MyI64 int64
type MyU32 uint32

var raw = []float64{0, math.Copysign(0, -1), 1, -1, 0.1, -0.1, 0.5, 1.5, 2.5, 3, 10, 100, 1e10, -1e10, 1e38, 3.4e38, 1e39, 1e300, 1.7976931348623157e308, -1.7976931348623157e308, 1e-5, 1e-38, 1e-45, 1e-46, 1e-300, 5e-324, 2.2250738585072014e-308, 16777216, 16777217, 9007199254740992, 9007199254740993, math.Inf(1), math.Inf(-1), math.NaN(), math.Pi, math.E, 0.3, 0.7, 3.8864153651100737e+27, 1.4628446796208877e-11, -5.3019634918484994e+20, 3.5110272660308123e-38, -6.219086936064684e-05, -3915.04701970166, -7.890321131831835e+17, 2.11233300429883e-08, 6.575711908663667e-20, 4.4759348697167925e-11, -5.574345175222587e-17, -1.9649047336102516e-34}

type MyF32 float32
type MyF64 float64

func values[F Float]() []F {
	out := make([]F, len(raw))
	for i, r := range raw {
		out[i] = F(r)
	}
	return out
}

func bits[F Float](h *hasher, is32 bool, f F) {
	if is32 {
		h.f32(float32(f))
	} else {
		h.f64(float64(f))
	}
}

func sweep[F Float](name string, is32 bool) {
	h := newHasher(name)
	vs := values[F]()
	for _, a := range vs {
		bits(h, is32, -a)
		bits(h, is32, +a)
		bits(h, is32, a*a)
		bits(h, is32, a/3)
		bits(h, is32, a+1)
		bits(h, is32, a-1)
		bits(h, is32, F(float32(a)))
		bits(h, is32, F(float64(a)))
		bits(h, is32, a*0.1+0.7)
		x := a
		x += a
		x *= 0.3
		x -= 7
		x /= 1.5
		bits(h, is32, x)
		bits(h, is32, F(1)/a)
		for _, c := range vs {
			bits(h, is32, a+c)
			bits(h, is32, a-c)
			bits(h, is32, a*c)
			bits(h, is32, a/c)
			h.bool(a < c)
			h.bool(a <= c)
			h.bool(a == c)
			h.bool(a != c)
			h.bool(a > c)
			h.bool(a >= c)
			bits(h, is32, max(a, c))
			bits(h, is32, min(a, c))
			bits(h, is32, a*c+a)
			bits(h, is32, (a+c)*(a-c))
		}
		h.str(fmt.Sprint(a))
		h.str(fmt.Sprintf("%v %g %e %.3f %8.2f %+g", a, a, a, a, a, a))
	}
	h.done()
}

func main() {
	sweep[float32]("float32", true)
	sweep[float64]("float64", false)
	sweep[MyF32]("MyF32", true)
	sweep[MyF64]("MyF64", false)
}

