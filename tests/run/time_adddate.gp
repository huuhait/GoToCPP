// phase: 08

// Time.AddDate and Time.Add over month ends, leap years and day overflow.
package main

import (
	"fmt"
	"time"
)

const layout = "2006-01-02 15:04:05 Mon"

func main() {
	d := func(y int, m time.Month, day int) time.Time {
		return time.Date(y, m, day, 10, 30, 0, 0, time.UTC)
	}
	for _, c := range []struct {
		t       time.Time
		y, m, d int
	}{
		{d(2024, 1, 31), 0, 1, 0},
		{d(2023, 1, 31), 0, 1, 0},
		{d(2024, 3, 31), 0, -1, 0},
		{d(2024, 2, 29), 1, 0, 0},
		{d(2024, 2, 29), 4, 0, 0},
		{d(2024, 2, 29), -4, 0, 0},
		{d(2024, 2, 29), 0, 12, 0},
		{d(2024, 12, 31), 0, 2, 0},
		{d(2024, 12, 31), 0, 0, 1},
		{d(2024, 12, 31), 0, 0, -366},
		{d(2024, 1, 1), 0, 0, 366},
		{d(2024, 1, 1), 0, 0, 365},
		{d(2023, 1, 1), 0, 0, 365},
		{d(2024, 10, 31), 0, 4, 0},
		{d(2024, 5, 31), 0, -3, 0},
		{d(2024, 5, 31), 0, 13, 0},
		{d(2024, 5, 31), 0, -25, 0},
		{d(2024, 1, 15), 1, 1, 1},
		{d(2024, 1, 15), -1, -1, -1},
		{d(2024, 1, 1), 0, 0, -1},
		{d(2024, 3, 1), 0, 0, -1},
		{d(2023, 3, 1), 0, 0, -1},
		{d(2000, 2, 29), 100, 0, 0},
		{d(2000, 2, 29), 400, 0, 0},
		{d(1999, 12, 31), 0, 0, 1},
		{d(2024, 6, 30), 0, 8, 0},
		{d(2024, 1, 31), 0, 0, 29},
		{d(2024, 1, 31), 0, 0, 30},
		{d(2024, 2, 1), 0, 1, -1},
		{d(2024, 1, 1), 10, 10, 10},
		{d(2024, 1, 1), -2024, 0, 0},
		{d(2024, 1, 1), 0, 0, 0},
	} {
		r := c.t.AddDate(c.y, c.m, c.d)
		fmt.Printf("%s +(%d,%d,%d) = %s\n", c.t.Format(layout), c.y, c.m, c.d, r.Format(layout))
	}
	t := time.Date(2024, 3, 10, 23, 59, 59, 999999999, time.UTC)
	for _, dd := range []time.Duration{0, 1, -1, time.Nanosecond, time.Second, -time.Hour, 24 * time.Hour, 365 * 24 * time.Hour,
		-365 * 24 * time.Hour, 100000 * time.Hour, -100000 * time.Hour} {
		fmt.Println(dd, t.Add(dd).Format("2006-01-02 15:04:05.999999999"))
	}
	fmt.Println(t.AddDate(0, 0, 0).Equal(t), t.Add(0) == t)
}

// Output:
// 2024-01-31 10:30:00 Wed +(0,1,0) = 2024-03-02 10:30:00 Sat
// 2023-01-31 10:30:00 Tue +(0,1,0) = 2023-03-03 10:30:00 Fri
// 2024-03-31 10:30:00 Sun +(0,-1,0) = 2024-03-02 10:30:00 Sat
// 2024-02-29 10:30:00 Thu +(1,0,0) = 2025-03-01 10:30:00 Sat
// 2024-02-29 10:30:00 Thu +(4,0,0) = 2028-02-29 10:30:00 Tue
// 2024-02-29 10:30:00 Thu +(-4,0,0) = 2020-02-29 10:30:00 Sat
// 2024-02-29 10:30:00 Thu +(0,12,0) = 2025-03-01 10:30:00 Sat
// 2024-12-31 10:30:00 Tue +(0,2,0) = 2025-03-03 10:30:00 Mon
// 2024-12-31 10:30:00 Tue +(0,0,1) = 2025-01-01 10:30:00 Wed
// 2024-12-31 10:30:00 Tue +(0,0,-366) = 2023-12-31 10:30:00 Sun
// 2024-01-01 10:30:00 Mon +(0,0,366) = 2025-01-01 10:30:00 Wed
// 2024-01-01 10:30:00 Mon +(0,0,365) = 2024-12-31 10:30:00 Tue
// 2023-01-01 10:30:00 Sun +(0,0,365) = 2024-01-01 10:30:00 Mon
// 2024-10-31 10:30:00 Thu +(0,4,0) = 2025-03-03 10:30:00 Mon
// 2024-05-31 10:30:00 Fri +(0,-3,0) = 2024-03-02 10:30:00 Sat
// 2024-05-31 10:30:00 Fri +(0,13,0) = 2025-07-01 10:30:00 Tue
// 2024-05-31 10:30:00 Fri +(0,-25,0) = 2022-05-01 10:30:00 Sun
// 2024-01-15 10:30:00 Mon +(1,1,1) = 2025-02-16 10:30:00 Sun
// 2024-01-15 10:30:00 Mon +(-1,-1,-1) = 2022-12-14 10:30:00 Wed
// 2024-01-01 10:30:00 Mon +(0,0,-1) = 2023-12-31 10:30:00 Sun
// 2024-03-01 10:30:00 Fri +(0,0,-1) = 2024-02-29 10:30:00 Thu
// 2023-03-01 10:30:00 Wed +(0,0,-1) = 2023-02-28 10:30:00 Tue
// 2000-02-29 10:30:00 Tue +(100,0,0) = 2100-03-01 10:30:00 Mon
// 2000-02-29 10:30:00 Tue +(400,0,0) = 2400-02-29 10:30:00 Tue
// 1999-12-31 10:30:00 Fri +(0,0,1) = 2000-01-01 10:30:00 Sat
// 2024-06-30 10:30:00 Sun +(0,8,0) = 2025-03-02 10:30:00 Sun
// 2024-01-31 10:30:00 Wed +(0,0,29) = 2024-02-29 10:30:00 Thu
// 2024-01-31 10:30:00 Wed +(0,0,30) = 2024-03-01 10:30:00 Fri
// 2024-02-01 10:30:00 Thu +(0,1,-1) = 2024-02-29 10:30:00 Thu
// 2024-01-01 10:30:00 Mon +(10,10,10) = 2034-11-11 10:30:00 Sat
// 2024-01-01 10:30:00 Mon +(-2024,0,0) = 0000-01-01 10:30:00 Sat
// 2024-01-01 10:30:00 Mon +(0,0,0) = 2024-01-01 10:30:00 Mon
// 0s 2024-03-10 23:59:59.999999999
// 1ns 2024-03-11 00:00:00
// -1ns 2024-03-10 23:59:59.999999998
// 1ns 2024-03-11 00:00:00
// 1s 2024-03-11 00:00:00.999999999
// -1h0m0s 2024-03-10 22:59:59.999999999
// 24h0m0s 2024-03-11 23:59:59.999999999
// 8760h0m0s 2025-03-10 23:59:59.999999999
// -8760h0m0s 2023-03-11 23:59:59.999999999
// 100000h0m0s 2035-08-07 15:59:59.999999999
// -100000h0m0s 2012-10-13 07:59:59.999999999
// true true
