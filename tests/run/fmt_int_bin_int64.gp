// phase: 05

// Go's %b of int64 values with every flag, width and precision: the integer formatting of
// fmt/format.go.
package main

import "fmt"

func main() {
	fmt.Printf("[%b]\n", int64(9223372036854775807))
	fmt.Printf("[%+b]\n", int64(9223372036854775807))
	fmt.Printf("[%-b]\n", int64(9223372036854775807))
	fmt.Printf("[% b]\n", int64(9223372036854775807))
	fmt.Printf("[%0b]\n", int64(9223372036854775807))
	fmt.Printf("[%#b]\n", int64(9223372036854775807))
	fmt.Printf("[%8b]\n", int64(9223372036854775807))
	fmt.Printf("[%-8b]\n", int64(9223372036854775807))
	fmt.Printf("[%08b]\n", int64(9223372036854775807))
	fmt.Printf("[%+8b]\n", int64(9223372036854775807))
	fmt.Printf("[%+08b]\n", int64(9223372036854775807))
	fmt.Printf("[% 8b]\n", int64(9223372036854775807))
	fmt.Printf("[%8.3b]\n", int64(9223372036854775807))
	fmt.Printf("[%.3b]\n", int64(9223372036854775807))
	fmt.Printf("[%.0b]\n", int64(9223372036854775807))
	fmt.Printf("[%#8b]\n", int64(9223372036854775807))
	fmt.Printf("[%#08b]\n", int64(9223372036854775807))
	fmt.Printf("[%-#8b]\n", int64(9223372036854775807))
	fmt.Printf("[%+.5b]\n", int64(9223372036854775807))
	fmt.Printf("[%0-8b]\n", int64(9223372036854775807))
	fmt.Printf("[%12.8b]\n", int64(9223372036854775807))
	fmt.Printf("[%-12.8b]\n", int64(9223372036854775807))
	fmt.Printf("[%#.4b]\n", int64(9223372036854775807))
	fmt.Printf("[%+#b]\n", int64(9223372036854775807))
	fmt.Printf("[%b]\n", int64(-9223372036854775808))
	fmt.Printf("[%+b]\n", int64(-9223372036854775808))
	fmt.Printf("[%-b]\n", int64(-9223372036854775808))
	fmt.Printf("[% b]\n", int64(-9223372036854775808))
	fmt.Printf("[%0b]\n", int64(-9223372036854775808))
	fmt.Printf("[%#b]\n", int64(-9223372036854775808))
	fmt.Printf("[%8b]\n", int64(-9223372036854775808))
	fmt.Printf("[%-8b]\n", int64(-9223372036854775808))
	fmt.Printf("[%08b]\n", int64(-9223372036854775808))
	fmt.Printf("[%+8b]\n", int64(-9223372036854775808))
	fmt.Printf("[%+08b]\n", int64(-9223372036854775808))
	fmt.Printf("[% 8b]\n", int64(-9223372036854775808))
	fmt.Printf("[%8.3b]\n", int64(-9223372036854775808))
	fmt.Printf("[%.3b]\n", int64(-9223372036854775808))
	fmt.Printf("[%.0b]\n", int64(-9223372036854775808))
	fmt.Printf("[%#8b]\n", int64(-9223372036854775808))
	fmt.Printf("[%#08b]\n", int64(-9223372036854775808))
	fmt.Printf("[%-#8b]\n", int64(-9223372036854775808))
	fmt.Printf("[%+.5b]\n", int64(-9223372036854775808))
	fmt.Printf("[%0-8b]\n", int64(-9223372036854775808))
	fmt.Printf("[%12.8b]\n", int64(-9223372036854775808))
	fmt.Printf("[%-12.8b]\n", int64(-9223372036854775808))
	fmt.Printf("[%#.4b]\n", int64(-9223372036854775808))
	fmt.Printf("[%+#b]\n", int64(-9223372036854775808))
	fmt.Printf("[%b]\n", int64(1) << 40)
	fmt.Printf("[%+b]\n", int64(1) << 40)
	fmt.Printf("[%-b]\n", int64(1) << 40)
	fmt.Printf("[% b]\n", int64(1) << 40)
	fmt.Printf("[%0b]\n", int64(1) << 40)
	fmt.Printf("[%#b]\n", int64(1) << 40)
	fmt.Printf("[%8b]\n", int64(1) << 40)
	fmt.Printf("[%-8b]\n", int64(1) << 40)
	fmt.Printf("[%08b]\n", int64(1) << 40)
	fmt.Printf("[%+8b]\n", int64(1) << 40)
	fmt.Printf("[%+08b]\n", int64(1) << 40)
	fmt.Printf("[% 8b]\n", int64(1) << 40)
	fmt.Printf("[%8.3b]\n", int64(1) << 40)
	fmt.Printf("[%.3b]\n", int64(1) << 40)
	fmt.Printf("[%.0b]\n", int64(1) << 40)
	fmt.Printf("[%#8b]\n", int64(1) << 40)
	fmt.Printf("[%#08b]\n", int64(1) << 40)
	fmt.Printf("[%-#8b]\n", int64(1) << 40)
	fmt.Printf("[%+.5b]\n", int64(1) << 40)
	fmt.Printf("[%0-8b]\n", int64(1) << 40)
	fmt.Printf("[%12.8b]\n", int64(1) << 40)
	fmt.Printf("[%-12.8b]\n", int64(1) << 40)
	fmt.Printf("[%#.4b]\n", int64(1) << 40)
	fmt.Printf("[%+#b]\n", int64(1) << 40)
}

