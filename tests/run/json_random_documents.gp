// phase: 09
// encoding/json over seeded pseudo-random documents: generated valid texts (random nesting,
// whitespace, escapes, numbers) through Valid, Unmarshal into any, Marshal, Compact, Indent and
// UseNumber, then damaged copies (a byte removed, inserted or replaced) through the same calls.

package main

import (
	"bytes"
	"encoding/json"
	"fmt"
	"strings"
)

// generator is a deterministic linear congruential generator, so Go and gocpp see the same data.
type generator struct{ state uint64 }

func (g *generator) next() uint64 {
	g.state = g.state*6364136223846793005 + 1442695040888963407
	return g.state >> 33
}

func (g *generator) below(limit int) int {
	return int(g.next() % uint64(limit))
}

var pieces = []string{"a", "b", "key", "é", "日本", "😀", "\\n", "\\t", "\\\"", "\\\\", "\\/", "\\u0041", "\\u00e9", "\\ud83d\\ude00", "<", "&", "x y", "", "\\u2028", "0", "\\b\\f\\r"}

var numbers = []string{"0", "-0", "1", "-1", "12", "1.5", "-2.25", "1e3", "1E-3", "1.5e+10", "0.1", "123456789012", "9007199254740993", "1e400", "0e0", "-0.0e-0", "3.14159265358979", "100000000000000000000", "5e-324"}

func (g *generator) space() string {
	switch g.below(6) {
	case 0:
		return " "
	case 1:
		return "\n"
	case 2:
		return "\t "
	case 3:
		return "\r\n"
	}
	return ""
}

func (g *generator) text() string {
	var builder strings.Builder
	builder.WriteByte('"')
	for count := g.below(4); count > 0; count-- {
		builder.WriteString(pieces[g.below(len(pieces))])
	}
	builder.WriteByte('"')
	return builder.String()
}

func (g *generator) value(depth int) string {
	kind := g.below(9)
	if depth <= 0 && kind >= 6 {
		kind = g.below(6)
	}
	switch kind {
	case 0:
		return "null"
	case 1:
		return "true"
	case 2:
		return "false"
	case 3, 4:
		return numbers[g.below(len(numbers))]
	case 5:
		return g.text()
	case 6, 7:
		var builder strings.Builder
		builder.WriteString("[" + g.space())
		for index, count := 0, g.below(5); index < count; index++ {
			if index > 0 {
				builder.WriteString(g.space() + "," + g.space())
			}
			builder.WriteString(g.value(depth - 1))
		}
		builder.WriteString(g.space() + "]")
		return builder.String()
	}
	var builder strings.Builder
	builder.WriteString("{" + g.space())
	for index, count := 0, g.below(5); index < count; index++ {
		if index > 0 {
			builder.WriteString(g.space() + "," + g.space())
		}
		builder.WriteString(g.text() + g.space() + ":" + g.space() + g.value(depth-1))
	}
	builder.WriteString(g.space() + "}")
	return builder.String()
}

func describe(err error) string {
	if err == nil {
		return "ok"
	}
	if syntax, isSyntax := err.(*json.SyntaxError); isSyntax {
		return fmt.Sprintf("@%d %v", syntax.Offset, syntax)
	}
	return fmt.Sprintf("%T %v", err, err)
}

func checksum(data []byte) uint32 {
	hash := uint32(2166136261)
	for _, value := range data {
		hash ^= uint32(value)
		hash *= 16777619
	}
	return hash
}

func process(label string, input []byte) {
	var value any
	err := json.Unmarshal(input, &value)
	remarshaled, marshalErr := json.Marshal(value)
	var compact, indented bytes.Buffer
	compactErr := json.Compact(&compact, input)
	indentErr := json.Indent(&indented, input, "", " ")
	decoder := json.NewDecoder(bytes.NewReader(input))
	decoder.UseNumber()
	var numbered any
	numberErr := decoder.Decode(&numbered)
	numberedBytes, _ := json.Marshal(numbered)
	var raw json.RawMessage
	rawErr := json.Unmarshal(input, &raw)
	fmt.Printf("%s len=%d valid=%v unmarshal=%s | marshal=%08x %v | compact=%08x %s | indent=%08x %s | number=%08x %s | raw=%08x %s\n",
		label, len(input), json.Valid(input), describe(err), checksum(remarshaled), marshalErr,
		checksum(compact.Bytes()), describe(compactErr), checksum(indented.Bytes()), describe(indentErr),
		checksum(numberedBytes), describe(numberErr), checksum(raw), describe(rawErr))
}

func main() {
	random := &generator{state: 20261020}
	var documents [][]byte
	fmt.Println("== valid documents")
	for index := 0; index < 150; index++ {
		document := []byte(random.space() + random.value(4) + random.space())
		documents = append(documents, document)
		process(fmt.Sprintf("doc %03d", index), document)
	}
	fmt.Println("== a sample, spelled out")
	for _, index := range []int{3, 17, 61} {
		var value any
		_ = json.Unmarshal(documents[index], &value)
		remarshaled, _ := json.Marshal(value)
		indented, _ := json.MarshalIndent(value, "", "  ")
		fmt.Printf("%q\n%s\n%s\n", documents[index], remarshaled, indented)
	}
	fmt.Println("== damaged documents")
	alphabet := []byte(`{}[],:"\ -.0e+1tnfx` + "\n\x00\xff")
	for index, document := range documents {
		for variant := 0; variant < 4; variant++ {
			damaged := append([]byte(nil), document...)
			if len(damaged) == 0 {
				continue
			}
			position := random.below(len(damaged))
			switch variant {
			case 0:
				damaged = append(damaged[:position], damaged[position+1:]...)
			case 1:
				damaged = append(damaged[:position], append([]byte{alphabet[random.below(len(alphabet))]}, damaged[position:]...)...)
			case 2:
				damaged[position] = alphabet[random.below(len(alphabet))]
			case 3:
				damaged = damaged[:position]
			}
			process(fmt.Sprintf("bad %03d.%d@%d", index, variant, position), damaged)
		}
	}
}

