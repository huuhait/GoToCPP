// phase: 08

// Generated by tests/mustgen -mode ord (seed 2, program 12): the order of evaluation around ! calls.
// Its twin in testdata/must_twin/ is the same text without the !.
package main

import (
	"errors"
	"fmt"
)

var failAt = -1

type Pt struct {
	id int
	X  int
}

type Cell struct{ A, B int }

type Num int

func sum(id int, args []int) int {
	s := id * 3
	for _, a := range args {
		s += a
	}
	return s % 1000
}

func m8(x int) int { return (x%8 + 8) % 8 }

func b1(x int) int { return x & 1 }

func L(id int, args ...int) int {
	fmt.Println("L", id)
	return sum(id, args)
}

func S(id int) []int {
	fmt.Println("S", id)
	return []int{10, 11, 12, 13, 14, 15, 16, 17}
}

func FN(id int) []func(int) int {
	fmt.Println("FN", id)
	var fs []func(int) int
	for i := 0; i < 8; i++ {
		fs = append(fs, func(x int) int { return x + i })
	}
	return fs
}

func MP(id int) map[int]int {
	fmt.Println("MP", id)
	m := map[int]int{}
	for i := 0; i < 8; i++ {
		m[i] = i * i
	}
	return m
}

func PT(id int) *Pt {
	fmt.Println("PT", id)
	return &Pt{id: id, X: id + 1}
}

func (p *Pt) M(a int) int {
	fmt.Println("M", p.id)
	return p.id + a
}

func PI(id int) *int {
	fmt.Println("PI", id)
	v := id * 2
	return &v
}

func A(id int) any {
	fmt.Println("A", id)
	return id
}

func CH(id int) chan int {
	fmt.Println("CH", id)
	c := make(chan int, 1)
	c <- id + 100
	return c
}

func GEN[T int | int64](a T) T {
	fmt.Println("GEN", a)
	return a + 1
}

func Add2(a, b int) int { return a*10 + b }

func fail(id int) error {
	return fmt.Errorf("fail %d: %w", id, ErrBad)
}

var ErrBad = errors.New("bad")

func run() (int, error) {
	v0, v1, v2, v3 := 1, 2, 3, 4
	var arr [8]int
	ch := make(chan int, 64)
	_ = ch
	switch GG![int](100) {
	case m8(([]int{int(Num(v1)), (Cell{A: 5, B: 4}.B), v1}[1])):
		if (L(1) > G!(101, v3, v1, v2)) {
			v0 = (<-CH(2) + GEN[int](int(Num(8))))
			v1 += (map[int]int{m8(append(S(3), 1)[2]): (len(S(4)) + v1), m8(([]int{v1, v0, v1}[1])) + 8: (map[int]int{m8(1): v3, m8(v3) + 8: v3}[3])}[3])
			v3 = L(5, Add2(Two!(102, 1)), Add2(Two!(103, v1)), (Cell{A: 6, B: v2}.B))
		} else if GEN[int](Add2(Two!(104, 7))) < ((Cell{A: v2, B: 3}.B) + PT(6).GM!(105, v3)) {
