// phase: 09
// Special values through Floor, Ceil, Trunc, Round, RoundToEven, Abs.

package main

import (
	"fmt"
	"math"
)

func main() {
	vals := []float64{0, math.Copysign(0, -1), 1, -1, 0.5, -0.5, 2, -2, 10, -10, math.Pi, math.Pi / 2, -math.Pi / 2, 1e-300, 5e-324, 1e300, math.MaxFloat64, math.Inf(1), math.Inf(-1), math.NaN(), 709.7, 710, -745.2, -746, 171.5, 172, 0.9999999999999999, 1.0000000000000002}
	fmt.Println("Floor")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Floor(x), math.Float64bits(math.Floor(x)))
	}
	fmt.Println("Ceil")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Ceil(x), math.Float64bits(math.Ceil(x)))
	}
	fmt.Println("Trunc")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Trunc(x), math.Float64bits(math.Trunc(x)))
	}
	fmt.Println("Round")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Round(x), math.Float64bits(math.Round(x)))
	}
	fmt.Println("RoundToEven")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.RoundToEven(x), math.Float64bits(math.RoundToEven(x)))
	}
	fmt.Println("Abs")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Abs(x), math.Float64bits(math.Abs(x)))
	}
}

