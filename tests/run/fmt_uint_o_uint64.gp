// phase: 05

// Go's %o of uint64 values with flags, width and precision.
package main

import "fmt"

func main() {
	fmt.Printf("[%o]\n", uint64(18446744073709551615))
	fmt.Printf("[%+o]\n", uint64(18446744073709551615))
	fmt.Printf("[%-o]\n", uint64(18446744073709551615))
	fmt.Printf("[% o]\n", uint64(18446744073709551615))
	fmt.Printf("[%0o]\n", uint64(18446744073709551615))
	fmt.Printf("[%#o]\n", uint64(18446744073709551615))
	fmt.Printf("[%8o]\n", uint64(18446744073709551615))
	fmt.Printf("[%-8o]\n", uint64(18446744073709551615))
	fmt.Printf("[%08o]\n", uint64(18446744073709551615))
	fmt.Printf("[%+8o]\n", uint64(18446744073709551615))
	fmt.Printf("[%+08o]\n", uint64(18446744073709551615))
	fmt.Printf("[% 8o]\n", uint64(18446744073709551615))
	fmt.Printf("[%8.3o]\n", uint64(18446744073709551615))
	fmt.Printf("[%.3o]\n", uint64(18446744073709551615))
	fmt.Printf("[%.0o]\n", uint64(18446744073709551615))
	fmt.Printf("[%#8o]\n", uint64(18446744073709551615))
	fmt.Printf("[%#08o]\n", uint64(18446744073709551615))
	fmt.Printf("[%-#8o]\n", uint64(18446744073709551615))
	fmt.Printf("[%+.5o]\n", uint64(18446744073709551615))
	fmt.Printf("[%0-8o]\n", uint64(18446744073709551615))
	fmt.Printf("[%12.8o]\n", uint64(18446744073709551615))
	fmt.Printf("[%-12.8o]\n", uint64(18446744073709551615))
	fmt.Printf("[%#.4o]\n", uint64(18446744073709551615))
	fmt.Printf("[%+#o]\n", uint64(18446744073709551615))
	fmt.Printf("[%o]\n", uint64(1)<<40)
	fmt.Printf("[%+o]\n", uint64(1)<<40)
	fmt.Printf("[%-o]\n", uint64(1)<<40)
	fmt.Printf("[% o]\n", uint64(1)<<40)
	fmt.Printf("[%0o]\n", uint64(1)<<40)
	fmt.Printf("[%#o]\n", uint64(1)<<40)
	fmt.Printf("[%8o]\n", uint64(1)<<40)
	fmt.Printf("[%-8o]\n", uint64(1)<<40)
	fmt.Printf("[%08o]\n", uint64(1)<<40)
	fmt.Printf("[%+8o]\n", uint64(1)<<40)
	fmt.Printf("[%+08o]\n", uint64(1)<<40)
	fmt.Printf("[% 8o]\n", uint64(1)<<40)
	fmt.Printf("[%8.3o]\n", uint64(1)<<40)
	fmt.Printf("[%.3o]\n", uint64(1)<<40)
	fmt.Printf("[%.0o]\n", uint64(1)<<40)
	fmt.Printf("[%#8o]\n", uint64(1)<<40)
	fmt.Printf("[%#08o]\n", uint64(1)<<40)
	fmt.Printf("[%-#8o]\n", uint64(1)<<40)
	fmt.Printf("[%+.5o]\n", uint64(1)<<40)
	fmt.Printf("[%0-8o]\n", uint64(1)<<40)
	fmt.Printf("[%12.8o]\n", uint64(1)<<40)
	fmt.Printf("[%-12.8o]\n", uint64(1)<<40)
	fmt.Printf("[%#.4o]\n", uint64(1)<<40)
	fmt.Printf("[%+#o]\n", uint64(1)<<40)
}

