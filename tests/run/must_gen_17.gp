package main

import (
	"errors"
	"fmt"
)

var ErrBad = errors.New("bad")

func f1(n int) (int, error) {
	fmt.Println("f1", n)
	if n%5 == 3 {
		return 0, fmt.Errorf("f1(%d): %w", n, ErrBad)
	}
	return n*2 + 1, nil
}

func f2(n int) (int, int, error) {
	fmt.Println("f2", n)
	if n%6 == 2 {
		return 0, 0, fmt.Errorf("f2(%d): %w", n, ErrBad)
	}
	return n + 1, n - 1, nil
}

func f3(n int) error {
	fmt.Println("f3", n)
	if n%7 == 4 {
		return fmt.Errorf("f3(%d): %w", n, ErrBad)
	}
	return nil
}

func b1(n int) (bool, error) {
	fmt.Println("b1", n)
	if n%8 == 5 {
		return false, fmt.Errorf("b1(%d): %w", n, ErrBad)
	}
	return n%2 == 0, nil
}

func run(seed int) (int, error) {
	v0, v1, v2, v3 := seed, seed*3+1, seed%4, 7-seed
	for i1 := 0; i1 < 3; i1++ {
		for i2 := 0; i2 < 2 && b1!(v2); i2++ {
			if (v0 + 4) < 7 {
				continue
			}
			f3!(7)
			for i3 := 0; i3 < 1 && b1!(v0); i3++ {
				v1 = f1!(v2)
				v1 = f1!(f1!(v2))
			}
		}
		for i4 := 0; i4 < 3 && (((v1 - v1) < f1!(v3) || b1!(f1!(v2))) && b1!(v2)); i4++ {
			for i5 := 0; i5 < 2 && b1!(f1!(v3)); i5++ {
				f3!(v3)
			}
		}
	}
	switch v0 % 3 {
	case 0:
		v2 = (9 - (v2 - 1))
		for i6 := 0; i6 < 2 && f1!(v2) < (9 - v1); i6++ {
			if v3 < 6 {
				break
			}
			v1, v0 = f2!(f1!(v0))
			v2 = v3
		}
	case 1:
		switch {
		case b1!((v2 - 5)):
			v2 += f1!((v2 - v2))
			v3, v1 = f2!(f1!(v3))
			v2 = f1!((0 + v3))
		case b1!(5):
			v1 = (v3 - v2)
			v0 += ((v3 - v0) - f1!(v0))
		case b1!(f1!(v2)):
			v2, v1 = f2!(f1!(3))
		}
	default:
		f3!(0)
	}
	v2 += f1!(f1!(4))
	return (v0*1000 + v1*100 + v2*10 + v3) % 100000, nil
}

func main() {
	for seed := 0; seed < 10; seed++ {
		v, err := run(seed)
		fmt.Println("run", seed, v, err, errors.Is(err, ErrBad))
	}
}

