// phase: 09

// Generated by tools/genericsgen (family strings): a hash sweep of generic code, compared with real Go.
package main

import (
	"cmp"
	"fmt"
	"math"
	"slices"
)

type hasher struct {
	h     uint64
	debug bool
	name  string
	n     int
}

func newHasher(name string) *hasher { return &hasher{h: 14695981039346656037, name: name} }

func (x *hasher) u64(v uint64) {
	if x.debug {
		x.n++
		fmt.Println(x.name, x.n, v)
	}
	for i := 0; i < 8; i++ {
		x.h ^= (v >> (8 * i)) & 0xff
		x.h *= 1099511628211
	}
}
func (x *hasher) bool(b bool) {
	if b {
		x.u64(1)
	} else {
		x.u64(0)
	}
}
func (x *hasher) f64(f float64) {
	if f != f {
		x.u64(0x7ff8000000000001) // every NaN is one value
		return
	}
	x.u64(math.Float64bits(f))
}
func (x *hasher) f32(f float32) {
	if f != f {
		x.u64(0x7fc00001)
		return
	}
	x.u64(uint64(math.Float32bits(f)))
}
func (x *hasher) str(s string) {
	x.u64(uint64(len(s)))
	for i := 0; i < len(s); i++ {
		x.h ^= uint64(s[i])
		x.h *= 1099511628211
	}
}
func (x *hasher) done() {
	if x.debug {
		return
	}
	fmt.Printf("%-10s %016x\n", x.name, x.h)
}

func recoverText(f func()) (msg string) {
	defer func() {
		if r := recover(); r != nil {
			msg = fmt.Sprint(r)
		}
	}()
	f()
	return ""
}

var _ = math.Pi
var _ = cmp.Compare[int]
var _ = slices.Max[[]int]

var raw = []string{"", "a", "abc", "hello, world", "日本語", "héllo", "\xff\xfe", "a\x00b", "é́", "😀x😀", "Z", "z", "ab", "abd", "\xed\xa0\x80", "\xc0\x80", "tab\there", "daéh本", "fajd日ijb", "c日", "日g", "hdc", "j日hjjf", "ag", "aieaiid"}

type Text string
type Raw []byte
type Name string

type Bytes interface{ ~string | ~[]byte }

func lenIndex[T Bytes](h *hasher, t T) {
	h.u64(uint64(len(t)))
	for i := 0; i < len(t); i++ {
		h.u64(uint64(t[i]))
	}
	for i, c := range string(t) {
		h.u64(uint64(i))
		h.u64(uint64(c))
	}
	h.str(string(t))
	for _, r := range []rune(string(t)) {
		h.u64(uint64(r))
	}
	if len(t) >= 2 {
		h.str(string(t[1:]))
		h.str(string(t[:len(t)-1]))
		h.str(string(t[len(t)/2 : len(t)/2+1]))
	}
	h.str(string([]byte(string(t))))
	h.u64(uint64(len(append([]byte(nil), t...))))
}

func concat[S ~string](h *hasher, vs []S) {
	for _, a := range vs {
		for _, c := range vs {
			s := a + c
			h.str(string(s))
			h.bool(a < c)
			h.bool(a <= c)
			h.bool(a == c)
			h.bool(a > c)
			h.bool(a >= c)
			h.bool(a != c)
			h.str(string(max(a, c)))
			h.str(string(min(a, c)))
		}
		s := a
		s += "!"
		s += a
		h.str(string(s))
		h.str(string(S(rune(len(a)) + 'a')))
		h.u64(uint64(len(a + a + a)))
	}
}

func conv[S ~string, B ~[]byte](h *hasher, vs []S) {
	for _, a := range vs {
		b := B(a)
		h.u64(uint64(len(b)))
		h.str(string(b))
		if len(b) > 0 {
			b[0] ^= 0x20
		}
		h.str(string(b))
		h.str(string(a)) // the string is unchanged by the change of the copy
		h.str(string(S(b)))
		rs := []rune(a)
		h.u64(uint64(len(rs)))
		for _, r := range rs {
			h.u64(uint64(r))
		}
		h.str(string(S(rs)))
	}
}

func runes[I ~int8 | ~int32 | ~uint8 | ~uint32 | ~int | ~uint64, S ~string](h *hasher) {
	for _, r := range []int64{0, 65, 127, 128, 255, 256, 0x7ff, 0x800, 0xd7ff, 0xd800, 0xdfff, 0xe000, 0xffff, 0x10000, 0x10ffff, 0x110000, -1, 1 << 40} {
		i := I(r)
		h.str(string(S(i)))
		h.str(string(rune(i)))
	}
}

func sweep(name string) {
	h := newHasher(name)
	switch name {
	case "string":
		for _, s := range raw {
			lenIndex(h, s)
		}
		concat(h, raw)
	case "Text":
		var vs []Text
		for _, s := range raw {
			vs = append(vs, Text(s))
			lenIndex(h, Text(s))
		}
		concat(h, vs)
		conv[Text, Raw](h, vs)
	case "Raw":
		for _, s := range raw {
			lenIndex(h, Raw(s))
		}
	case "bytes":
		for _, s := range raw {
			lenIndex(h, []byte(s))
		}
	case "Name":
		var vs []Name
		for _, s := range raw {
			vs = append(vs, Name(s))
		}
		concat(h, vs)
		conv[Name, []byte](h, vs)
	case "conv":
		conv[string, []byte](h, raw)
		conv[string, Raw](h, raw)
	case "runes":
		runes[int8, string](h)
		runes[int32, Text](h)
		runes[uint8, Name](h)
		runes[uint32, string](h)
		runes[int, Text](h)
		runes[uint64, string](h)
	}
	h.done()
}

func main() {
	for _, n := range []string{"string", "Text", "Raw", "bytes", "Name", "conv", "runes"} {
		sweep(n)
	}
}

