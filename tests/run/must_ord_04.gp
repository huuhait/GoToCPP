// phase: 10

// Generated by tests/mustgen -mode ord (seed 2, program 4): the order of evaluation around ! calls.
// Its twin in testdata/must_twin/ is the same text without the !.
package main

import (
	"errors"
	"fmt"
)

var failAt = -1

type Pt struct {
	id int
	X  int
}

type Cell struct{ A, B int }

type Num int

func sum(id int, args []int) int {
	s := id * 3
	for _, a := range args {
		s += a
	}
	return s % 1000
}

func m8(x int) int { return (x%8 + 8) % 8 }

func b1(x int) int { return x & 1 }

func L(id int, args ...int) int {
	fmt.Println("L", id)
	return sum(id, args)
}

func S(id int) []int {
	fmt.Println("S", id)
	return []int{10, 11, 12, 13, 14, 15, 16, 17}
}

func FN(id int) []func(int) int {
	fmt.Println("FN", id)
	var fs []func(int) int
	for i := 0; i < 8; i++ {
		fs = append(fs, func(x int) int { return x + i })
	}
	return fs
}

func MP(id int) map[int]int {
	fmt.Println("MP", id)
	m := map[int]int{}
	for i := 0; i < 8; i++ {
		m[i] = i * i
	}
	return m
}

func PT(id int) *Pt {
	fmt.Println("PT", id)
	return &Pt{id: id, X: id + 1}
}

func (p *Pt) M(a int) int {
	fmt.Println("M", p.id)
	return p.id + a
}

func PI(id int) *int {
	fmt.Println("PI", id)
	v := id * 2
	return &v
}

func A(id int) any {
	fmt.Println("A", id)
	return id
}

func CH(id int) chan int {
	fmt.Println("CH", id)
	c := make(chan int, 1)
	c <- id + 100
	return c
}

func GEN[T int | int64](a T) T {
	fmt.Println("GEN", a)
	return a + 1
}

func Add2(a, b int) int { return a*10 + b }

func fail(id int) error {
	return fmt.Errorf("fail %d: %w", id, ErrBad)
}

var ErrBad = errors.New("bad")

func run() (int, error) {
	v0, v1, v2, v3 := 1, 2, 3, 4
	var arr [8]int
	ch := make(chan int, 64)
	_ = ch
	v0 += G!(100)
	PT(1).X = (A(2).(int) - G!(101, int(int64(v2)), MP(3)[m8(v3)]))
	arr[m8(PT(4).GM!(102, GG![int](103)))]++
	L(5, G!(104, MP(6)[m8(L(7))], S(8)[m8(FN(9)[m8(v0)](v2))], v3), 2)
	arr[m8(v1)]++
	v1 = 8
	return (v0*7+v1*5+v2*3+v3+arr[0]+arr[3]+len(ch)) % 100003, nil
}

func G(id int, args ...int) (int, error) {
	fmt.Println("G", id)
	if id == failAt {
		return 0, fail(id)
	}
	return sum(id, args), nil
}

func GB(id int, x int) (bool, error) {
	fmt.Println("GB", id)
	if id == failAt {
		return false, fail(id)
	}
	return (sum(id, nil)+x)%3 == 0, nil
}

func (p *Pt) GM(id int, a int) (int, error) {
	fmt.Println("GM", id, p.id)
	if id == failAt {
		return 0, fail(id)
	}
	return p.id + a + id, nil
}

func GG[T int | int64](id int, args ...T) (T, error) {
	fmt.Println("GG", id)
	if id == failAt {
		return 0, fail(id)
	}
	var s T
	for _, a := range args {
		s += a
	}
	return s + T(id), nil
}

func Two(id int, a int) (int, int, error) {
	fmt.Println("Two", id)
	if id == failAt {
		return 0, 0, fail(id)
	}
	return a, id, nil
}

func main() {
	for _, fa := range []int{-1, 100, 101, 102, 103, 104} {
		failAt = fa
		res, err := run()
		fmt.Println("run", fa, res, err, errors.Is(err, ErrBad))
	}
}

