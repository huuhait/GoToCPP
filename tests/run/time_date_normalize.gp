// phase: 08

// time.Date normalizes out-of-range fields: month 13, day 0, negative values, hours past a day.
package main

import (
	"fmt"
	"time"
)

func show(y int, m time.Month, d, h, mi, s, ns int) {
	t := time.Date(y, m, d, h, mi, s, ns, time.UTC)
	fmt.Printf("%d %d %d %d %d %d %d -> %s\n", y, int(m), d, h, mi, s, ns, t.Format("2006-01-02 15:04:05.000000000 Mon"))
}

func main() {
	show(2024, 13, 1, 0, 0, 0, 0)
	show(2024, 0, 1, 0, 0, 0, 0)
	show(2024, -1, 1, 0, 0, 0, 0)
	show(2024, -12, 15, 0, 0, 0, 0)
	show(2024, 25, 31, 0, 0, 0, 0)
	show(2024, 1, 0, 0, 0, 0, 0)
	show(2024, 1, -1, 0, 0, 0, 0)
	show(2024, 3, 0, 0, 0, 0, 0)
	show(2023, 3, 0, 0, 0, 0, 0)
	show(2024, 2, 30, 0, 0, 0, 0)
	show(2023, 2, 29, 0, 0, 0, 0)
	show(2024, 1, 366, 0, 0, 0, 0)
	show(2024, 12, 32, 0, 0, 0, 0)
	show(2024, 1, 1, 24, 0, 0, 0)
	show(2024, 1, 1, 25, 61, 61, 0)
	show(2024, 1, 1, -1, 0, 0, 0)
	show(2024, 1, 1, 0, -1, 0, 0)
	show(2024, 1, 1, 0, 0, -1, 0)
	show(2024, 1, 1, 0, 0, 0, -1)
	show(2024, 1, 1, 0, 0, 0, 1000000000)
	show(2024, 1, 1, 0, 0, 0, 1999999999)
	show(2024, 1, 1, 0, 0, 0, -1000000001)
	show(2024, 1, 1, 0, 0, 86400, 0)
	show(2024, 1, 1, 0, 0, -86400, 0)
	show(2024, 1, 1, 0, 1440, 0, 0)
	show(2024, 1, 1, 48, 0, 0, 0)
	show(2024, 1, 1, 100000, 0, 0, 0)
	show(0, 1, 1, 0, 0, 0, 0)
	show(-1, 1, 1, 0, 0, 0, 0)
	show(1, 1, 1, 0, 0, 0, -1)
	show(1900, 2, 29, 0, 0, 0, 0)
	show(2000, 2, 29, 0, 0, 0, 0)
	show(2100, 2, 29, 0, 0, 0, 0)
	show(9999, 12, 31, 23, 59, 59, 999999999)
	show(10000, 1, 1, 0, 0, 0, 0)
	show(1969, 12, 31, 23, 59, 59, 0)
	show(1970, 1, 1, 0, 0, 0, 0)
	show(1970, 1, 1, 0, 0, -1, 0)
	show(1600, 2, 29, 12, 0, 0, 0)
	show(2024, 14, 35, 26, 70, 70, 2000000000)
	t := time.Date(2024, 12, 31, 0, 0, 0, 0, time.UTC)
	fmt.Println(t.Year(), t.Month(), t.Day(), t.YearDay())
	fmt.Println(time.Date(2024, 2, 30, 0, 0, 0, 0, time.UTC).Equal(time.Date(2024, 3, 1, 0, 0, 0, 0, time.UTC)))
}

