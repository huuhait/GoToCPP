// phase: 09
// Conversions of float variables inside expressions and loops (not constant folded): out-of-range values included.

package main

import (
	"fmt"
	"math"
)


func main() {

	vals := []float64{1e18, 1e19, 2e19, -1e19, 9.3e18, math.Inf(1), math.NaN(), 3.99, -3.99}
	var sum int64
	var usum uint64
	for _, v := range vals {
		sum += int64(v)
		usum += uint64(v)
		x := v * 2
		fmt.Println(int64(x), uint64(x), int32(x), uint32(x), int64(float32(x)))
	}
	fmt.Println(sum, usum)
	var f float64 = 255.9
	var b byte = byte(f)
	var i8 = int8(f)
	var u16 = uint16(f * 300)
	fmt.Println(b, i8, u16, byte(f+1), int8(-f-1))

}

// Output:
// 2000000000000000000 2000000000000000000 -2147483648 1321730048 1999999968613498880
// -9223372036854775808 9223372036854775808 -2147483648 0 -9223372036854775808
