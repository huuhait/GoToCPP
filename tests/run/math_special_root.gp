// phase: 09
// Special values through Sqrt and Cbrt.

package main

import (
	"fmt"
	"math"
)

func main() {
	vals := []float64{0, math.Copysign(0, -1), 1, -1, 0.5, -0.5, 2, -2, 10, -10, math.Pi, math.Pi / 2, -math.Pi / 2, 1e-300, 5e-324, 1e300, math.MaxFloat64, math.Inf(1), math.Inf(-1), math.NaN(), 709.7, 710, -745.2, -746, 171.5, 172, 0.9999999999999999, 1.0000000000000002}
	fmt.Println("Sqrt")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Sqrt(x), math.Float64bits(math.Sqrt(x)))
	}
	fmt.Println("Cbrt")
	for _, x := range vals {
		fmt.Printf("  %v -> %v (%016x)\n", x, math.Cbrt(x), math.Float64bits(math.Cbrt(x)))
	}
}

