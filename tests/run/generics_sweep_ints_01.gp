type MyI8 int8
type MyU16 uint16
type MyI64 int64
type MyU32 uint32

var raw = []int64{0, 1, 2, 3, 7, 8, 63, 64, 100, 126, 127, 128, 129, 200, 254, 255, 256, 257, 32766, 32767, 32768, 32769, 65534, 65535, 65536, 65537, 2147483647, 2147483648, 2147483649, 4294967295, 4294967296, 4294967297, 9223372036854775807, -9223372036854775808, -1, -2, -3, -127, -128, -129, -255, -256, -32768, -32769, -65536, -2147483648, -2147483649, -4294967296, -3136063341, -239, 723827276011833784, -38854, 18871, -724189655, -187, 3734811028127926339, 1917367778, -9406, -2923552389, 7615287299836546392, -2005273934, 3141432884}

func values[T Int]() []T {
	out := make([]T, len(raw))
	for i, r := range raw {
		out[i] = T(r)
	}
	return out
}

func divmod[T Int](a, b T) (q, r T, panicked bool) {
	defer func() {
		if recover() != nil {
			panicked = true
		}
	}()
	return a / b, a % b, false
}

func shl[T Int, S Int](a T, s S) (res T, panicked bool) {
	defer func() {
		if recover() != nil {
			panicked = true
		}
	}()
	return a << s, false
}

func shr[T Int, S Int](a T, s S) (res T, panicked bool) {
	defer func() {
		if recover() != nil {
			panicked = true
		}
	}()
	return a >> s, false
}

func shifts[T Int, S Int](h *hasher, a T, counts []int) {
	for _, c := range counts {
		s := S(c)
		if int64(s) != int64(c) {
			continue // does not fit the type of the count
		}
		l, p1 := shl(a, s)
		r, p2 := shr(a, s)
		h.u64(uint64(l))
		h.u64(uint64(r))
		h.bool(p1)
		h.bool(p2)
	}
}

var counts = []int{0, 1, 2, 3, 5, 7, 8, 9, 15, 16, 17, 31, 32, 33, 63, 64, 65, 100, 127, 200, 255, 300, 1000}
var negCounts = []int{-1, -2, -100}

func sweep[T Int](name string) {
	h := newHasher(name)
	vs := values[T]()
	for _, a := range vs {
		h.u64(uint64(-a))
		h.u64(uint64(^a))
		h.u64(uint64(+a))
		b := a
		b++
		h.u64(uint64(b))
		b = a
		b--
		h.u64(uint64(b))
		b = a
		b += a
		b *= a
		b -= a
		b ^= a
		b |= 3
		b &^= 5
		b <<= 2
		b >>= 1
		h.u64(uint64(b))
		shifts[T, uint8](h, a, counts)
		shifts[T, uint16](h, a, counts)
		shifts[T, uint32](h, a, counts)
		shifts[T, uint64](h, a, counts)
		shifts[T, uint](h, a, counts)
		shifts[T, int](h, a, append(append([]int{}, counts...), negCounts...))
		shifts[T, int8](h, a, append(append([]int{}, counts[:16]...), negCounts...))
		shifts[T, int64](h, a, append(append([]int{}, counts...), negCounts...))
		for _, c := range vs {
			h.u64(uint64(a + c))
			h.u64(uint64(a - c))
			h.u64(uint64(a * c))
			h.u64(uint64(a & c))
			h.u64(uint64(a | c))
			h.u64(uint64(a ^ c))
			h.u64(uint64(a &^ c))
			q, r, p := divmod(a, c)
			h.u64(uint64(q))
			h.u64(uint64(r))
			h.bool(p)
			h.bool(a < c)
			h.bool(a <= c)
			h.bool(a == c)
			h.bool(a != c)
			h.bool(a > c)
			h.bool(a >= c)
			h.u64(uint64(max(a, c)))
			h.u64(uint64(min(a, c)))
		}
	}
	h.done()
}

func main() {
	sweep[int8]("int8")
	sweep[int16]("int16")
	sweep[int32]("int32")
	sweep[int64]("int64")
	sweep[int]("int")
	sweep[uint8]("uint8")
	sweep[uint16]("uint16")
	sweep[uint32]("uint32")
	sweep[uint64]("uint64")
	sweep[uint]("uint")
	sweep[uintptr]("uintptr")
	sweep[MyI8]("MyI8")
	sweep[MyU16]("MyU16")
	sweep[MyI64]("MyI64")
	sweep[MyU32]("MyU32")
}

