// phase: 05

// Go's %b of int16 values with every flag, width and precision: the integer formatting of
// fmt/format.go.
package main

import "fmt"

func main() {
	fmt.Printf("[%b]\n", int16(32767))
	fmt.Printf("[%+b]\n", int16(32767))
	fmt.Printf("[%-b]\n", int16(32767))
	fmt.Printf("[% b]\n", int16(32767))
	fmt.Printf("[%0b]\n", int16(32767))
	fmt.Printf("[%#b]\n", int16(32767))
	fmt.Printf("[%8b]\n", int16(32767))
	fmt.Printf("[%-8b]\n", int16(32767))
	fmt.Printf("[%08b]\n", int16(32767))
	fmt.Printf("[%+8b]\n", int16(32767))
	fmt.Printf("[%+08b]\n", int16(32767))
	fmt.Printf("[% 8b]\n", int16(32767))
	fmt.Printf("[%8.3b]\n", int16(32767))
	fmt.Printf("[%.3b]\n", int16(32767))
	fmt.Printf("[%.0b]\n", int16(32767))
	fmt.Printf("[%#8b]\n", int16(32767))
	fmt.Printf("[%#08b]\n", int16(32767))
	fmt.Printf("[%-#8b]\n", int16(32767))
	fmt.Printf("[%+.5b]\n", int16(32767))
	fmt.Printf("[%0-8b]\n", int16(32767))
	fmt.Printf("[%12.8b]\n", int16(32767))
	fmt.Printf("[%-12.8b]\n", int16(32767))
	fmt.Printf("[%#.4b]\n", int16(32767))
	fmt.Printf("[%+#b]\n", int16(32767))
	fmt.Printf("[%b]\n", int16(-32768))
	fmt.Printf("[%+b]\n", int16(-32768))
	fmt.Printf("[%-b]\n", int16(-32768))
	fmt.Printf("[% b]\n", int16(-32768))
	fmt.Printf("[%0b]\n", int16(-32768))
	fmt.Printf("[%#b]\n", int16(-32768))
	fmt.Printf("[%8b]\n", int16(-32768))
	fmt.Printf("[%-8b]\n", int16(-32768))
	fmt.Printf("[%08b]\n", int16(-32768))
	fmt.Printf("[%+8b]\n", int16(-32768))
	fmt.Printf("[%+08b]\n", int16(-32768))
	fmt.Printf("[% 8b]\n", int16(-32768))
	fmt.Printf("[%8.3b]\n", int16(-32768))
	fmt.Printf("[%.3b]\n", int16(-32768))
	fmt.Printf("[%.0b]\n", int16(-32768))
	fmt.Printf("[%#8b]\n", int16(-32768))
	fmt.Printf("[%#08b]\n", int16(-32768))
	fmt.Printf("[%-#8b]\n", int16(-32768))
	fmt.Printf("[%+.5b]\n", int16(-32768))
	fmt.Printf("[%0-8b]\n", int16(-32768))
	fmt.Printf("[%12.8b]\n", int16(-32768))
	fmt.Printf("[%-12.8b]\n", int16(-32768))
	fmt.Printf("[%#.4b]\n", int16(-32768))
	fmt.Printf("[%+#b]\n", int16(-32768))
	fmt.Printf("[%b]\n", int16(300))
	fmt.Printf("[%+b]\n", int16(300))
	fmt.Printf("[%-b]\n", int16(300))
	fmt.Printf("[% b]\n", int16(300))
	fmt.Printf("[%0b]\n", int16(300))
	fmt.Printf("[%#b]\n", int16(300))
	fmt.Printf("[%8b]\n", int16(300))
	fmt.Printf("[%-8b]\n", int16(300))
	fmt.Printf("[%08b]\n", int16(300))
	fmt.Printf("[%+8b]\n", int16(300))
	fmt.Printf("[%+08b]\n", int16(300))
	fmt.Printf("[% 8b]\n", int16(300))
	fmt.Printf("[%8.3b]\n", int16(300))
	fmt.Printf("[%.3b]\n", int16(300))
	fmt.Printf("[%.0b]\n", int16(300))
	fmt.Printf("[%#8b]\n", int16(300))
	fmt.Printf("[%#08b]\n", int16(300))
	fmt.Printf("[%-#8b]\n", int16(300))
	fmt.Printf("[%+.5b]\n", int16(300))
	fmt.Printf("[%0-8b]\n", int16(300))
	fmt.Printf("[%12.8b]\n", int16(300))
	fmt.Printf("[%-12.8b]\n", int16(300))
	fmt.Printf("[%#.4b]\n", int16(300))
	fmt.Printf("[%+#b]\n", int16(300))
}

