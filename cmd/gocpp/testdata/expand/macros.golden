// Macros shows what macro declarations and uses become.
package main

import (
	"fmt"
	"sync"
)

// Assert panics when cond is false; msg is only built then.
func Assert[gp_LN_msg ~func() string](gp_file string, gp_line int, gp_func string, gp_text_cond string, cond bool, msg gp_LN_msg) {
	if !cond {
		panic(fmt.Sprintf("%s:%d: assertion failed: %s: %s", gp_file, gp_line, gp_text_cond, msg()))
	}
}

// Dbg returns v.
func Dbg[T any](gp_file string, gp_line int, gp_func string, gp_text_v string, v T) T {
	fmt.Printf("[%s:%d] %s = %v\n", gp_file, gp_line, gp_text_v, v)
	return v
}

func Trace(gp_file string, gp_line int, gp_func string) func() {
	fmt.Println("enter", gp_func)
	return func() { fmt.Println("exit ", gp_func) }
}

func Locked(gp_file string, gp_line int, gp_func string, mu *sync.Mutex) func() {
	mu.Lock()
	return mu.Unlock
}

func Recover[gp_BN ~func()](gp_file string, gp_line int, gp_func string, gp_body gp_BN) {
	defer func() {
		if r := recover(); r != nil {
			fmt.Println("recovered in", gp_func+":", r)
		}
	}()
	gp_body()
}

var mu sync.Mutex

func   spaced( a  int ) int   {  return a }

// double has two macros on top: Trace is applied first (the outer one).
func double(n int) int {
	if gp_defer2 := Trace("main.gp", 46, "main.double"); gp_defer2 != nil {
		defer gp_defer2()
	}
	if gp_defer1 := Locked("main.gp", 47, "main.double", &mu); gp_defer1 != nil {
		defer gp_defer1()
	}

	// the code
	Assert("main.gp", 50, "main.double", "n < 100", n < 100, func() string { return fmt.Sprint("too big: ", n) })
	return n * 2
}

func ratio(a, b int) (gp_r0 int, gp_r1 error) {
	Recover("main.gp", 54, "main.ratio",
		func() {
			gp_r0, gp_r1 = func() (q int, err error) {
				q = a / b
				return
			}()
		})
	return
}

func main() {
	// a use inside code, with a nested one
	x := Dbg("main.gp", 62, "main.main", "double(#Dbg(2))", double(Dbg("main.gp", 62, "main.main", "2", 2)))
	fmt.Println(x, spaced(1))
	fmt.Println(ratio(1, 0))
}
