// Must shows what ! becomes: every context of a must call, a must function
// with a declared error, and main!.
package main

import (
	"errors"
	"fmt"
	"os"
	"strconv"
)

import gp_must "gocpp/must"

// plain is not touched: it is printed as written, even the spacing.
func plain(a,b   int) int {
	x  :=  a+b   // two spaces stay
	s := `raw
string`
	_ = s
	return x
}

// load is a must function: the dropped errors are returned.
func load(path string) (n int, err error) {
	defer errors.Wrapf(&err, "load %s", path)
	f, must_e1 := os.Open(path)
	if must_e1 != nil {
		return 0, must_e1
	}
	{
		must_t1 := f.Close
		defer func() {
			if must_e2 := must_t1(); must_e2 != nil && err == nil {
				err = must_e2
			}
		}()
	}

	// the first line
	{
		must_t2, must_e3 := strconv.Atoi(path)
		if must_e3 != nil {
			return 0, must_e3
		}
		n = must_t2
	}
	return n, nil
}

// half is a must function without a declared error.
func half(s string) (int, error) {
	n, must_e4 := strconv.Atoi(s)
	if must_e4 != nil {
		return 0, must_e4
	}
	if n < 0 {
		return 0, fmt.Errorf("%d is negative", n)
	}
	return n / 2, nil
}

func contexts(s string) (int, error) {
	// an assignment
	a, must_e5 := strconv.Atoi(s)
	if must_e5 != nil {
		return 0, must_e5
	}

	// a condition, a loop and a short-circuit
	{
		v, must_e6 := strconv.Atoi(s)
		if must_e6 != nil {
			return 0, must_e6
		}
		if v > a {
			a = v
		}
	}
	for i := 0; ; i++ {

		must_t3, must_e7 := strconv.Atoi(s)
		if must_e7 != nil {
			return 0, must_e7
		}
		if !(i < must_t3) {
			break
		}
		a++
	}
	must_t4 := a > 0
	if must_t4 {
		must_t5, must_e8 := strconv.Atoi(s)
		if must_e8 != nil {
			return 0, must_e8
		}
		must_t4 = strconv.Itoa(must_t5) != ""
	}
	ok := must_t4
	_ = ok
	{
		must_t6, must_e9 := strconv.Atoi(s)
		if must_e9 != nil {
			return 0, must_e9
		}
		switch must_t6 {
		case 1:
			a++
		}
	}
	{
		must_t7, must_e10 := strconv.Atoi(s)
		if must_e10 != nil {
			return 0, must_e10
		}
		defer fmt.Println(must_t7)
	}
	return a, nil
}

func nopanic(s string) int {
	{
		must_t8, must_e11 := strconv.Atoi(s)
		if must_e11 != nil {
			panic(must_e11)
		}
		return must_t8
	} // panics on an error
}

func must_main() (must_r error) {
	defer func() {
		if _, must_e12 := fmt.Println("done"); must_e12 != nil && must_r == nil {
			must_r = must_e12
		}
	}()
	n, must_e13 := half("8")
	if must_e13 != nil {
		return must_e13
	}
	{
		_, must_e14 := fmt.Println(n, plain(1, 2))
		if must_e14 != nil {
			return must_e14
		}
	}
	return nil
}

func main() { gp_must.Exit(must_main()) }
