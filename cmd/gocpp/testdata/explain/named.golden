named: Named types

A named type that is not a struct (type Celsius float64, type IDs []int) is a C++ struct of
its own over gp::newtype<T, U>, so it is a distinct C++ type that can have methods and its
Go name for fmt and %T. Over a number or a bool, gp::newtype holds the value (gp_value())
and has every operator of the underlying type; over a string, a slice, an array, a map or a
pointer, the named type is its underlying runtime type, a public base class, so ids[i],
len(ids) and range work unchanged.

Go converts implicitly between a named type and a type with the same underlying type when
one of them is unnamed (a []int to an IDs). go/types records no conversion there, so the
emitter finds those places and writes IDs(...). A switch over a named integer switches on
gp_value(), because C++ rejects a class in a switch.

Specification: docs/spec/cpp-mapping.md#named-types
See also: gocpp explain methods, gocpp explain types
Also known as: named-types, named types, newtype

Example (named.gp):

    package main

    import "fmt"

    type Celsius float64

    type IDs []int

    func (c Celsius) F() float64 { return float64(c)*9/5 + 32 }

    func main() {
    	c := Celsius(36.6)
    	var ids IDs = []int{1, 2}
    	ids = append(ids, 3)
    	fmt.Println(c.F(), c*2, len(ids))
    }

The C++ that gocpp emit -annotate writes for it:

    //// gpkg/command-line-arguments/pkg.hpp
    // gpkg/command-line-arguments/pkg.hpp: generated by gocpp, do not edit
    #pragma once
    #include <gocpp/rt.hpp>

    namespace gpkg_main {
    struct Celsius;
    struct IDs;

    struct Celsius : gp::newtype<Celsius, double> {
        using gp::newtype<Celsius, double>::newtype;
        double F() const;
    };
    static_assert(sizeof(Celsius) == 8 && alignof(Celsius) == 8);

    struct IDs : gp::newtype<IDs, gp::slice<int64_t>> {
        using gp::newtype<IDs, gp::slice<int64_t>>::newtype;
    };
    static_assert(sizeof(IDs) == 40 && alignof(IDs) == 8);

    extern const gp::type_desc gp_td_Celsius;
    void main();

    } // namespace gpkg_main
    //// gpkg/command-line-arguments/named.gp.cpp
    // gpkg/command-line-arguments/named.gp.cpp: generated by gocpp, do not edit
    #include "gpkg/command-line-arguments/pkg.hpp"

    namespace gpkg_main {

    // ---- ./named.gp:9: func (c Celsius) F() float64 { return float64(c)*9/5 + 32 }
    double Celsius::F() const {
        const Celsius& c = *this;
        return c.gp_value() * 9.0 / 5.0 + 32.0;
    }

    // ---- ./named.gp:11: func main() {
    void main() {

    // ---- ./named.gp:12: c := Celsius(36.6)
        Celsius c = Celsius(36.6);

    // ---- ./named.gp:13: var ids IDs = []int{1, 2}
        IDs ids = IDs(gp::slice_of<int64_t>({1, 2}));

    // ---- ./named.gp:14: ids = append(ids, 3)
    // gp[allocation] col 8: append: writes in place when the capacity is enough, else allocates a
    //     bigger array (the capacity is Go's: its growth formula, element sizes and malloc size
    //     classes); the result may share the array with the argument
        ids = IDs(gp::append(static_cast<IDs&&>(ids), 3));

    // ---- ./named.gp:15: fmt.Println(c.F(), c*2, len(ids))
    // gp[interfaces] col 2: fmt.Println: the runtime's gp::fmt functions take each operand with the
    //     descriptor of its Go type (gp::fmt::as), not boxed into an interface first (an operand of a
    //     non-pointer type with an Error method is, see the allocation note)
    // gp[methods] col 14: value method F: a plain member call; the body works on a copy of the
    //     receiver, or on a const reference when it cannot change it
        gp::fmt::Println(c.F(), gp::fmt::as(&gp_td_Celsius, c * Celsius(2.0)), gp::len(ids));

    // ---- ./named.gp:16: }
    }

    } // namespace gpkg_main
    //// gpkg/command-line-arguments/pkg_desc.cpp
    // gpkg/command-line-arguments/pkg_desc.cpp: generated by gocpp, do not edit
    #include "gpkg/command-line-arguments/pkg.hpp"

    namespace gpkg_main {

    inline double gp_thunk_Celsius_F(const gp::iface& gp_self) {
        return gp::unbox<Celsius>(gp_self).F();
    }
    inline const gp::method gp_vm_Celsius[]{gp::method_of<double()>("F", nullptr, "func() float64", &gp_thunk_Celsius_F)};
    inline double gp_thunk_pCelsius_F(const gp::iface& gp_self) {
        gp::ptr<Celsius> gp_p = gp::unbox<gp::ptr<Celsius>>(gp_self);
        gp::check_wrap(gp_p, "value method main.Celsius.F called using nil *Celsius pointer");
        return gp_p->F();
    }
    inline const gp::method gp_pm_Celsius[]{gp::method_of<double()>("F", nullptr, "func() float64", &gp_thunk_pCelsius_F)};
    const gp::type_desc gp_td_Celsius = gp::named<Celsius>("main.Celsius", "main", gp::shape_basic(gp::kind::Float64), gp::methods_of(gp_vm_Celsius), gp::methods_of(gp_pm_Celsius));

    } // namespace gpkg_main
