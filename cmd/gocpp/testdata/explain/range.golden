range: range loops

A range loop is a C++ for over an iterator that holds the range expression, evaluated once.
A string is gp::range_string (decoding UTF-8; an invalid byte gives U+FFFD); a slice is
gp::range_slice, which holds a copy of the slice header, so the loop covers the original
length even when the body appends; a map is gp::range_map, which starts at a random slot of
the map's table and holds the table, so a key deleted before it is reached is skipped, a new
key may or may not be produced (as in Go), and no entry is produced twice, also when the map
grows during the loop; a channel receives until it is closed; an integer is a counting loop.
An array is ranged in place, with a copy only where the body could change it.

A range over a function (for x := range seq) is Go's own rewrite: seq is called with the
loop body as its yield function, a closure, and a boxed gp::rangefunc_state records break,
continue and return and checks that the iterator does not misuse yield.

Each iteration has its own copy of the loop variables (Go 1.22): assigning to them in the
body does not change the iteration, and a closure or a pointer that keeps one keeps the
variable of its iteration (a boxed variable gets a new box each time).

Specification: docs/spec/cpp-mapping.md#slices
See also: gocpp explain slices, gocpp explain maps, gocpp explain channels
Also known as: loops, for

Example (range.gp):

    package main

    import "fmt"

    func count(n int) func(yield func(int) bool) {
    	return func(yield func(int) bool) {
    		for i := 0; i < n; i++ {
    			if !yield(i) {
    				return
    			}
    		}
    	}
    }

    func main() {
    	for x := range count(3) {
    		fmt.Println(x)
    	}
    	s := "héllo"
    	xs := []int{1, 2, 3}
    	m := map[string]int{"a": 1}
    	for i, r := range s {
    		fmt.Println(i, r)
    	}
    	for _, v := range xs {
    		xs = append(xs, v)
    	}
    	for k, v := range m {
    		fmt.Println(k, v)
    	}
    	for i := range 2 {
    		fmt.Println(i)
    	}
    }

The C++ that gocpp emit -annotate writes for it:

    //// gpkg/command-line-arguments/pkg.hpp
    // gpkg/command-line-arguments/pkg.hpp: generated by gocpp, do not edit
    #pragma once
    #include <gocpp/rt.hpp>

    namespace gpkg_main {
    gp::func<void(gp::func<bool(int64_t)>)> count(int64_t n);
    void main();

    } // namespace gpkg_main
    //// gpkg/command-line-arguments/range.gp.cpp
    // gpkg/command-line-arguments/range.gp.cpp: generated by gocpp, do not edit
    #include "gpkg/command-line-arguments/pkg.hpp"

    namespace gpkg_main {

    // ---- ./range.gp:5: func count(n int) func(yield func(int) bool) {
    gp::func<void(gp::func<bool(int64_t)>)> count(int64_t n) {

    // ---- ./range.gp:6: return func(yield func(int) bool) {
    // gp[closures] col 9: func literal #1 is a C++ lambda (the stack trace names it func1); what it
    //     captures is copied into the lambda (a box is shared), and a lambda that is used as a func
    //     value is wrapped in gp::func, whose copies share the captured state
        return gp::func<void(gp::func<bool(int64_t)>)>([n]<int = 1>(gp::func<bool(int64_t)> yield) mutable -> void {

    // ---- ./range.gp:7: for i := 0; i < n; i++ {
    // gp[closures] col 19: captures n by copy into the lambda: it never changes after the closure
    //     exists and is at most 128 bytes
            for (int64_t i = 0; i < n; i++) {

    // ---- ./range.gp:8: if !yield(i) {
    // gp[checks] col 8: call of a func value: gp::func's call operator checks for nil and panics like
    //     Go (gocpp build -nochecks removes it)
                if (!yield(i)) {

    // ---- ./range.gp:9: return
                    return;

    // ---- ./range.gp:10: }
                }

    // ---- ./range.gp:11: }
            }

    // ---- ./range.gp:12: }
        }

    // ---- ./range.gp:6: return func(yield func(int) bool) {  (continued)
        );

    // ---- ./range.gp:13: }
    }

    // ---- ./range.gp:15: func main() {
    void main() {

    // ---- ./range.gp:16: for x := range count(3) {
    // gp[range] col 2: range over a func: the iterator is called with the loop body as its yield
    //     function, a closure (Go's own rewrite); gp::rangefunc_state keeps Go's checks that the
    //     iterator does not call yield after the loop ended; break, continue and return are returns
    //     from the closure with the jump recorded in the state
        {
            auto gp_rs0 = gp::new_<gp::rangefunc_state>(); count(3)(gp::func<bool(int64_t)>([gp_rs0]<int = 0>(int64_t x) mutable -> bool {
                gp_rs0->gp_enter();

    // ---- ./range.gp:17: fmt.Println(x)
    // gp[interfaces] col 3: fmt.Println: the runtime's gp::fmt functions take each operand with the
    //     descriptor of its Go type (gp::fmt::as), not boxed into an interface first (an operand of a
    //     non-pointer type with an Error method is, see the allocation note)
                gp::fmt::Println(x);

    // ---- ./range.gp:18: }
                return gp_rs0->gp_continue();
            }

    // ---- ./range.gp:16: for x := range count(3) {  (continued)
            ));

    // ---- ./range.gp:18: }  (continued)
            gp_rs0->gp_finish();
        }

    // ---- ./range.gp:19: s := "héllo"
        gp::string s = "h\303\251llo"_gs;

    // ---- ./range.gp:20: xs := []int{1, 2, 3}
        gp::slice<int64_t> xs = gp::slice_of<int64_t>({1, 2, 3});

    // ---- ./range.gp:21: m := map[string]int{"a": 1}
    // gp[maps] col 21: map literal: gp::map_of builds the map from the entries in gc's order (the
    //     constant keys first)
        gp::map<gp::string, int64_t> m = gp::map_of<gp::string, int64_t>({{"a"_gs, 1}});

    // ---- ./range.gp:22: for i, r := range s {
    // gp[range] col 2: range over a string: gp::range_string decodes UTF-8 rune by rune; an invalid
    //     byte gives U+FFFD and steps one byte
        for (auto gp_it0 = gp::range_string(s); gp::range_next(gp_it0);) {
            int64_t i = gp_it0.gp_i; int32_t r = gp_it0.gp_r;

    // ---- ./range.gp:23: fmt.Println(i, r)
            gp::fmt::Println(i, r);

    // ---- ./range.gp:24: }
        }

    // ---- ./range.gp:25: for _, v := range xs {
    // gp[range] col 2: range over a slice: the iterator holds a copy of the slice header, so the loop
    //     covers the original length even if the body appends
        for (auto gp_it1 = gp::range_slice(xs); gp::range_next(gp_it1);) {
            int64_t v = gp_it1.gp_v();

    // ---- ./range.gp:26: xs = append(xs, v)
    // gp[allocation] col 8: append: writes in place when the capacity is enough, else allocates a
    //     bigger array (the capacity is Go's: its growth formula, element sizes and malloc size
    //     classes); the result may share the array with the argument
            xs = gp::append(static_cast<gp::slice<int64_t>&&>(xs), v);

    // ---- ./range.gp:27: }
        }

    // ---- ./range.gp:28: for k, v := range m {
    // gp[range] col 2: range over a map: the iterator holds the table and starts at a random slot, so a
    //     key deleted before it is reached is skipped; the order is random, as in Go
        for (auto gp_it2 = gp::range_map(m); gp::range_next(gp_it2);) {
            gp::string k = gp_it2.gp_key(); int64_t v = gp_it2.gp_value();

    // ---- ./range.gp:29: fmt.Println(k, v)
            gp::fmt::Println(k, v);

    // ---- ./range.gp:30: }
        }

    // ---- ./range.gp:31: for i := range 2 {
    // gp[range] col 2: range over an integer: a counting loop; each iteration has its own copy of the
    //     variable (Go 1.22)
        for (int64_t gp_i0 = 0; gp_i0 < 2; gp_i0++) {
            int64_t i = gp_i0;

    // ---- ./range.gp:32: fmt.Println(i)
            gp::fmt::Println(i);

    // ---- ./range.gp:33: }
        }

    // ---- ./range.gp:34: }
    }

    } // namespace gpkg_main
