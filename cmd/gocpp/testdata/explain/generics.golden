    //// gpkg/command-line-arguments/pkg_desc.cpp
    // gpkg/command-line-arguments/pkg_desc.cpp: generated by gocpp, do not edit
    #include "gpkg/command-line-arguments/pkg.hpp"

    namespace gpkg_main {

    static const gp::type_desc* gp_full_Big();
    const gp::type_desc gp_td_Big = gp::named<Big>("main.Big", "main", gp::shape_lazy(gp::shape_array(64, &gp::td_int), &gp_full_Big));

    const gp::type_desc* const gp_tdc_0 = gp::td_slice<gp::string>(&gp::td_string);
    const gp::type_desc* const gp_tdc_1 = gp::td_slice<int64_t>(&gp::td_int);

    static const gp::type_desc* gp_full_Big() {
        static const gp::type_desc gp_d = gp::completed(gp_td_Big, gp::shape_array(64, &gp::td_int));
        return &gp_d;
    }

    } // namespace gpkg_main
