arrays: Arrays

A [N]T is a gp::array<T, N>: the N elements are in the object itself, so assigning, passing
and returning an array copies it, as in Go. An index is checked against N and panics with
Go's message; a constant index is checked by the C++ compiler. a == b compares element by
element when the elements are comparable.

A slice expression a[lo:hi] shares the array (gp::sub(&a, lo, hi)), so a local array that is
sliced is boxed (gocpp explain boxing). Go ranges over a copy of an array: gocpp makes the
copy (gp::range_array_copy) only where the loop body could change the array, and ranges over
the array itself otherwise.

Arrays larger than 128 KiB are kept off the C++ stack: the variable is boxed and its literal
is built in the box.

Specification: docs/spec/cpp-mapping.md#arrays
See also: gocpp explain slices, gocpp explain boxing, gocpp explain range
Also known as: array

Example (arrays.gp):

    package main

    import "fmt"

    func sum(a [3]int) int {
    	t := 0
    	for _, v := range a {
    		t += v
    	}
    	return t
    }

    func main() {
    	a := [3]int{1, 2, 3}
    	b := a
    	b[0] = 10
    	fmt.Println(sum(a), sum(b), a == b, a[1:])
    }

The C++ that gocpp emit -annotate writes for it:

    //// gpkg/command-line-arguments/pkg.hpp
    // gpkg/command-line-arguments/pkg.hpp: generated by gocpp, do not edit
    #pragma once
    #include <gocpp/rt.hpp>

    namespace gpkg_main {
    extern const gp::type_desc* gp_tdc_0_p;
    [[gnu::cold, gnu::noinline]] const gp::type_desc* gp_tdc_0_make();
    int64_t sum(gp::array<int64_t, 3> a);
    void main();

    } // namespace gpkg_main
    //// gpkg/command-line-arguments/arrays.gp.cpp
    // gpkg/command-line-arguments/arrays.gp.cpp: generated by gocpp, do not edit
    #include "gpkg/command-line-arguments/pkg.hpp"

    namespace gpkg_main {

    // ---- ./arrays.gp:5: func sum(a [3]int) int {
    int64_t sum(gp::array<int64_t, 3> a) {

    // ---- ./arrays.gp:6: t := 0
        int64_t t = 0;

    // ---- ./arrays.gp:7: for _, v := range a {
    // gp[range] col 2: range over an array: the array is copied only where the body could change it
        for (auto gp_it0 = gp::range_array(a); gp::range_next(gp_it0);) {
            int64_t v = gp_it0.gp_v();

    // ---- ./arrays.gp:8: t += v
            t = t + v;

    // ---- ./arrays.gp:9: }
        }

    // ---- ./arrays.gp:10: return t
        return t;

    // ---- ./arrays.gp:11: }
    }

    // ---- ./arrays.gp:13: func main() {
    void main() {

    // ---- ./arrays.gp:14: a := [3]int{1, 2, 3}
    // gp[boxing] col 2: a is boxed: an array in it is sliced, and the slice keeps the array alive
        gp::ptr<gp::array<int64_t, 3>> a = gp::new_<gp::array<int64_t, 3>>(gp::array<int64_t, 3>{1, 2, 3});

    // ---- ./arrays.gp:15: b := a
        gp::array<int64_t, 3> b = (*a);

    // ---- ./arrays.gp:16: b[0] = 10
    // gp[checks] col 3: a[i] of an array: gp::array::operator[] checks the index (gocpp build -nochecks
    //     removes it); a constant index is checked by the compiler
        b[0] = 10;

    // ---- ./arrays.gp:17: fmt.Println(sum(a), sum(b), a == b, a[1:])
    // gp[interfaces] col 2: fmt.Println: the runtime's gp::fmt functions take each operand with the
    //     descriptor of its Go type (gp::fmt::as), not boxed into an interface first (an operand of a
    //     non-pointer type with an Error method is, see the allocation note)
    // gp[order] col 14: gp_t0 holds the result of a call (or a value that a later call could change):
    //     Go evaluates it first, in order, where C++ leaves the order of the operands unspecified
    // gp[order] col 22: gp_t1 holds the result of a call (or a value that a later call could change):
    //     Go evaluates it first, in order, where C++ leaves the order of the operands unspecified
        { auto gp_t0 = gpkg_main::sum((*a)); auto gp_t1 = gpkg_main::sum(b); gp::fmt::Println(gp_t0, gp_t1, (*a) == b, gp::fmt::as(gp::desc_get<&gp_tdc_0_p, &gp_tdc_0_make>(), gp::sub(a, 1))); }

    // ---- ./arrays.gp:18: }
    }

    } // namespace gpkg_main
    //// gpkg/command-line-arguments/pkg_desc.cpp
    // gpkg/command-line-arguments/pkg_desc.cpp: generated by gocpp, do not edit
    #include "gpkg/command-line-arguments/pkg.hpp"

    namespace gpkg_main {

    constinit const gp::type_desc* gp_tdc_0_p = nullptr;
    [[gnu::cold, gnu::noinline]] const gp::type_desc* gp_tdc_0_make() {
        return gp::desc_publish(&gp_tdc_0_p, gp::td_slice<int64_t>(&gp::td_int));
    }

    } // namespace gpkg_main
