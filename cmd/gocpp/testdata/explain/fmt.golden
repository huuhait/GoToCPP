fmt: fmt and the builtins

fmt.Println, Printf, Sprintf, Errorf and the others are the runtime's gp::fmt functions: a
port of Go's fmt that walks values by their type descriptors, as Go's walks them by
reflection, so every verb, flag, width and error form (%!d(string=hi)) prints as in Go. An
operand whose C++ type says its Go type (int as int64_t, string, float64...) is passed as it
is; an interface value is passed as it is; every other operand is gp::fmt::as(descriptor,
value), which is how int64 (the same C++ type as int), named types, structs, slices and maps
are told apart.

The arguments are values at the call, and the order of evaluation is gc's: a variable is
read after the calls of its statement. min and max of non-constant values are gp::min and
gp::max with Go's rules for NaN and -0; print and println write to stderr in the runtime's
format.

Specification: docs/spec/cpp-mapping.md#fmt-and-the-builtins
See also: gocpp explain interfaces, gocpp explain order, gocpp explain types
Also known as: builtins, print, println, fmt-and-the-builtins

Example (fmt.gp):

    package main

    import "fmt"

    type Point struct{ X, Y int }

    func main() {
    	var big int64 = 5
    	p := Point{1, 2}
    	fmt.Println(p, []int{1}, big, min(3, big))
    	fmt.Printf("%5d|%v\n", big, p)
    }

The C++ that gocpp emit -annotate writes for it:

    //// gpkg/command-line-arguments/pkg.hpp
    // gpkg/command-line-arguments/pkg.hpp: generated by gocpp, do not edit
    #pragma once
    #include <gocpp/rt.hpp>

    namespace gpkg_main {
    struct Point;

    struct Point {
        int64_t X = 0;
        int64_t Y = 0;
        bool operator==(const Point&) const = default;
        std::size_t gp_hash() const {
            return gp::hash_fields(X, Y);
        }
        static constexpr auto gp_fields = gp::fields(gp::field(&Point::X, "X", true, false), gp::field(&Point::Y, "Y", true, false));
    };
    static_assert(sizeof(Point) == 16 && alignof(Point) == 8);

    extern const gp::type_desc gp_td_Point;
    extern const gp::type_desc* const gp_tdc_0;
    void main();

    } // namespace gpkg_main
    //// gpkg/command-line-arguments/fmt.gp.cpp
    // gpkg/command-line-arguments/fmt.gp.cpp: generated by gocpp, do not edit
    #include "gpkg/command-line-arguments/pkg.hpp"

    namespace gpkg_main {

    // ---- ./fmt.gp:7: func main() {
    void main() {

    // ---- ./fmt.gp:8: var big int64 = 5
        int64_t big = 5;

    // ---- ./fmt.gp:9: p := Point{1, 2}
        Point p{1, 2};

    // ---- ./fmt.gp:10: fmt.Println(p, []int{1}, big, min(3, big))
    // gp[interfaces] col 2: fmt.Println: the runtime's gp::fmt functions take each operand with the
    //     descriptor of its Go type (gp::fmt::as), not boxed into an interface first (an operand of a
    //     non-pointer type with an Error method is, see the allocation note)
        gp::fmt::Println(gp::fmt::as(&gp_td_Point, p), gp::fmt::as(gp_tdc_0, gp::slice_of<int64_t>({1})), gp::fmt::as(&gp::td_int64, big), gp::fmt::as(&gp::td_int64, gp::min<int64_t>(3, big)));

    // ---- ./fmt.gp:11: fmt.Printf("%5d|%v\n", big, p)
    // gp[interfaces] col 2: fmt.Printf: the runtime's gp::fmt functions take each operand with the
    //     descriptor of its Go type (gp::fmt::as), not boxed into an interface first (an operand of a
    //     non-pointer type with an Error method is, see the allocation note)
        gp::fmt::Printf("%5d|%v\n"_gs, gp::fmt::as(&gp::td_int64, big), gp::fmt::as(&gp_td_Point, p));

    // ---- ./fmt.gp:12: }
    }

    } // namespace gpkg_main
    //// gpkg/command-line-arguments/pkg_desc.cpp
    // gpkg/command-line-arguments/pkg_desc.cpp: generated by gocpp, do not edit
    #include "gpkg/command-line-arguments/pkg.hpp"

    namespace gpkg_main {

    static const gp::type_desc* gp_full_Point();
    const gp::type_desc gp_td_Point = gp::named<Point>("main.Point", "main", gp::shape_lazy(gp::shape_struct(nullptr, 0), &gp_full_Point));

    const gp::type_desc* const gp_tdc_0 = gp::td_slice<int64_t>(&gp::td_int);

    static const gp::type_desc* gp_full_Point() {
        static const gp::field_desc gp_f[]{gp::field_desc("X", nullptr, &gp::td_int, nullptr, false, gp::offset_of(&Point::X)), gp::field_desc("Y", nullptr, &gp::td_int, nullptr, false, gp::offset_of(&Point::Y))};
        static const gp::type_desc gp_d = gp::completed(gp_td_Point, gp::shape_struct(gp_f, 2));
        return &gp_d;
    }

    } // namespace gpkg_main
