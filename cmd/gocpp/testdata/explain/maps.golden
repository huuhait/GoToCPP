maps: Maps

A map is a gp::map<K, V>, a shared reference to the table (v1 wraps std::unordered_map).
m[k] is gp::get, which gives the zero value for a missing key and never inserts; v, ok :=
m[k] is gp::lookup. m[k] = v is gp::set(m, k, v), which stores the value and inserts the key
if it is new. m[k]++ and m[k] += v change the entry in place with gp::ref, which inserts the
zero value first when the key is missing. A write to a nil map panics, a read does not. A
map literal is gp::map_of in gc's order (the constant keys first). delete is gp::erase.
Iteration order is unspecified, as in Go.

Specification: docs/spec/cpp-mapping.md#maps
See also: gocpp explain range, gocpp explain allocation
Also known as: map

Example (maps.gp):

    package main

    import "fmt"

    func main() {
    	m := map[string]int{"a": 1, "b": 2}
    	m["c"] = 3
    	m["c"]++
    	v, ok := m["z"]
    	delete(m, "a")
    	fmt.Println(len(m), v, ok, m["b"])
    }

The C++ that gocpp emit -annotate writes for it:

    //// gpkg/command-line-arguments/pkg.hpp
    // gpkg/command-line-arguments/pkg.hpp: generated by gocpp, do not edit
    #pragma once
    #include <gocpp/rt.hpp>

    namespace gpkg_main {
    void main();

    } // namespace gpkg_main
    //// gpkg/command-line-arguments/maps.gp.cpp
    // gpkg/command-line-arguments/maps.gp.cpp: generated by gocpp, do not edit
    #include "gpkg/command-line-arguments/pkg.hpp"

    namespace gpkg_main {

    // ---- ./maps.gp:5: func main() {
    void main() {

    // ---- ./maps.gp:6: m := map[string]int{"a": 1, "b": 2}
    // gp[maps] col 21: map literal: gp::map_of builds the map from the entries in gc's order (the
    //     constant keys first)
        gp::map<gp::string, int64_t> m = gp::map_of<gp::string, int64_t>({{"a"_gs, 1}, {"b"_gs, 2}});

    // ---- ./maps.gp:7: m["c"] = 3
    // gp[maps] col 3: m[k] = v: gp::set(m, k, v) stores the value, inserting the key if it is new (the
    //     key and the value are evaluated first, in Go's order); a write to a nil map panics, also
    //     under -nochecks
        gp::set(m, "c"_gs, 3);

    // ---- ./maps.gp:8: m["c"]++
    // gp[maps] col 3: m[k]++, m[k] op= v and m[k] = append(m[k], ...) change the entry in place:
    //     gp::ref(m, k) gives a reference to it, inserting the zero value first when the key is
    //     missing; a write to a nil map panics, also under -nochecks
        gp::ref(m, "c"_gs)++;

    // ---- ./maps.gp:9: v, ok := m["z"]
    // gp[maps] col 12: v, ok := m[k]: gp::lookup gives the value and whether the key was there
        auto gp_t0 = gp::lookup(m, "z"_gs);
        int64_t v = std::get<0>(gp_t0);
        bool ok = std::get<1>(gp_t0);

    // ---- ./maps.gp:10: delete(m, "a")
    // gp[maps] col 2: delete(m, k): removes the key; nothing happens for a missing key or a nil map
        gp::erase(m, "a"_gs);

    // ---- ./maps.gp:11: fmt.Println(len(m), v, ok, m["b"])
    // gp[interfaces] col 2: fmt.Println: the runtime's gp::fmt functions take each operand with the
    //     descriptor of its Go type (gp::fmt::as), not boxed into an interface first (an operand of a
    //     non-pointer type with an Error method is, see the allocation note)
    // gp[maps] col 30: m[k]: gp::get gives the zero value for a missing key and never inserts; a nil
    //     map reads as empty
        gp::fmt::Println(gp::len(m), v, ok, gp::get(m, "b"_gs));

    // ---- ./maps.gp:12: }
    }

    } // namespace gpkg_main
