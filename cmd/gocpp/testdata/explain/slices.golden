slices: Slices

A slice is a gp::slice<T>: an owner, a data pointer, a length and a capacity (40 bytes).
Slicing shares the array and keeps it alive through the owner. make allocates a zeroed
array. append writes in place when the capacity is enough and otherwise allocates a bigger
array; gocpp only promises cap >= len, not Go's exact growth. In s = append(s, x) of a local
s, s is moved into append (no extra count). copy handles overlap and does not allocate. An
index is checked against the length, a slice expression against the capacity.

Specification: docs/spec/cpp-mapping.md#slices
See also: gocpp explain strings, gocpp explain allocation, gocpp explain range
Also known as: slice, append

Example (slices.gp):

    package main

    import "fmt"

    func main() {
    	xs := []int{1, 2, 3, 4}
    	ys := xs[1:3] // shares the array
    	zs := make([]int, 2)
    	n := copy(zs, ys)
    	ys = append(ys, 9)
    	clear(zs)
    	fmt.Println(xs, ys, zs, n)
    }

The C++ that gocpp emit -annotate writes for it:

    //// gpkg/command-line-arguments/pkg.hpp
    // gpkg/command-line-arguments/pkg.hpp: generated by gocpp, do not edit
    #pragma once
    #include <gocpp/rt.hpp>

    namespace gpkg_main {
    extern const gp::type_desc* const gp_tdc_0;
    void main();

    } // namespace gpkg_main
    //// gpkg/command-line-arguments/slices.gp.cpp
    // gpkg/command-line-arguments/slices.gp.cpp: generated by gocpp, do not edit
    #include "gpkg/command-line-arguments/pkg.hpp"

    namespace gpkg_main {

    // ---- ./slices.gp:5: func main() {
    void main() {

    // ---- ./slices.gp:6: xs := []int{1, 2, 3, 4}
        gp::slice<int64_t> xs = gp::slice_of<int64_t>({1, 2, 3, 4});

    // ---- ./slices.gp:7: ys := xs[1:3] // shares the array
    // gp[slices] col 10: s[a:b] of a slice: gp::sub checks the bounds against the capacity and shares
    //     the array (no copy); the result keeps the array alive
        gp::slice<int64_t> ys = gp::sub(xs, 1, 3);

    // ---- ./slices.gp:8: zs := make([]int, 2)
    // gp[allocation] col 8: make([]T, n): allocates the zeroed backing array; the slice holds its
    //     owner, and a negative or too large n panics
        gp::slice<int64_t> zs = gp::make_slice<int64_t>(2);

    // ---- ./slices.gp:9: n := copy(zs, ys)
    // gp[slices] col 7: copy: copies min(len(dst), len(src)) elements, handles overlap, no allocation
        int64_t n = gp::copy(zs, ys);

    // ---- ./slices.gp:10: ys = append(ys, 9)
    // gp[allocation] col 7: append: writes in place when the capacity is enough, else allocates a
    //     bigger array (gocpp promises cap >= len, not Go's exact growth); the result may share the
    //     array with the argument
        ys = gp::append(static_cast<gp::slice<int64_t>&&>(ys), 9);

    // ---- ./slices.gp:11: clear(zs)
    // gp[slices] col 2: clear: sets the elements to their zero values
        gp::clear(zs);

    // ---- ./slices.gp:12: fmt.Println(xs, ys, zs, n)
    // gp[interfaces] col 2: fmt.Println: the runtime's gp::fmt functions take each operand with the
    //     descriptor of its Go type (gp::fmt::as), not boxed into an interface first (an operand of a
    //     non-pointer type with an Error method is, see the allocation note)
        gp::fmt::Println(gp::fmt::as(gp_tdc_0, xs), gp::fmt::as(gp_tdc_0, ys), gp::fmt::as(gp_tdc_0, zs), n);

    // ---- ./slices.gp:13: }
    }

    } // namespace gpkg_main
    //// gpkg/command-line-arguments/pkg_desc.cpp
    // gpkg/command-line-arguments/pkg_desc.cpp: generated by gocpp, do not edit
    #include "gpkg/command-line-arguments/pkg.hpp"

    namespace gpkg_main {

    const gp::type_desc* const gp_tdc_0 = gp::td_slice<int64_t>(&gp::td_int);

    } // namespace gpkg_main
