    for (int64_t gp_i0 = 0; gp_i0 < 3; gp_i0++) {

// ---- ./goroutines.gp:14: sum += <-done
// gp[channels] col 10: receive: blocks until a value arrives; after close it gives the zero value
        sum = sum + gp::recv(done);

// ---- ./goroutines.gp:15: }
    }

// ---- ./goroutines.gp:16: fmt.Println(sum)
// gp[interfaces] col 2: fmt.Println: the runtime's gp::fmt functions take each operand with the
