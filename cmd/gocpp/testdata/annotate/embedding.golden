#pragma once
#include <gocpp/rt.hpp>

namespace gpkg_main {
struct Animal;
struct Dog;

struct Animal {
    gp::string name;
    bool operator==(const Animal&) const = default;
    std::size_t gp_hash() const {
        return gp::hash_fields(name);
    }
    static constexpr auto gp_fields = gp::fields(gp::field(&Animal::name, "name", false, false));
    gp::string Name() const;
};
static_assert(sizeof(Animal) == 32 && alignof(Animal) == 8);

struct Dog {
    gpkg_main::Animal Animal;
    int64_t tricks = 0;
    bool operator==(const Dog&) const = default;
    std::size_t gp_hash() const {
        return gp::hash_fields(Animal, tricks);
    }
    static constexpr auto gp_fields = gp::fields(gp::field(&Dog::Animal, "Animal", true, true), gp::field(&Dog::tricks, "tricks", false, false));
};
static_assert(sizeof(Dog) == 40 && alignof(Dog) == 8);

void main();

} // namespace gpkg_main
