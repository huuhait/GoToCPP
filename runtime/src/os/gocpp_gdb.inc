        ".ascii \"class GPCatch(gdb.Command):\\012\"\n"
        ".ascii \"    \\042\\042\\042Stop where a Go panic starts: gp catch panic.\\012\"\n"
        ".ascii \"\\012\"\n"
        ".ascii \"A panic is a C++ exception, and catch throw stops at its throw. The panic statement of a function\\012\"\n"
        ".ascii \"that has deferred calls does not throw (the function handles it in its own frame: ADR-085), so this\\012\"\n"
        ".ascii \"command also sets a breakpoint on the runtime function that takes it. At either stop the Go\\012\"\n"
        ".ascii \"function that panicked is the selected frame. A panic that nothing recovers is thrown again when\\012\"\n"
        ".ascii \"the function's deferred calls have run: that second throw is not reported (a plain catch throw\\012\"\n"
        ".ascii \"stops at it). runtime.Goexit is a throw, and stops once.\\042\\042\\042\\012\"\n"
        ".ascii \"    def __init__(self):\\012\"\n"
        ".ascii \"        super().__init__(\\042gp catch\\042, gdb.COMMAND_BREAKPOINTS, gdb.COMPLETE_NONE, True)\\012\"\n"
        ".ascii \"def _panic_state():\\012\"\n"
        ".ascii \"    state = getattr(gdb, \\042_gocpp_panic\\042, None)\\012\"\n"
        ".ascii \"    if state is None:\\012\"\n"
        ".ascii \"        state = {\\042numbers\\042: [], \\042pending\\042: False}\\012\"\n"
        ".ascii \"        gdb._gocpp_panic = state\\012\"\n"
        ".ascii \"    return state\\012\"\n"
        ".ascii \"def _is_rethrow():\\012\"\n"
        ".ascii \"    \\042\\042\\042True at a throw whose caller is defer_frame::gp_run (the selected frame is the throw).\\042\\042\\042\\012\"\n"
        ".ascii \"    try:\\012\"\n"
        ".ascii \"        caller = gdb.selected_frame().older()\\012\"\n"
        ".ascii \"        name = caller.name() if caller is not None else None\\012\"\n"
        ".ascii \"        return isinstance(name, str) and name.startswith(\\042gp::defer_frame::gp_run\\042)\\012\"\n"
        ".ascii \"    except gdb.error:\\012\"\n"
        ".ascii \"        return False\\012\"\n"
        ".ascii \"def go_frame_above(frame):\\012\"\n"
        ".ascii \"    \\042\\042\\042The first frame of frame and its callers that is in a .gp file, or None.\\042\\042\\042\\012\"\n"
        ".ascii \"    for _ in range(64):\\012\"\n"
        ".ascii \"        if frame is None:\\012\"\n"
        ".ascii \"            return None\\012\"\n"
        ".ascii \"        if frame_source(frame)[0] is not None:\\012\"\n"
        ".ascii \"            return frame\\012\"\n"
        ".ascii \"        frame = frame.older()\\012\"\n"
        ".ascii \"    return None\\012\"\n"
        ".ascii \"def _select_go_frame(event):\\012\"\n"
        ".ascii \"    \\042\\042\\042After a stop that gp catch panic made, the user's frame is the selected one (the stop is in\\012\"\n"
        ".ascii \"    the runtime: __cxa_throw, gp_panic). A stop that only a breakpoint of the user's made keeps its\\012\"\n"
        ".ascii \"    own frame.\\042\\042\\042\\012\"\n"
        ".ascii \"    state = _panic_state()\\012\"\n"
        ".ascii \"    pending = state[\\042pending\\042]\\012\"\n"
        ".ascii \"    state[\\042pending\\042] = False\\012\"\n"
        ".ascii \"    if not pending or not isinstance(event, gdb.BreakpointEvent):\\012\"\n"
        ".ascii \"        return\\012\"\n"
        ".ascii \"    if not any(b.number in state[\\042numbers\\042] for b in event.breakpoints):\\012\"\n"
        ".ascii \"        return\\012\"\n"
        ".ascii \"    try:\\012\"\n"
        ".ascii \"        frame = go_frame_above(gdb.selected_frame())\\012\"\n"
        ".ascii \"        if frame is not None and frame != gdb.selected_frame():\\012\"\n"
        ".ascii \"            frame.select()\\012\"\n"
        ".ascii \"            gdb.execute(\\042frame\\042)\\012\"\n"
        ".ascii \"    except gdb.error:\\012\"\n"
        ".ascii \"        pass\\012\"\n"
        ".ascii \"class GPCatchPanic(gdb.Command):\\012\"\n"
        ".ascii \"    \\042\\042\\042Stop where a Go panic starts: gp catch panic (see help gp catch).\\042\\042\\042\\012\"\n"
        ".ascii \"    def __init__(self):\\012\"\n"
        ".ascii \"        super().__init__(\\042gp catch panic\\042, gdb.COMMAND_BREAKPOINTS)\\012\"\n"
        ".ascii \"    @_user_errors\\012\"\n"
        ".ascii \"    def invoke(self, arg, from_tty):\\012\"\n"
        ".ascii \"        if arg.strip():\\012\"\n"
