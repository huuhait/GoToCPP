        ".ascii \"            rows.append({\\042thread\\042: th.num, \\042current\\042: False, \\042name\\042: \\042\\042, \\042id\\042: None, \\042state\\042: \\042unreadable: %s\\042 % e, \\042reason\\042: \\042\\042, \\042top\\042: None})\\012\"\n"
        ".ascii \"    try:\\012\"\n"
