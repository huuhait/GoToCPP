        ".ascii \"        raise gdb.GdbError(\\042%s takes %d argument%s, not %d\\042 % (name, n, \\042\\042 if n == 1 else \\042s\\042, len(args)))\\012\"\n"
        ".ascii \"def go_deref(v, name=\\042$gp_deref\\042):\\012\"\n"
