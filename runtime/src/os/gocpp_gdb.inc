        ".ascii \"def go_index(v, i, name=\\042$gp_index\\042):\\012\"\n"
        ".ascii \"    \\042\\042\\042Element i of a gp::slice or gp::array, or byte i of a gp::string.\\042\\042\\042\\012\"\n"
