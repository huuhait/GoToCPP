        ".ascii \"            kind = find_decl_kind(src, sym.name, line) if src is not None else None\\012\"\n"
        ".ascii \"        return unbox(v, kind)\\012\"\n"
        ".ascii \"    except Exception:\\012\"\n"
        ".ascii \"        return v\\012\"\n"
        ".ascii \"def unbox(v, kind):\\012\"\n"
