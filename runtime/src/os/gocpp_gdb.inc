        ".ascii \"    return out\\012\"\n"
        ".ascii \"class GP(gdb.Command):\\012\"\n"
        ".ascii \"    \\042\\042\\042gocpp debugging commands: gp goroutines | bt | locals | print | whatis | break |\\012\"\n"
        ".ascii \"    catch panic | skip-runtime.\\042\\042\\042\\012\"\n"
        ".ascii \"    def __init__(self):\\012\"\n"
        ".ascii \"        super().__init__(\\042gp\\042, gdb.COMMAND_USER, gdb.COMPLETE_NONE, True)\\012\"\n"
        ".ascii \"class GPGoroutines(gdb.Command):\\012\"\n"
