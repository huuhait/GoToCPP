        ".ascii \"    for r in goroutines:\\012\"\n"
        ".ascii \"        state = r[\\042state\\042] if not r[\\042reason\\042] else \\042%s [%s]\\042 % (r[\\042state\\042], r[\\042reason\\042])\\012\"\n"
        ".ascii \"        lines.append(\\042%s %4d  %-28s thread %-3d %s\\042 % (\\042*\\042 if r[\\042current\\042] else \\042 \\042, r[\\042id\\042], state, r[\\042thread\\042], r[\\042top\\042] or \\042-\\042))\\012\"\n"
