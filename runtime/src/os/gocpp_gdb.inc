        ".ascii \"            for r in others:\\012\"\n"
        ".ascii \"                lines.append(\\042%s   -  %-28s thread %-3d %s\\042 % (\\042*\\042 if r[\\042current\\042] else \\042 \\042, r[\\042state\\042], r[\\042thread\\042], r[\\042name\\042]))\\012\"\n"
        ".ascii \"        else:\\012\"\n"
        ".ascii \"            lines.append(\\042  (%d other thread%s: idle goroutine threads or threads of C libraries; gp goroutines -a lists them)\\042 % (len(others), \\042\\042 if len(others) == 1 else \\042s\\042))\\012\"\n"
