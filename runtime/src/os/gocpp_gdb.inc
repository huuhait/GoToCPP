        ".ascii \"                made = True\\012\"\n"
        ".ascii \"        if not made:\\012\"\n"
        ".ascii \"            gdb.write(\\042The runtime has no gp_panic here: a panic statement in a function with \\042)\\012\"\n"
        ".ascii \"            gdb.write(\\042defers is not seen.\\134n\\042)\\012\"\n"
