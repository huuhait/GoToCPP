        ".ascii \"    except gdb.error:\\012\"\n"
        ".ascii \"        pass\\012\"\n"
        ".ascii \"    rows.sort(key=lambda r: (r[\\042id\\042] is None, r[\\042id\\042] or 0, r[\\042thread\\042]))\\012\"\n"
        ".ascii \"    return rows\\012\"\n"
        ".ascii \"def format_goroutines(rows, all_threads=False):\\012\"\n"
        ".ascii \"    lines = []\\012\"\n"
        ".ascii \"    goroutines = [r for r in rows if r[\\042id\\042] is not None]\\012\"\n"
