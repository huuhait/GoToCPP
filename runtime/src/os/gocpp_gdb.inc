        ".ascii \"GOROUTINE_TLS = \\042gp::os::(anonymous namespace)::tslot\\042\\012\"\n"
        ".ascii \"WINDOWS_TLS_INDEX = \\042gp::os::debug_tls_slot\\042\\012\"\n"
        ".ascii \"TEB_TLS_SLOTS = 0x1480\\012\"\n"
        ".ascii \"TEB_TLS_EXPANSION = 0x1780\\012\"\n"
        ".ascii \"def thread_slot_value():\\012\"\n"
        ".ascii \"    \\042\\042\\042The goroutine slot of the selected thread as an integer: the thread_local of the Linux layer,\\012\"\n"
        ".ascii \"    else the TLS slot of the Windows layer. Raises gdb.error when neither is there.\\042\\042\\042\\012\"\n"
