        ".ascii \"        except gdb.error:\\012\"\n"
        ".ascii \"            pass\\012\"\n"
        ".ascii \"        made = False\\012\"\n"
        ".ascii \"        for bp in gdb.breakpoints() or ():\\012\"\n"
        ".ascii \"            if bp.number not in before and bp.number not in numbers:\\012\"\n"
        ".ascii \"                numbers.append(bp.number)\\012\"\n"
